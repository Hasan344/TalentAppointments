@model IEnumerable<ForQab.DataAccess.Models.Commission>

<h2>Commissions</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Komissiya nömrəsi</th>
            <th>Name</th>
            <th>Section Id</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rowNumber = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@item.CommissionNo</td>
                <td>@item.Name</td>
                <td>@item.Section.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
            rowNumber++;
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Create New Commission</a>

<a class="btn btn-secondary px-4 py-2 mx-2" border: none;" asp-controller="Exam" asp-action="Index">
    <i class="bi bi-home"></i> İmtahanlara qayıt
</a>