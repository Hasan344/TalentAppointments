@model IEnumerable<ForQab.DataAccess.Models.Monitor>

@{
    ViewData["Title"] = "Digər işçilər";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<link rel="stylesheet" href="~/css/Monitors/Index.css" asp-append-version="true" />

<div class="container mt-5">
    <h1 class="text-center mb-4 fw-bold text-primary">Digər işçilər</h1>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-circle"></i> Yeni İşçi</a>
            <a class="btn btn-outline-primary" href="@Url.Action("ExportToExcel", "Worker", new { searchName = ViewContext.HttpContext.Request.Query["searchName"], finCode = ViewContext.HttpContext.Request.Query["finCode"], serial = ViewContext.HttpContext.Request.Query["serial"], genderId = ViewContext.HttpContext.Request.Query["genderId"], district = ViewContext.HttpContext.Request.Query["district"] })">
                <i class="bi bi-file-earmark-excel"></i> Excel'e çıxarış
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exportModal">
                <i class="bi bi-file-earmark-word"></i> Müqavilə Export
            </button>@*
            <a class="btn btn-outline-secondary" asp-action="Archived"><i class="bi bi-archive"></i> Arxiv</a>
            <a class="btn btn-outline-info" asp-action="MonitorLogs"><i class="bi bi-journal"></i> Xüsusi qeydlər</a> *@
        </div>
    </div>


    <!-- Export Modal -->
    <div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exportModalLabel">Müqavilə Export</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="ExportContracts">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="contractDate" class="form-label">Müqavilə Tarixi</label>
                            <input type="date" id="contractDate" name="contractDate" class="form-control" required />
                        </div>
                        @* <div class="mb-3">
                            <label for="workerType" class="form-label">İşçi tipi</label>
                            <select id="workerType" name="workerType" class="form-select" required onchange="filterByWorkerType()">
                                <option value="">-- Seçin --</option>
                                @foreach (var wt in ViewBag.WorkerTypes
                                    )
                                    {
                                    <option value="@wt.Value">@wt.Text</option>
                                    }
                            </select>
                        </div>
 *@
                        <p>Seçdiyiniz işçinin müqaviləsi export ediləcək:</p>
                        <div class="table-responsive" style="max-height:200px; overflow:auto;">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Seçin</th>
                                        <th>Ad</th>
                                        <th>Soyad</th>
                                        <th>FİN Kodu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr data-workertype ="@item.WorkerType">
                                            <td>
                                                <input type="radio" name="selectedExpertIds" value="@item.Id" class="select-item" />
                                            </td>
                                            <td>@item.Name</td>
                                            <td>@item.Surname</td>
                                            <td>@item.FinCode</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                        <button type="submit" class="btn btn-primary">Export et</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <input type="text" name="searchName" value="@ViewContext.HttpContext.Request.Query["searchName"]" class="form-control" placeholder="Ad və soyad axtar..." style="max-width: 200px;" />
        <input type="text" name="finCode" value="@ViewContext.HttpContext.Request.Query["finCode"]" class="form-control" placeholder="FİN Kod..." style="max-width: 150px;" />
        <input type="text" name="serial" value="@ViewContext.HttpContext.Request.Query["serial"]" class="form-control" placeholder="Seriya..." style="max-width: 150px;" />
        <select name="genderId" class="form-select" style="max-width: 150px;">
            <option value="">Cins seçin</option>
            @foreach (var gender in ViewBag.Genders)
            {
                <option value="@gender.Id" selected="@(gender.Id.ToString() == ViewContext.HttpContext.Request.Query["genderId"])">@gender.Name</option>
            }
        </select>
        <select name="district" class="form-select" style="max-width: 150px;">
            <option value="">Rayon seçin</option>
            @foreach (var district in ViewBag.Districts)
            {
                <option value="@district.Id" selected="@(district.Id.ToString() == ViewContext.HttpContext.Request.Query["district"])">@district.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Axtar</button>
        <a href="@Url.Action("Index", "Worker")" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Sıfırla</a>
    </form>



    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Ata adı</th>
                    <th>Cins</th>
                    <th>Doğum tarixi</th>
                    <th>İş yeri</th>
                    <th>Tel.</th>
                    <th>FİN Kodu</th>
                    <th>Seriya</th>
                    <th>İstiqamət</th>
                    <th>Rayon</th>
                    <th>İş vəzifəsi</th>
                    <th class="text-center">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1;
                }
                @foreach (var item in Model)
                {
                    <tr class="align-middle @(item.Status == 1 ? "table-danger" : "")">
                        <td>@rowNumber</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Surname)</td>
                        <td>@Html.DisplayFor(modelItem => item.Fname)</td>
                        <td>@Html.DisplayFor(modelItem => item.GenderNavigation.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.BirthDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.Workplace)</td>
                        <td>@Html.DisplayFor(modelItem => item.TelIs)</td>
                        <td>@Html.DisplayFor(modelItem => item.FinCode)</td>
                        <td>@Html.DisplayFor(modelItem => item.Serial)</td>
                        <td>@Html.DisplayFor(modelItem => item.Section.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.DistrictNavigation.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.WorkerTypeNavigation.Name)</td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i></a>
                                <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye"></i></a>
                                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>
        </table>
    </div>
</div>

