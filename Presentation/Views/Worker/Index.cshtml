@model IEnumerable<ForQab.DataAccess.Models.Monitor>
@{
    ViewData["Title"] = "Digər işçilər";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
    var q = ViewContext.HttpContext.Request.Query;
}
<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Monitors/Index.css" asp-append-version="true" />

<div class="container qab-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="qab-alert qab-alert--success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
    }

    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-people-fill"></i></span>
                    Digər işçilər
                </h1>
            </div>
            <div style="display:flex;gap:.5rem;">
                <a class="qab-page-header__back" asp-action="Archived"><i class="bi bi-archive"></i> Arxiv</a>
                <a class="qab-page-header__back" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Ana səhifə</a>
            </div>
        </div>
    </div>

    <div class="qab-actionbar">
        <a class="qab-btn qab-btn--primary" asp-action="Create"><i class="bi bi-plus-circle"></i> Yeni işçi</a>
        <a class="qab-btn qab-btn--excel" asp-action="ExportToExcel"><i class="bi bi-file-earmark-excel"></i> Excel-ə çıxarış</a>
        <button class="qab-btn qab-btn--word" data-bs-toggle="modal" data-bs-target="#contractModal">
            <i class="bi bi-file-earmark-word"></i> Müqavilə export
        </button>
        <form asp-action="ImportFromExcel" enctype="multipart/form-data" method="post" style="margin:0;">
            <label class="qab-btn qab-btn--outline qab-btn--sm" style="cursor:pointer;margin:0;">
                <i class="bi bi-upload"></i> Excel idxal
                <input type="file" name="excelFile" style="display:none;" onchange="this.form.submit()" />
            </label>
        </form>
    </div>

    <!-- Filters -->
    <div class="qab-card" style="margin-bottom:1.25rem;">
        <div class="qab-card__body qab-card__body--tight">
            <form method="get" asp-action="Index" class="qab-filters">
                <div class="qab-filters__field">
                    <label class="qab-filters__label">Ad / Soyad</label>
                    <input type="text" name="searchName" value="@q["searchName"]" class="form-control" placeholder="Ad..." />
                </div>
                <div class="qab-filters__field">
                    <label class="qab-filters__label">FİN Kod</label>
                    <input type="text" name="finCode" value="@q["finCode"]" class="form-control" placeholder="FİN..." />
                </div>
                <div class="qab-filters__field">
                    <label class="qab-filters__label">İşçi tipi</label>
                    <select name="workerTypeId" class="form-select">
                        <option value="">Hamısı</option>
                        @if (ViewBag.WorkerTypes != null)
                        {
                            foreach (var wt in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.WorkerTypes)
                            {
                                <option value="@wt.Value" selected="@(wt.Value == q["workerTypeId"] ? "selected" : null)">@wt.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="qab-filters__field">
                    <label class="qab-filters__label">Rayon</label>
                    <select name="district" class="form-select">
                        <option value="">Hamısı</option>
                        @foreach (var d in ViewBag.Districts)
                        {
                            <option value="@d.Id" selected="@(d.Id.ToString() == q["district"] ? "selected" : null)">@d.Name</option>
                        }
                    </select>
                </div>
                <div style="display:flex;gap:.4rem;align-items:end;">
                    <button type="submit" class="qab-btn qab-btn--primary qab-btn--sm"><i class="bi bi-search"></i> Axtar</button>
                    <a href="@Url.Action("Index")" class="qab-btn qab-btn--ghost qab-btn--sm"><i class="bi bi-x-circle"></i> Sıfırla</a>
                </div>
            </form>
        </div>
    </div>

    <div class="qab-table-wrap">
        <table class="qab-table qab-table--compact">
            <colgroup>
                <col style="width:2.5rem">
                <col style="width:auto">
                <col style="width:8rem">
                <col style="width:7.5rem">
                <col style="width:8rem">
                <col style="width:7rem">
                <col style="width:4rem">
                <col style="width:6.5rem">
            </colgroup>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad Soyad</th>
                    <th>İşçi tipi</th>
                    <th>Telefon</th>
                    <th>FİN / Seriya</th>
                    <th>Rayon</th>
                    <th>İştirak</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="qab-col-num">@i</td>
                        <td>
                            <div class="qab-col-name">
                                <strong>@item.Surname @item.Name @item.Fname</strong>
                                @if (!string.IsNullOrEmpty(item.ExamBuilding?.Name))
                                {
                                    <span class="qab-badge qab-badge--neutral" style="font-size:.72rem;">@item.ExamBuilding.Name</span>
                                }
                            </div>
                        </td>
                        <td><span class="qab-badge qab-badge--primary">@item.WorkerTypeNavigation?.Name</span></td>
                        <td class="qab-col-date">@item.TelIs</td>
                        <td>
                            <div style="font-size:.83rem;">
                                <div>@item.FinCode</div>
                                <div class="text-muted">@item.SerialPrefix @item.Serial</div>
                            </div>
                        </td>
                        <td class="qab-col-wrap">@item.DistrictNavigation?.Name</td>
                        <td><span class="qab-badge qab-badge--neutral">@item.ComputedAssignmentCount</span></td>
                        <td>
                            <div class="qab-table__actions">
                                <a class="qab-table__action-btn qab-table__action-btn--view"
                                   asp-action="Details" asp-route-id="@item.Id" title="Detallar">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--edit"
                                   asp-action="Edit" asp-route-id="@item.Id" title="Redaktə">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--delete"
                                   asp-action="Delete" asp-route-id="@item.Id" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Müqavilə Modal -->
<div class="modal fade" id="contractModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content qab-page">
            <form asp-action="ExportContracts" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Müqavilə export</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="qab-form__field">
                        <label class="form-label">Müqavilə tarixi</label>
                        <input type="date" name="contractDate" class="form-control" required />
                    </div>
                    <div class="qab-form__field">
                        <label class="form-label">İşçi tipi</label>
                        <select name="workerType" class="form-select" required>
                            <option value="">Seçin</option>
                            @if (ViewBag.WorkerTypes != null)
                            {
                                foreach (var wt in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.WorkerTypes)
                                {
                                    <option value="@wt.Value">@wt.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="qab-btn qab-btn--ghost" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="qab-btn qab-btn--primary">Export et</button>
                </div>
            </form>
        </div>
    </div>
</div>
