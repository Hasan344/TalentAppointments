@model ForQab.DataAccess.Models.Monitor
@{
    ViewData["Title"] = "İşçi detalları";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Monitors/Index.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-people-fill"></i></span>
                    @Model.Surname @Model.Name @Model.Fname
                </h1>
                <p class="qab-page-header__subtitle">
                    @Model.WorkerTypeNavigation?.Name &middot; @Model.ExamBuilding?.Name
                </p>
            </div>
            <a class="qab-page-header__back" asp-action="Index"><i class="bi bi-arrow-left"></i> Siyahıya qayıt</a>
        </div>
    </div>

    @* ─── AMAS / status mesajları ─── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="qab-alert qab-alert--success" style="margin-bottom:1rem;">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="qab-alert qab-alert--danger" style="margin-bottom:1rem;">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="qab-card" style="margin-bottom:1.5rem;">
        <div class="qab-card__header">
            <h2 class="qab-card__title"><i class="bi bi-person-circle"></i> Şəxsi məlumatlar</h2>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                <a class="qab-btn qab-btn--outline-warning qab-btn--sm" asp-action="Edit" asp-route-id="@Model.Id">
                    <i class="bi bi-pencil-square"></i> Redaktə
                </a>

                @* ─── YENİ: AMAS-dan şəkil çək ─── *@
                <form asp-controller="Worker" asp-action="FetchPhoto" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="qab-btn qab-btn--sm"
                            style="background:var(--qab-primary);color:#fff;"
                            onclick="this.disabled=true; this.innerHTML='<i class=\'bi bi-hourglass-split\'></i> Yüklənir...'; this.form.submit();">
                        <i class="bi bi-camera"></i> Şəkil çək (AMAS)
                    </button>
                </form>

                <a class="qab-btn qab-btn--outline-danger qab-btn--sm" asp-action="Delete" asp-route-id="@Model.Id">
                    <i class="bi bi-trash"></i> Sil
                </a>
            </div>
        </div>
        <div class="qab-card__body">
            <div style="display:grid;grid-template-columns:auto 1fr;gap:2rem;align-items:start;">
                <div style="text-align:center;min-width:270px;">
                    @if (!string.IsNullOrEmpty(Model.Photo))
                    {
                        <img src="@Model.Photo" class="rounded-circle"
                             style="width:250px;height:250px;object-fit:cover;border:4px solid var(--qab-border);box-shadow:var(--qab-shadow-md);" />
                    }
                    else
                    {
                        <div style="width:250px;height:250px;border-radius:50%;background:var(--qab-primary-soft);
                                    display:flex;align-items:center;justify-content:center;margin:0 auto;
                                    border:4px solid var(--qab-border);box-shadow:var(--qab-shadow-md);">
                            <i class="bi bi-person-fill" style="font-size:6rem;color:var(--qab-primary);"></i>
                        </div>
                    }
                    <p style="margin:.6rem 0 0;font-size:.85rem;color:var(--qab-text-muted);">
                        Ümumi iştirak: <strong>@Model.ComputedAssignmentCount</strong>
                    </p>
                </div>
                <div class="qab-details__grid">
                    <div>
                        <div class="qab-details__row"><dt class="qab-details__label">Ad</dt><dd class="qab-details__value">@Model.Name @Model.Surname @Model.Fname</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">Cins</dt><dd class="qab-details__value">@Model.GenderNavigation?.Name</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">Doğum tarixi</dt><dd class="qab-details__value">@Model.BirthDate?.ToString("dd.MM.yyyy")</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">Telefon</dt><dd class="qab-details__value">@Model.TelIs</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">FİN Kod</dt><dd class="qab-details__value">@Model.FinCode</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">Seriya</dt><dd class="qab-details__value">@Model.SerialPrefix @Model.Serial</dd></div>
                    </div>
                    <div>
                        <div class="qab-details__row"><dt class="qab-details__label">İstiqamət</dt><dd class="qab-details__value">@Model.Section?.Name</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">Rayon</dt><dd class="qab-details__value">@Model.DistrictNavigation?.Name</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">İşçi tipi</dt><dd class="qab-details__value">@Model.WorkerTypeNavigation?.Name</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">İmtahan binası</dt><dd class="qab-details__value">@Model.ExamBuilding?.Name</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">Region</dt><dd class="qab-details__value">@Model.Region</dd></div>
                        <div class="qab-details__row"><dt class="qab-details__label">Müqavilə</dt><dd class="qab-details__value">@Model.ContractNo — @Model.ContractDate?.ToString("dd.MM.yyyy")</dd></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
