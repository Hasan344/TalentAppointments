@using ForQab.DataAccess.ViewModel.Worker
@model WorkerEditViewModel
@{
    ViewData["Title"] = "İşçini redaktə et";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-pencil-square"></i></span>
                    İşçini redaktə et
                </h1>
                <p class="qab-page-header__subtitle">@Model.Surname @Model.Name @Model.Fname</p>
            </div>
            <a class="qab-page-header__back" asp-action="Index"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="qab-form">
        <div asp-validation-summary="ModelOnly" class="qab-form__validation"></div>
        <input type="hidden" asp-for="Id" />

        <div class="qab-form__section">
            <div class="qab-form__section-title">Şəxsi məlumatlar</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="Name" class="form-label">Ad <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Surname" class="form-label">Soyad <span class="text-danger">*</span></label>
                    <input asp-for="Surname" class="form-control" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Fname" class="form-label">Ata adı</label>
                    <input asp-for="Fname" class="form-control" />
                </div>
            </div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="Gender" class="form-label">Cins</label>
                    <select asp-for="Gender" class="form-select"
                            asp-items="@(new SelectList(new[]{new{Id=(byte)1,N="Kişi"},new{Id=(byte)2,N="Qadın"}},"Id","N",Model.Gender))">
                        <option value="">Seçin</option>
                    </select>
                </div>
                <div class="qab-form__field">
                    <label asp-for="BirthDate" class="form-label">Doğum tarixi</label>
                    <input asp-for="BirthDate" type="date" class="form-control"
                           value="@Model.BirthDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="TelIs" class="form-label">Telefon</label>
                    <input asp-for="TelIs" class="form-control" />
                </div>
            </div>
        </div>

        <div class="qab-form__section">
            <div class="qab-form__section-title">İş məlumatları</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="WorkerType" class="form-label">İşçi tipi <span class="text-danger">*</span></label>
                    <select asp-for="WorkerType" class="form-select"
                            asp-items="@(Model.WorkerTypes != null ? new SelectList(Model.WorkerTypes, "Value", "Text", Model.WorkerType?.ToString()) : new SelectList(Enumerable.Empty<SelectListItem>()))">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="WorkerType" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="SectionId" class="form-label">İstiqamət <span class="text-danger">*</span></label>
                    <select asp-for="SectionId" class="form-select"
                            asp-items="@(Model.Sections != null ? new SelectList(Model.Sections, "Value", "Text", Model.SectionId?.ToString()) : new SelectList(Enumerable.Empty<SelectListItem>()))">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="SectionId" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="ExamBuilding" class="form-label">İmtahan binası <span class="text-danger">*</span></label>
                    <select asp-for="ExamBuilding" class="form-select"
                            asp-items="@(Model.ExamBuildings != null ? new SelectList(Model.ExamBuildings, "Value", "Text", Model.ExamBuilding?.ToString()) : new SelectList(Enumerable.Empty<SelectListItem>()))">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="ExamBuilding" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="qab-form__section">
            <div class="qab-form__section-title">Sənəd məlumatları</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="FinCode" class="form-label">FİN Kod</label>
                    <input asp-for="FinCode" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="SerialPrefix" class="form-label">Seriya prefiksi</label>
                    <input asp-for="SerialPrefix" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="Serial" class="form-label">Seriya nömrəsi</label>
                    <input asp-for="Serial" class="form-control" />
                </div>
            </div>
        </div>

        <div class="qab-form__section">
            <div class="qab-form__section-title">Ünvan</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="District" class="form-label">Rayon <span class="text-danger">*</span></label>
                    <select asp-for="District" class="form-select"
                            asp-items="@(Model.Districts != null ? new SelectList(Model.Districts, "Value", "Text", Model.District?.ToString()) : new SelectList(Enumerable.Empty<SelectListItem>()))">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="District" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Region" class="form-label">Region</label>
                    <input asp-for="Region" class="form-control" />
                </div>
            </div>
        </div>

        <div class="qab-form__section">
            <div class="qab-form__section-title">Maliyyə məlumatları</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="SSN" class="form-label">SSN</label>
                    <input asp-for="SSN" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="Rekvizit" class="form-label">Rekvizit</label>
                    <input asp-for="Rekvizit" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="Voen" class="form-label">VÖEN</label>
                    <input asp-for="Voen" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="BankFilial" class="form-label">Bank filialı</label>
                    <input asp-for="BankFilial" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="BankFilialCode" class="form-label">Bank filial kodu</label>
                    <input asp-for="BankFilialCode" class="form-control" />
                </div>
            </div>
        </div>

        <div class="qab-form__footer">
            <a asp-action="Index" class="qab-btn qab-btn--outline"><i class="bi bi-arrow-left"></i> Ləğv et</a>
            <button type="submit" class="qab-btn qab-btn--primary qab-btn--lg"><i class="bi bi-check-circle"></i> Yadda saxla</button>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
