@model IEnumerable<ForQab.DataAccess.Models.Monitor>

<div class="container mt-4">
    @if (Model.Any())
    {
        foreach (var monitor in Model)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        @monitor.Name @monitor.Surname @monitor.Fname
                        <small>(FinCode: @monitor.FinCode)</small>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 5%;">#</th>
                                <th scope="col">Qeyd</th>
                                <th scope="col">İmtahan ID</th>
                                <th scope="col">Daxil edən istifadəçi</th>
                                <th scope="col">Daxil edilən tarix</th>
                                <th scope="col" style="width: 30%;">Növ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (monitor.MonitorLogs != null && monitor.MonitorLogs.Any())
                            {
                                int count = 1;
                                foreach (var log in monitor.MonitorLogs)
                                {
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@log.Note</td>
                                        <td>@log.ExamId</td>
                                        <td>@log.UserName</td>
                                        <td>@log.Time</td>
                                        <td>
                                            @switch (log.Kind)
                                            {
                                                case 0:
                                                    @:Gəlməyən haqqında qeyd
                                                    break;
                                                case 1:
                                                    @:Xaric olan haqqında qeyd
                                                    break;
                                                case 2:
                                                    @:Digər səbəblərlə bağlı qeyd
                                                    break;
                                                default:
                                                    @:Bilinməyən
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="DeleteLogs" method="post">
                                                <input type="hidden" name="id" value="@log.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Bu qeydi silmək istədiyinizə əminsiniz?');">
                                                    Sil
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    count++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">Heç bir qeyd tapılmadı.</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            Sistemdə heç bir rəhbər tapılmadı.
        </div>
    }
    <div class="mt-3">
        <a class="btn btn-secondary" href="javascript:history.back()">Geri Qayıt</a>
    </div>
</div>
