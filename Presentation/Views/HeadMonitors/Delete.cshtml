@model ForQab.DataAccess.Models.Monitor

@{
    ViewData["Title"] = "İmtahan rəhbəri Sil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-body">
                    <h4 class="text-center text-danger">Bu rəhbəri silmək istədiyinizə əminsiniz?</h4>

                    <div class="mt-4">
                        <h5>Detallar</h5>
                        <hr />
                        <dl class="row">
                            <dt class="col-sm-4 font-weight-bold">Ad:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                            <dt class="col-sm-4 font-weight-bold">Soyad:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Surname)</dd>

                            <dt class="col-sm-4 font-weight-bold">Ata adı:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Fname)</dd>

                            <dt class="col-sm-4 font-weight-bold">Cins:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.GenderNavigation.Name)</dd>

                            <dt class="col-sm-4 font-weight-bold">VNum:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.VNum)</dd>

                            <dt class="col-sm-4 font-weight-bold">Peşə:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Profession)</dd>

                            <dt class="col-sm-4 font-weight-bold">İş yeri:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Workplace)</dd>

                            <dt class="col-sm-4 font-weight-bold">Vəzifə:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Position)</dd>

                            <dt class="col-sm-4 font-weight-bold">Telefonu:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.TelIs)</dd>

                            <dt class="col-sm-4 font-weight-bold">FİN Kodu:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.FinCode)</dd>

                            <dt class="col-sm-4 font-weight-bold">Seriya:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Serial)</dd>
                        </dl>
                    </div>

                    <div class="mt-4 text-center">
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger btn-lg px-4">Bəli, Sil</button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg px-4 ml-3">Siyahıya Qayıt</a>
                        </form>
                        <div class="mt-4 text-center">
                            <div class="mt-4 text-center">
                                <button type="button" class="btn btn-warning btn-lg px-4" onclick="openArchiveModal()">Arxivə Yolla</button>
                            </div>

                            <div class="modal fade" id="archiveModal" tabindex="-1" aria-labelledby="archiveModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="archiveModalLabel">Arxivə Göndər</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <form id="archiveForm" method="post" asp-action="ArchiveMonitor">
                                                <input type="hidden" id="archiveId" name="id" value="@Model.Id" />
                                                <div class="mb-3">
                                                    <label for="archiveReason" class="form-label">Arxivləmə Səbəbi:</label>
                                                    <textarea class="form-control" id="archiveReason" name="archiveReason" rows="3" required></textarea>
                                                </div>
                                            </form>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                                            <button type="submit" class="btn btn-warning" onclick="submitArchiveForm()">Arxivə Göndər</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function openArchiveModal() {
        var modal = new bootstrap.Modal(document.getElementById("archiveModal"));
        modal.show();
    }

    function submitArchiveForm() {
        document.getElementById("archiveForm").submit();
    }
</script>