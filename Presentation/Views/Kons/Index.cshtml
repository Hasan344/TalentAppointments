@model IEnumerable<ForQab.DataAccess.Models.Expert>
@{
    ViewData["Title"] = "Konsertmeysterlər";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
    var q = ViewContext.HttpContext.Request.Query;
}
<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Expert/Index.css" asp-append-version="true" />

<div class="container qab-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="qab-alert qab-alert--success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ImportError"] != null)
    {
        <div class="qab-alert qab-alert--danger"><i class="bi bi-exclamation-circle-fill"></i> @TempData["ImportError"]</div>
    }

    <!-- Page Header -->
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-music-note-beamed"></i></span>
                    Konsertmeysterlər İdarəetməsi
                </h1>
            </div>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                <a class="qab-page-header__back" asp-action="KonsLogs">
                    <i class="bi bi-journal"></i> Xüsusi qeydlər
                </a>
                <a class="qab-page-header__back" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house"></i> Ana səhifə
                </a>
            </div>
        </div>
    </div>

    <!-- Action bar -->
    <div class="qab-actionbar">
        <a class="qab-btn qab-btn--primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Yeni konsertmeyster
        </a>
        <a class="qab-btn qab-btn--excel"
           href="@Url.Action("ExportToExcel", new { searchName = q["searchName"], finCode = q["finCode"], serial = q["serial"], genderId = q["genderId"], district = q["district"], subProfessionId = q["subProfessionId"] })">
            <i class="bi bi-file-earmark-excel"></i> Excel-ə çıxarış
        </a>
        <button class="qab-btn qab-btn--word" data-bs-toggle="modal" data-bs-target="#exportContractModal">
            <i class="bi bi-file-earmark-word"></i> Müqavilə export
        </button>
        <form asp-action="ImportFromExcel" enctype="multipart/form-data" method="post" style="margin:0;">
            <label class="qab-btn qab-btn--outline qab-btn--sm" style="cursor:pointer;margin:0;">
                <i class="bi bi-upload"></i> Excel idxal
                <input type="file" name="excelFile" style="display:none;" onchange="this.form.submit()" />
            </label>
        </form>
    </div>

    <!-- Filters -->
    <div class="qab-card" style="margin-bottom:1.25rem;">
        <div class="qab-card__body qab-card__body--tight">
            <form method="get" asp-action="Index" class="qab-filters">
                <div class="qab-filters__field">
                    <label class="qab-filters__label">Ad / Soyad</label>
                    <input type="text" name="searchName" value="@q["searchName"]" class="form-control" placeholder="Ad..." />
                </div>
                <div class="qab-filters__field">
                    <label class="qab-filters__label">FİN Kod</label>
                    <input type="text" name="finCode" value="@q["finCode"]" class="form-control" placeholder="FİN..." />
                </div>
                <div class="qab-filters__field">
                    <label class="qab-filters__label">Cins</label>
                    <select name="genderId" class="form-select">
                        <option value="">Hamısı</option>
                        @foreach (var g in ViewBag.Genders)
                        {
                            <option value="@g.Id" selected="@(g.Id.ToString() == q["genderId"] ? "selected" : null)">@g.Name</option>
                        }
                    </select>
                </div>
                <div class="qab-filters__field">
                    <label class="qab-filters__label">Rayon</label>
                    <select name="district" class="form-select">
                        <option value="">Hamısı</option>
                        @foreach (var d in ViewBag.Districts)
                        {
                            <option value="@d.Id" selected="@(d.Id.ToString() == q["district"] ? "selected" : null)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="qab-filters__field">
                    <label class="qab-filters__label">İxtisas</label>
                    <select name="subProfessionId" class="form-select">
                        <option value="">Hamısı</option>
                        @foreach (var sp in ViewBag.SubProfessions)
                        {
                            <option value="@sp.Id" selected="@(sp.Id.ToString() == q["subProfessionId"] ? "selected" : null)">@sp.Name</option>
                        }
                    </select>
                </div>
                <div style="display:flex;gap:.4rem;align-items:end;">
                    <button type="submit" class="qab-btn qab-btn--primary qab-btn--sm">
                        <i class="bi bi-search"></i> Axtar
                    </button>
                    <a href="@Url.Action("Index")" class="qab-btn qab-btn--ghost qab-btn--sm">
                        <i class="bi bi-x-circle"></i> Sıfırla
                    </a>
                </div>
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="@(ViewBag.PageSize != null ? (int)ViewBag.PageSize : 25)" />
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="qab-table-wrap">
        <table class="qab-table qab-table--compact">
            <colgroup>
                <col style="width:2.5rem">
                <col style="width:auto">
                <col style="width:5rem">
                <col style="width:7rem">
                <col style="width:auto">
                <col style="width:7rem">
                <col style="width:8rem">
                <col style="width:4rem">
                <col style="width:4rem">
                <col style="width:6.5rem">
            </colgroup>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad Soyad</th>
                    <th>Cins</th>
                    <th>Doğum tarixi</th>
                    <th>İxtisas</th>
                    <th>Telefon</th>
                    <th>FİN / Seriya</th>
                    <th title="Ümumi iştirak">İştirak</th>
                    <th title="Bu il">Bu il</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr class="@(item.Status == 1 ? "qab-status--blocked" : "")">
                        <td class="qab-col-num">@i</td>
                        <td>
                            <div class="qab-col-name">
                                <strong>@item.Surname @item.Name @item.Fname</strong>
                                @if (item.Status == 1)
                                {
                                    <span class="qab-status-badge qab-status-badge--blocked">
                                        <i class="bi bi-x-circle-fill"></i> Çağırıla bilməz
                                    </span>
                                }
                            </div>
                        </td>
                        <td>@item.GenderNavigation?.Name</td>
                        <td class="qab-col-date">@item.BirthDate?.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (item.ExpertsProfessions?.Any() == true)
                            {
                                <div style="font-size:.83rem;">
                                    @string.Join(", ", item.ExpertsProfessions.Select(ep => ep.SubProfession?.Name))
                                </div>
                            }
                        </td>
                        <td class="qab-col-date">@item.TelIs</td>
                        <td>
                            <div style="font-size:.83rem;">
                                <div>@item.FinCode</div>
                                <div class="text-muted">@item.SerialPrefix @item.Serial</div>
                            </div>
                        </td>
                        <td><span class="qab-badge qab-badge--neutral">@item.ComputedAssignmentCount</span></td>
                        <td><span class="qab-badge qab-badge--primary">@item.ThisYearAssignmentCount</span></td>
                        <td>
                            <div class="qab-table__actions">
                                <a class="qab-table__action-btn qab-table__action-btn--view"
                                   asp-action="Details" asp-route-id="@item.Id" title="Detallar">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--edit"
                                   asp-action="Edit" asp-route-id="@item.Id" title="Redaktə">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--delete"
                                   asp-action="Delete" asp-route-id="@item.Id" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @{
        int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
        int totalPages  = ViewBag.TotalPages  != null ? (int)ViewBag.TotalPages  : 1;
        int totalCount  = ViewBag.TotalCount  != null ? (int)ViewBag.TotalCount  : 0;
        int pageSize    = ViewBag.PageSize    != null ? (int)ViewBag.PageSize    : 25;
        int startItem   = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
        int endItem     = Math.Min(currentPage * pageSize, totalCount);

        var routeVals = new Dictionary<string, string?> {
            ["searchName"]      = q["searchName"],
            ["finCode"]         = q["finCode"],
            ["serial"]          = q["serial"],
            ["genderId"]        = q["genderId"],
            ["district"]        = q["district"],
            ["subProfessionId"] = q["subProfessionId"],
            ["pageSize"]        = pageSize.ToString()
        };

        int winStart = Math.Max(1, currentPage - 2);
        int winEnd   = Math.Min(totalPages, currentPage + 2);
    }

    @if (totalCount > 0)
    {
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;
                    margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--qab-border);">
            <span style="font-size:.85rem;color:var(--qab-text-muted);">
                <strong>@startItem–@endItem</strong> / <strong>@totalCount</strong> konsertmeyster
            </span>
            <div style="display:flex;align-items:center;gap:.4rem;">
                <span style="font-size:.82rem;color:var(--qab-text-muted);">Səhifədə:</span>
                @foreach (var ps in new[] { 10, 25, 50, 100 })
                {
                    var psRoute = new Dictionary<string, string?>(routeVals) { ["pageSize"] = ps.ToString(), ["page"] = "1" };
                    <a href="@Url.Action("Index", psRoute)"
                       class="qab-btn qab-btn--sm @(pageSize == ps ? "qab-btn--primary" : "qab-btn--ghost")"
                       style="min-width:2.4rem;justify-content:center;">@ps</a>
                }
            </div>
            @if (totalPages > 1)
            {
                <nav style="display:flex;align-items:center;gap:.25rem;">
                    @if (currentPage > 1)
                    {
                        <a href="@Url.Action("Index", new Dictionary<string,string?>(routeVals){["page"]="1"})" class="qab-btn qab-btn--ghost qab-btn--sm"><i class="bi bi-chevron-double-left"></i></a>
                        <a href="@Url.Action("Index", new Dictionary<string,string?>(routeVals){["page"]=(currentPage-1).ToString()})" class="qab-btn qab-btn--ghost qab-btn--sm"><i class="bi bi-chevron-left"></i></a>
                    }
                    @if (winStart > 1)
                    {
                        <a href="@Url.Action("Index", new Dictionary<string,string?>(routeVals){["page"]="1"})" class="qab-btn qab-btn--ghost qab-btn--sm">1</a>
                        @if (winStart > 2) { <span style="color:var(--qab-text-muted);padding:0 .2rem;">…</span> }
                    }
                    @for (int p = winStart; p <= winEnd; p++)
                    {
                        <a href="@Url.Action("Index", new Dictionary<string,string?>(routeVals){["page"]=p.ToString()})"
                           class="qab-btn qab-btn--sm @(p == currentPage ? "qab-btn--primary" : "qab-btn--ghost")"
                           style="min-width:2.4rem;justify-content:center;">@p</a>
                    }
                    @if (winEnd < totalPages)
                    {
                        @if (winEnd < totalPages - 1) { <span style="color:var(--qab-text-muted);padding:0 .2rem;">…</span> }
                        <a href="@Url.Action("Index", new Dictionary<string,string?>(routeVals){["page"]=totalPages.ToString()})" class="qab-btn qab-btn--ghost qab-btn--sm">@totalPages</a>
                    }
                    @if (currentPage < totalPages)
                    {
                        <a href="@Url.Action("Index", new Dictionary<string,string?>(routeVals){["page"]=(currentPage+1).ToString()})" class="qab-btn qab-btn--ghost qab-btn--sm"><i class="bi bi-chevron-right"></i></a>
                        <a href="@Url.Action("Index", new Dictionary<string,string?>(routeVals){["page"]=totalPages.ToString()})" class="qab-btn qab-btn--ghost qab-btn--sm"><i class="bi bi-chevron-double-right"></i></a>
                    }
                </nav>
            }
        </div>
    }
</div>

<!-- Müqavilə Export Modal -->
<div class="modal fade" id="exportContractModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content qab-page">
            <form method="post" asp-action="ExportContracts">
                <div class="modal-header">
                    <h5 class="modal-title">Müqavilə Export</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="qab-form__field">
                        <label class="form-label">Müqavilə tarixi</label>
                        <input type="date" name="contractDate" class="form-control" required />
                    </div>
                    <div class="qab-table-wrap" style="max-height:220px;">
                        <table class="qab-table">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="selAll" /></th>
                                    <th>Ad</th>
                                    <th>Soyad</th>
                                    <th>FİN</th>
                                    <th>İxtisas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><input type="checkbox" name="selectedKonsIds" value="@item.Id" class="kons-sel" /></td>
                                        <td>@item.Name</td>
                                        <td>@item.Surname</td>
                                        <td>@item.FinCode</td>
                                        <td style="font-size:.83rem;">@string.Join(", ", item.ExpertsProfessions?.Select(ep => ep.SubProfession?.Name) ?? new List<string?>())</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="qab-btn qab-btn--ghost" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="qab-btn qab-btn--primary">Export et</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('selAll')?.addEventListener('change', function () {
            document.querySelectorAll('.kons-sel').forEach(cb => cb.checked = this.checked);
        });
    </script>
}
