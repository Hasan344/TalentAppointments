@using ForQab.DataAccess.ViewModel.Expert
@model KonsEditViewModel
@{
    ViewData["Title"] = "Konsertmeysteri redaktə et";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-pencil-square"></i></span>
                    Konsertmeysteri redaktə et
                </h1>
                <p class="qab-page-header__subtitle">@Model.Surname @Model.Name @Model.Fname</p>
            </div>
            <a class="qab-page-header__back" asp-action="Index"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="qab-form">
        <div asp-validation-summary="ModelOnly" class="qab-form__validation"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Kons" value="true" />

        <!-- Şəxsi məlumatlar -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">Şəxsi məlumatlar</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="Name" class="form-label">Ad</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="Surname" class="form-label">Soyad</label>
                    <input asp-for="Surname" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="Fname" class="form-label">Ata adı</label>
                    <input asp-for="Fname" class="form-control" />
                </div>
            </div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="BirthDate" class="form-label">Doğum tarixi</label>
                    <input asp-for="BirthDate" type="date" class="form-control"
                           value="@Model.BirthDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="TelIs" class="form-label">İş telefonu</label>
                    <input asp-for="TelIs" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="TelEl" class="form-label">Əlaqə telefonu</label>
                    <input asp-for="TelEl" class="form-control" />
                </div>
            </div>
        </div>

        <!-- Sənəd -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">Sənəd məlumatları</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="FinCode" class="form-label">FİN Kod</label>
                    <input asp-for="FinCode" class="form-control" />
                </div>
                <partial name="_SerialPrefixSelect" model="@Model.SerialPrefix" />
                <div class="qab-form__field">
                    <label asp-for="Serial" class="form-label">Seriya nömrəsi</label>
                    <input asp-for="Serial" class="form-control" />
                </div>
            </div>
        </div>

        <!-- İxtisas / İstiqamət -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">İxtisas və istiqamət</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="SectionId" class="form-label">İstiqamət</label>
                    <select asp-for="SectionId" class="form-select"
                            asp-items="@(ViewData["SectionId"] as SelectList)">
                        <option value="">Seçin</option>
                    </select>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Profession" class="form-label">Peşə</label>
                    <input asp-for="Profession" class="form-control" />
                </div>
            </div>
            @if (Model.SubProfessions != null && Model.SubProfessions.Any())
            {
                <div class="qab-form__field">
                    <label class="form-label">İxtisaslar</label>
                    <select asp-for="SelectedSubProfessions" class="form-select" multiple>
                        @foreach (var sp in Model.SubProfessions)
                        {
                            var isSelected = Model.SelectedSubProfessions != null
                                && Model.SelectedSubProfessions.Contains(int.Parse(sp.Value));
                            <option value="@sp.Value" selected="@(isSelected ? "selected" : null)">@sp.Text</option>
                        }
                    </select>
                </div>
            }
        </div>

        <!-- Maliyyə -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">Maliyyə məlumatları</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="SSN" class="form-label">SSN</label>
                    <input asp-for="SSN" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="Rekvizit" class="form-label">Rekvizit</label>
                    <input asp-for="Rekvizit" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="HesablashmaH" class="form-label">Hesablaşma hesabı</label>
                    <input asp-for="HesablashmaH" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="Voen" class="form-label">VÖEN</label>
                    <input asp-for="Voen" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="BankFilial" class="form-label">Bank filialı</label>
                    <input asp-for="BankFilial" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="BankFilialCode" class="form-label">Bank filial kodu</label>
                    <input asp-for="BankFilialCode" class="form-control" />
                </div>
            </div>
        </div>

        <!-- Müqavilə -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">Müqavilə</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="ContractNo" class="form-label">Müqavilə nömrəsi</label>
                    <input asp-for="ContractNo" class="form-control" />
                </div>
                <div class="qab-form__field">
                    <label asp-for="ContractDate" class="form-label">Müqavilə tarixi</label>
                    <input asp-for="ContractDate" type="date" class="form-control"
                           value="@Model.ContractDate?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>

        <div class="qab-form__footer">
            <a asp-action="Index" class="qab-btn qab-btn--outline"><i class="bi bi-arrow-left"></i> Ləğv et</a>
            <button type="submit" class="qab-btn qab-btn--primary qab-btn--lg"><i class="bi bi-check-circle"></i> Yadda saxla</button>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
