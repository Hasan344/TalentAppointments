@model ForQab.DataAccess.Models.Subject
@{
    ViewData["Title"] = "Fənn yarat";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-plus-circle"></i></span>
                    Yeni fənn
                </h1>
            </div>
            <a class="qab-page-header__back" asp-action="Index"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <form asp-action="Create" method="post" class="qab-form">
                <div asp-validation-summary="ModelOnly" class="qab-form__validation"></div>
                <div class="qab-form__section">
                    <div class="qab-form__section-title">Fənn məlumatları</div>
                    <div class="qab-form__field">
                        <label asp-for="Name" class="form-label">Fənn adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Fənn adını daxil edin" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="qab-form__field">
                        <label asp-for="SectionId" class="form-label">İstiqamət</label>
                        <select asp-for="SectionId" class="form-select" asp-items="@(ViewBag.SectionList as SelectList)">
                            <option value="">Seçin</option>
                        </select>
                        <span asp-validation-for="SectionId" class="text-danger"></span>
                    </div>
                </div>
                <div class="qab-form__footer">
                    <a asp-action="Index" class="qab-btn qab-btn--outline"><i class="bi bi-arrow-left"></i> Ləğv et</a>
                    <button type="submit" class="qab-btn qab-btn--primary qab-btn--lg"><i class="bi bi-check-circle"></i> Yarat</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
