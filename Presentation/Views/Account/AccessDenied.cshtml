@{
    ViewData["Title"] = "Giriş Qadağandır";
}

<div style="display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f7f9fc; font-family: 'Roboto', Arial, sans-serif;">
    <div style="text-align: center; padding: 2rem; background: #ffffff; box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2); border-radius: 12px; max-width: 500px; width: 100%;">
        <h1 style="font-size: 2rem; color: #2c3e50; margin-bottom: 1.5rem;">
            Giriş Qadağandır
        </h1>
        <p style="font-size: 1rem; color: #7f8c8d; margin-bottom: 2rem;">
            Bu bölməyə giriş səlahiyyətiniz yoxdur. Zəhmət olmasa doğru bölməyə daxil olduğunuzdan əmin olun.
        </p>
        <a href="/" style="display: inline-block; background-color: #007bff; color: #ffffff; text-decoration: none; padding: 0.8rem 1.5rem; border-radius: 6px; font-size: 1rem; font-weight: bold; transition: background-color 0.3s ease;">
            Ana Səhifəyə Qayıt
        </a>
    </div>
</div>
