@using ForQab.ViewModel
@model RegisterViewModel

@{
    ViewData["Title"] = "Qeydiyyat";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f4f7fa;
            font-family: 'Arial', sans-serif;
        }

        .register-container {
            max-width: 400px;
            margin: 50px auto;
            padding: 30px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

            .register-container h1 {
                font-size: 1.8rem;
                font-weight: 600;
                margin-bottom: 20px;
                text-align: center;
                color: #333;
            }

        .form-group label {
            font-weight: 500;
        }

        .btn-primary {
            width: 100%;
        }

        .btn-link {
            font-size: 0.875rem;
            color: #007bff;
            text-decoration: none;
        }

            .btn-link:hover {
                text-decoration: underline;
            }

        .form-text {
            font-size: 0.875rem;
            color: #6c757d;
            text-align: center;
        }

        hr {
            border: 0;
            border-top: 1px solid #e3e3e3;
            margin: 15px 0;
        }
    </style>
</head>
<body>

    <div class="register-container">
        <h1>@ViewData["Title"]</h1>

        @if (Model != null)
        {
            <form method="post" asp-action="Register">
                <div class="form-group">
                    <label for="UserName">İstifadəçi adı</label>
                    <input asp-for="UserName" class="form-control" placeholder="İstifadəçi adı daxil edin" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="FirstName">Ad</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Ad daxil edin" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="LastName">Soyad</label>
                    <input asp-for="LastName" class="form-control" placeholder="Soyad daxil edin" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="Password">Şifrə</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Şifrə daxil edin" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="ConfirmPassword">Şifrəni təsdiqlə</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Şifrəni təkrar daxil edin" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <hr />
                <button type="submit" class="btn btn-primary btn-lg">Register</button>
            </form>
        }
        else
        {
            <p>Error: Model is null</p>
        }

        <div class="form-text mt-2">
            <p class="text-center">Already have an account? <a asp-action="Login" class="btn-link">Log in</a></p>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>
