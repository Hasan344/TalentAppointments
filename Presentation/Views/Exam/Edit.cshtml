@model ForQab.DataAccess.Models.Exam

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="background-color: #2c2f33; border-radius: 10px; color: #ffffff;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="text-center mb-4">@ViewData["Title"]</h1>
            <h4 class="text-center mb-4">Exam</h4>
            <hr style="border-color: #7289da;" />

            <form asp-action="Edit" method="post" class="p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">İmtahan adı</label>
                    <input asp-for="Name" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SectionId" class="form-label">Bölmə</label>
                    <select asp-for="SectionId" class="form-select" asp-items="ViewBag.SectionList" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>Bölmə seçin</option>
                    </select>
                    <span asp-validation-for="SectionId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ExamBuldingId" class="form-label">İmtahan binası</label>
                    <select asp-for="ExamBuldingId" class="form-select" asp-items="ViewBag.ExamBuildingList" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>İmtahan binası seçin</option>
                    </select>
                    <span asp-validation-for="ExamBuldingId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CommissionId" class="form-label">Komissiya</label>
                    <select asp-for="CommissionId" class="form-select" asp-items="ViewBag.CommissionList" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>Komissiya seçin</option>
                    </select>
                    <span asp-validation-for="CommissionId" class="text-danger"></span>
                </div>
@* 
                <div class="mb-3">
                    <label asp-for="SubCommissionId" class="form-label">Sub-Commission</label>
                    <select asp-for="SubCommissionId" class="form-select" asp-items="ViewBag.SubCommissionList" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>Select Sub-Commission</option>
                    </select>
                    <span asp-validation-for="SubCommissionId" class="text-danger"></span>
                </div> *@

                <div class="mb-3">
                    <label asp-for="ExamDate" class="form-label">İmtahan tarixi</label>
                    <input asp-for="ExamDate" class="form-control" type="date" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="ExamDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Duration" class="form-label">Müddət (saat)</label>
                    <input asp-for="Duration" class="form-control" type="number" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Water" class="form-label">Su</label>
                    <input asp-for="Water" class="form-control" type="number" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Water" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Food" class="form-label">Yemək</label>
                    <input asp-for="Food" class="form-control" type="number" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Food" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Qeydlər</label>
                    <input asp-for="Notes" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="InventoryTransport" class="form-label">Daşınmalı inventar</label>
                    <input asp-for="InventoryTransport" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="InventoryTransport" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary" style="background-color: #2f3136; color: #ffffff;">Geri</a>
                    <a asp-action="AssignExperts"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary" style="background-color: #7289da; border-color: #7289da;">
                        Ekspert təyin et
                    </a>
                    <a asp-action="AssignMonitors"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary" style="background-color: #7289da; border-color: #7289da;">
                        Nəzarətçi təyin et
                    </a>
                    <button type="submit" class="btn btn-primary" style="background-color: #7289da; border-color: #7289da;">Yadda saxla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
