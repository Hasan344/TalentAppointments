@model IEnumerable<ForQab.DataAccess.Models.Exam>

@{
    ViewData["Title"] = "İmtahanlar";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <!-- Page Header -->
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-journal-text"></i></span>
                    İmtahan idarəetməsi
                </h1>
                <p class="qab-page-header__subtitle">İmtahanları yarat, redaktə et və hesabatlar al</p>
            </div>
            <a class="qab-page-header__back" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house"></i> Ana səhifə
            </a>
        </div>
    </div>

    <!-- Toolbar (Subnav) -->
    <div class="qab-toolbar">
        <a class="qab-toolbar__btn" asp-controller="District" asp-action="Index">
            <i class="bi bi-geo-alt"></i> Rayonlar
        </a>
        <a class="qab-toolbar__btn" asp-controller="SubProfession" asp-action="Index">
            <i class="bi bi-briefcase"></i> İxtisaslar
        </a>
        <a class="qab-toolbar__btn" asp-controller="ExamBuilding" asp-action="Index">
            <i class="bi bi-building"></i> İmtahan binaları
        </a>
        <a class="qab-toolbar__btn" asp-controller="Subject" asp-action="Index">
            <i class="bi bi-book"></i> İmtahan fənləri
        </a>
        <a class="qab-toolbar__btn" asp-controller="Commission" asp-action="Index">
            <i class="bi bi-people"></i> Komissiyalar
        </a>
        @if (ViewBag.Section == 1 || ViewBag.Section == 2 || ViewBag.Section == 5)
        {
            <a class="qab-toolbar__btn" asp-controller="Federation" asp-action="Index">
                <i class="bi bi-bank"></i> Müəssisələr
            </a>
        }
        else
        {
            <a class="qab-toolbar__btn" asp-controller="Federation" asp-action="Index">
                <i class="bi bi-mortarboard"></i> Təhsil səviyyələri
            </a>
        }
        @if (ViewBag.Section == 2 || ViewBag.Section == 5)
        {
            <a class="qab-toolbar__btn" asp-action="Assesments">
                <i class="bi bi-pen"></i> Qiymətləndirmələr
            </a>
            <a class="qab-toolbar__btn" asp-action="Appeals">
                <i class="bi bi-pen"></i> Apellyasiya
            </a>
        }
    </div>

    <!-- Filters Card -->
    <div class="qab-card" style="margin-bottom: 1.25rem;">
        <div class="qab-card__body qab-card__body--tight">
            <form method="get" asp-action="Index" class="qab-filters">
                <div class="qab-filters__field">
                    <label class="qab-filters__label" for="examBuildingId">
                        <i class="bi bi-funnel"></i> İmtahan binası
                    </label>
                    <select class="form-select" id="examBuildingId" name="examBuildingId" onchange="this.form.submit()">
                        <option value="">Hamısı</option>
                        @foreach (var building in (SelectList)ViewBag.ExamBuildings)
                        {
                            var isSelected = ViewBag.SelectedExamBuildingId?.ToString() == building.Value;
                            <option value="@building.Value" selected="@(isSelected ? "selected" : null)">
                                @building.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="qab-filters__field">
                    <label class="qab-filters__label">
                        <i class="bi bi-calendar"></i> İl üzrə
                    </label>
                    <select class="form-select" name="year" onchange="this.form.submit()">
                        <option value="0">Hamısı</option>
                        @foreach (var y in (List<int>)ViewBag.Years)
                        {
                            <option value="@y" selected="@(ViewBag.SelectedYear == y ? "selected" : null)">@y</option>
                        }
                    </select>
                </div>
                <div>
                    <a class="qab-btn qab-btn--ghost qab-btn--sm" href="@Url.Action("Index")">
                        <i class="bi bi-x-circle"></i> Filtri təmizlə
                    </a>
                </div>
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="@(ViewBag.PageSize != null ? (int)ViewBag.PageSize : 20)" />
            </form>
        </div>
    </div>

    <!-- Top action bar -->
    <div class="qab-actionbar">
        <a class="qab-btn qab-btn--primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Yeni imtahan yarat
        </a>
    </div>

    <!-- Table -->
    <div class="qab-table-wrap">
        <table class="qab-table qab-table--compact">
            <colgroup>
                <col style="width:2.5rem">         <!-- # -->
                <col style="width:auto">           <!-- Ad -->
                <col style="width:6.5rem">         <!-- Tarix -->
                <col style="width:3.5rem">         <!-- İştirakçı -->
                <col style="width:9rem">           <!-- Vaxt -->
                <col style="width:5rem">           <!-- Kom. -->
                <col style="width:10rem">          <!-- Bina -->
                <col style="width:7rem">           <!-- İstiqamət -->
                <col style="width:7rem">           <!-- Əməliyyatlar -->
            </colgroup>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Adı</th>
                    <th>Tarix</th>
                    <th title="İştirakçı sayı"><i class="bi bi-people"></i></th>
                    <th>Vaxt</th>
                    <th>Kom.</th>
                    <th>Bina</th>
                    <th>İstiqamət</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="qab-col-num">@rowNumber</td>
                        <td>
                            <div class="qab-col-name">
                                <strong>@Html.DisplayFor(modelItem => item.Name)</strong>

                                @{
                                    // Bu imtahanda IsAttended != 1 olan ən azı bir ekspert qeydi varmı?

                                    // (yəni 0 və ya null — gələcəyini hələ təsdiqləməyib)

                                    var hasUnconfirmedExperts = item.ExamExpertSubProfessions != null

                                    && item.ExamExpertSubProfessions.Any(eesp => eesp.IsAttended != 1);
                                }
                                @if (hasUnconfirmedExperts)

                                {
                                    <span class="qab-attendance-dot"
                                          data-bs-toggle="tooltip"
                                          data-bs-placement="top"
                                          title="İmtahanda gələcəyini təsdiqləməyənlər var"
                                          aria-label="İmtahanda gələcəyini təsdiqləməyənlər var">
                                    </span>
                                }

                                <span class="qab-table__id">#@item.Id</span>
                            </div>
                        </td>
                        <td class="qab-col-date">@item.ExamDate.ToString("dd.MM.yy")</td>
                        <td>
                            <span class="qab-badge qab-badge--neutral">@item.StudentCount</span>
                        </td>
                        <td class="qab-col-time">
                            @if (item.StartTime.HasValue || item.EndTime.HasValue)
                            {
                                <span>@(item.StartTime?.ToString(@"hh\:mm") ?? "--")</span>
                                <span class="qab-time-sep">→</span>
                                <span>@(item.EndTime?.ToString(@"hh\:mm") ?? "--")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (item.ExamCommissions != null && item.ExamCommissions.Any())

                            {

                                var commissions = item.ExamCommissions.ToList();

                                var first = commissions.First();

                                var remaining = commissions.Skip(1).ToList();

                                <div class="qab-comm-preview">
                                    <span class="qab-badge qab-badge--primary">@first.Commission.CommissionNo</span>
                                    @if (remaining.Any())

                                    {
                                        <span class="qab-comm-more"
                                              data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              data-bs-html="true"
                                              title="@string.Join("<br/>", commissions.Select(c => $"{c.Commission.CommissionNo} — {c.Commission.Name}"))">
                                            +@remaining.Count
                                        </span>
                                    }
                                </div>
                            }

                            else

                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="qab-col-wrap">@item.ExamBuilding?.Name</td>
                        <td class="qab-col-wrap">@item.Section?.Name</td>
                        <td>
                            <div class="qab-table__actions">
                                <a class="qab-table__action-btn qab-table__action-btn--edit"
                                   asp-action="Edit" asp-route-id="@item.Id" title="Redaktə">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--view"
                                   asp-action="Details" asp-route-id="@item.Id" title="Detallar">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--delete"
                                   asp-action="Delete" asp-route-id="@item.Id" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @{
        int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
        int totalPages  = ViewBag.TotalPages  != null ? (int)ViewBag.TotalPages  : 1;
        int totalCount  = ViewBag.TotalCount  != null ? (int)ViewBag.TotalCount  : 0;
        int pageSize    = ViewBag.PageSize    != null ? (int)ViewBag.PageSize    : 20;
        int startItem   = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
        int endItem     = Math.Min(currentPage * pageSize, totalCount);

        var routeVals = new Dictionary<string, string?> {
            ["examBuildingId"] = ViewBag.SelectedExamBuildingId?.ToString(),
            ["year"]           = ViewBag.SelectedYear?.ToString(),
            ["pageSize"]       = pageSize.ToString()
        };

        int winStart = Math.Max(1, currentPage - 2);
        int winEnd   = Math.Min(totalPages, currentPage + 2);
    }

    @if (totalCount > 0)
    {
        <div style="display:flex;align-items:center;justify-content:space-between;
                    flex-wrap:wrap;gap:.75rem;margin-top:1rem;padding-top:.75rem;
                    border-top:1px solid var(--qab-border);">

            <span style="font-size:.85rem;color:var(--qab-text-muted);">
                <strong>@startItem–@endItem</strong> / <strong>@totalCount</strong> imtahan
            </span>

            <div style="display:flex;align-items:center;gap:.4rem;">
                <span style="font-size:.82rem;color:var(--qab-text-muted);">Səhifədə:</span>
                @foreach (var ps in new[] { 10, 20, 50, 100 })
                {
                    var psRoute = new Dictionary<string, string?>(routeVals) { ["pageSize"] = ps.ToString(), ["page"] = "1" };
                    <a href="@Url.Action("Index", psRoute)"
                       class="qab-btn qab-btn--sm @(pageSize == ps ? "qab-btn--primary" : "qab-btn--ghost")"
                       style="min-width:2.4rem;justify-content:center;">@ps</a>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav style="display:flex;align-items:center;gap:.25rem;">
                    @if (currentPage > 1)
                    {
                        <a href="@Url.Action("Index", new Dictionary<string, string?>(routeVals){ ["page"]="1" })"
                           class="qab-btn qab-btn--ghost qab-btn--sm" title="İlk">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                        <a href="@Url.Action("Index", new Dictionary<string, string?>(routeVals){ ["page"]=(currentPage-1).ToString() })"
                           class="qab-btn qab-btn--ghost qab-btn--sm" title="Əvvəlki">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    }

                    @if (winStart > 1)
                    {
                        <a href="@Url.Action("Index", new Dictionary<string, string?>(routeVals){ ["page"]="1" })"
                           class="qab-btn qab-btn--ghost qab-btn--sm">1</a>
                        @if (winStart > 2) { <span style="color:var(--qab-text-muted);padding:0 .2rem;">…</span> }
                    }

                    @for (int p = winStart; p <= winEnd; p++)
                    {
                        <a href="@Url.Action("Index", new Dictionary<string, string?>(routeVals){ ["page"]=p.ToString() })"
                           class="qab-btn qab-btn--sm @(p == currentPage ? "qab-btn--primary" : "qab-btn--ghost")"
                           style="min-width:2.4rem;justify-content:center;">@p</a>
                    }

                    @if (winEnd < totalPages)
                    {
                        @if (winEnd < totalPages - 1) { <span style="color:var(--qab-text-muted);padding:0 .2rem;">…</span> }
                        <a href="@Url.Action("Index", new Dictionary<string, string?>(routeVals){ ["page"]=totalPages.ToString() })"
                           class="qab-btn qab-btn--ghost qab-btn--sm">@totalPages</a>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a href="@Url.Action("Index", new Dictionary<string, string?>(routeVals){ ["page"]=(currentPage+1).ToString() })"
                           class="qab-btn qab-btn--ghost qab-btn--sm" title="Növbəti">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a href="@Url.Action("Index", new Dictionary<string, string?>(routeVals){ ["page"]=totalPages.ToString() })"
                           class="qab-btn qab-btn--ghost qab-btn--sm" title="Son">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    }
                </nav>
            }
        </div>
    }

    <!-- Bottom action bar (exports) -->
    <div class="qab-actionbar">
        <button class="qab-btn qab-btn--excel" data-bs-toggle="modal" data-bs-target="#exportModal">
            <i class="bi bi-table"></i> Maliyyə Exceli al
        </button>
        <a class="qab-btn qab-btn--excel" asp-action="ExportToExcel" asp-route-year="@ViewBag.SelectedYear">
            <i class="bi bi-file-earmark-excel"></i> Excel-ə çıxarış
        </a>
        <a class="qab-btn qab-btn--word" asp-action="ExportToWord" asp-route-year="@ViewBag.SelectedYear">
            <i class="bi bi-file-earmark-word"></i> Word-ə çıxarış
        </a>
        <a class="qab-btn qab-btn--word" asp-action="ExportToWordCalendar" asp-route-year="@ViewBag.SelectedYear">
            <i class="bi bi-calendar3"></i> Qabiliyyət təqvimi
        </a>
        <a class="qab-btn qab-btn--word" asp-action="ExportToWordForLetter" asp-route-year="@ViewBag.SelectedYear">
            <i class="bi bi-envelope"></i> Məktuba əlavə təqvim
        </a>
        <button class="qab-btn qab-btn--outline-primary" data-bs-toggle="modal" data-bs-target="#exportRangeModal">
            <i class="bi bi-cup-straw"></i> Maliyyə üçün yemək və su
        </button>
        <button class="qab-btn qab-btn--outline-primary" data-bs-toggle="modal" data-bs-target="#exportFoodWaterWordModal">
            <i class="bi bi-file-word"></i> Yemək və su hesabatı(Word)
        </button>
        <button class="qab-btn qab-btn--outline-primary" data-bs-toggle="modal" data-bs-target="#exportExcelModal">
            <i class="bi bi-file-spreadsheet"></i> Yemək və su hesabatı (Excel) 
        </button>
    </div>
</div>

<!-- Modals (functionality preserved as-is) -->
<div class="modal fade" id="exportFoodWaterWordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ExportExamsForFoodToWord" method="get">
                <div class="modal-header">
                    <h5 class="modal-title">Tarix aralığı və bina seçin (Sadə Word)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body qab-page">
                    <div class="mb-3">
                        <label for="startDateWord" class="form-label">Başlanğıc tarixi</label>
                        <input type="date" class="form-control" id="startDateWord" name="start" required />
                    </div>
                    <div class="mb-3">
                        <label for="endDateWord" class="form-label">Bitiş tarixi</label>
                        <input type="date" class="form-control" id="endDateWord" name="end" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="qab-btn qab-btn--ghost" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="qab-btn qab-btn--primary">Word Export et</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="exportExcelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ExportExamDataForFoodAndWater" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Tarix aralığı seçin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body qab-page">
                    <div class="mb-3">
                        <label for="startDate" class="form-label">Başlanğıc tarixi</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" required />
                    </div>
                    <div class="mb-3">
                        <label for="endDate" class="form-label">Bitiş tarixi</label>
                        <input type="date" class="form-control" id="endDate" name="endDate" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="qab-btn qab-btn--ghost" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="qab-btn qab-btn--primary">Excel Export et</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="exportRangeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ExportFoodAndWaterRange" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Tarix aralığı və bina seçin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body qab-page">
                    <div class="mb-3">
                        <label for="startDateRange" class="form-label">Başlanğıc tarixi</label>
                        <input type="date" class="form-control" id="startDateRange" name="startDate" required />
                    </div>
                    <div class="mb-3">
                        <label for="endDateRange" class="form-label">Bitiş tarixi</label>
                        <input type="date" class="form-control" id="endDateRange" name="endDate" required />
                    </div>
                    <div class="mb-3">
                        <label for="examBuildingIdRange" class="form-label">İmtahan binası</label>
                        <select class="form-select" id="examBuildingIdRange" name="examBuildingId" required>
                            <option value="" disabled selected>-- Binanı seçin --</option>
                            @if (ViewBag.ExamBuilding != null)
                            {
                                foreach (var b in (IEnumerable<dynamic>)ViewBag.ExamBuilding)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="qab-btn qab-btn--ghost" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="qab-btn qab-btn--primary">Export et</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- exportModal (Maliyyə Exceli) -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ExportExamData" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Tarix seçin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body qab-page">
                    <div class="mb-3">
                        <label for="selectedDate" class="form-label">İmtahan tarixi</label>
                        <input type="date" class="form-control" id="selectedDate" name="selectedDate" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="qab-btn qab-btn--ghost" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="qab-btn qab-btn--primary">Export et</button>
                </div>
            </form>
        </div>
    </div>
</div>


<style>
    /* İştirak təsdiqi olmayan imtahanlar üçün xəbərdarlıq nöqtəsi */
    .qab-attendance-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        margin: 0 .35rem;
        border-radius: 50%;
        background-color: #f59e0b; /* amber/warning */
        box-shadow: 0 0 0 2px rgba(245, 158, 11, .18);
        cursor: help;
        vertical-align: middle;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .qab-attendance-dot:hover {
            transform: scale(1.25);
            box-shadow: 0 0 0 3px rgba(245, 158, 11, .28);
        }
</style>
<style>
    /* Komissiya önizləmə - kompakt görünüş */
    .qab-comm-preview {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
    }

    .qab-comm-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 20px;
        padding: 0 .35rem;
        font-size: .72rem;
        font-weight: 600;
        color: var(--qab-primary, #0d6efd);
        background: rgba(13, 110, 253, .08);
        border: 1px solid rgba(13, 110, 253, .2);
        border-radius: 10px;
        cursor: help;
        transition: background .15s ease, transform .15s ease;
    }

        .qab-comm-more:hover {
            background: rgba(13, 110, 253, .15);
            transform: scale(1.08);
        }
</style>


@section Scripts {
    <script>
        // Bütün attendance-dot tooltip-lərini initialize et
        (function () {
            var triggers = document.querySelectorAll('.qab-attendance-dot[data-bs-toggle="tooltip"]');
            triggers.forEach(function (el) {
                // Bootstrap 5 tooltip
                new bootstrap.Tooltip(el);
            });
        })();
    </script>
    <script>
        (function () {
            // Bütün tooltip-ləri (attendance-dot + commission-more) initialize et
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                new bootstrap.Tooltip(el, {
                    html: el.hasAttribute('data-bs-html')   // yalnız data-bs-html="true" olanlar üçün HTML aktiv
                });
            });
        })();
    </script>
}
