@model IEnumerable<ForQab.DataAccess.Models.Exam>

@{
    ViewData["Title"] = "Exams Index";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h1 class="text-center mb-4 ">İmtahan idarəetməsi</h1>

    <div class="mb-4 d-flex justify-content-between">
        <div>
            <a class="btn btn-sm btn-secondary shadow-sm" asp-controller="District" asp-action="Index">
                <i class="bi bi-geo-alt"></i> Rayonlar
            </a>
            <a class="btn btn-sm btn-secondary shadow-sm" asp-controller="SubProfession" asp-action="Index">
                <i class="bi bi-briefcase"></i> İxtisaslar
            </a>
            <a class="btn btn-sm btn-secondary shadow-sm" asp-controller="ExamBuilding" asp-action="Index">
                <i class="bi bi-building"></i> İmtahan binaları
            </a>
            <a class="btn btn-sm btn-secondary shadow-sm" asp-controller="Subject" asp-action="Index">
                <i class="bi bi-book"></i> İmtahan fənləri
            </a>
            <a class="btn btn-sm btn-secondary shadow-sm" asp-controller="Commission" asp-action="Index">
                <i class="bi "></i> Komissiyalar
            </a>@if (ViewBag.Section == 1 || @ViewBag.Section == 2 || @ViewBag.Section == 5)
            {
                <a class="btn btn-sm btn-secondary shadow-sm" asp-controller="Federation" asp-action="Index">
                    <i class="bi "></i>Müəssisələr
                </a>
            }
            else
            {
                <a class="btn btn-sm btn-secondary shadow-sm" asp-controller="Federation" asp-action="Index">
                    <i class="bi "></i>Təhsil səviyyələri
                </a>
            }
            @if (ViewBag.Section == 2 || @ViewBag.Section == 5)
            {
                <a class="btn btn-sm btn-secondary shadow-sm" asp-action="Assesments">
                    <i class="bi bi-pen"></i> Qiymətləndirmələr
                </a>
                <a class="btn btn-sm btn-secondary shadow-sm" asp-action="Appeals">
                    <i class="bi bi-pen"></i> Apellyasiya
                </a>
            }
            

        </div>
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body p-3">
                <form method="get" asp-action="Index" class="row g-3 align-items-end">
                    <div class="col-md-5 col-lg-4">
                        <label for="examBuildingId" class="form-label fw-semibold">
                            <i class="bi bi-funnel-fill me-1 text-secondary"></i>İmtahan binasına görə filtrlə
                        </label>
                        <select class="form-select form-select-sm" id="examBuildingId" name="examBuildingId" onchange="this.form.submit()">
                            <option value="">Hamısı</option>
                            @foreach (var building in (SelectList)ViewBag.ExamBuildings)
                            {
                                var isSelected = ViewBag.SelectedExamBuildingId?.ToString() == building.Value;
                                <option value="@building.Value" selected="@(isSelected ? "selected" : null)">
                                    @building.Text
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-auto mt-2">
                        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index")">
                            <i class="bi bi-x-circle"></i> Filtri təmizlə
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div>
            <a class="btn btn-sm btn-success shadow-sm" asp-action="Create">
                <i class="bi bi-plus-circle"></i> Yeni imtahan yarat
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>ID</th>
                    <th>Adı</th>
                    <th>Tarix</th>
                    <th>İştirakçı sayı</th>
                    <th>Başlama vaxtı</th>
                    <th>Bitmə vaxtı</th>
                    <th>Komissiya</th>
                    <th>İmtahan binası</th>
                    <th>İstiqamət</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1;
                }
                @foreach (var item in Model)
                {
                    <tr class="align-middle">
                        <td>@rowNumber</td>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@item.ExamDate.ToString("dd/MM/yyyy")</td>
                        <td>@Html.DisplayFor(modelItem => item.StudentCount)</td>
                        <td>@Html.DisplayFor(modelItem => item.StartTime)</td>
                        <td>@Html.DisplayFor(modelItem => item.EndTime)</td>
                        <td>
                            @if (item.ExamCommissions != null && item.ExamCommissions.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var commission in item.ExamCommissions)
                                    {
                                        <li>@commission.Commission.CommissionNo</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>---</span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.ExamBuilding.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Section.Name)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a class="btn btn-outline-warning btn-sm p-1" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square" style="font-size: 0.75rem;"></i> Redaktə
                                </a>
                                <a class="btn btn-outline-info btn-sm p-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-eye" style="font-size: 0.75rem;"></i> Detallar
                                </a>
                                <a class="btn btn-outline-danger btn-sm p-1" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="bi bi-trash" style="font-size: 0.75rem;"></i> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>
        </table>
    </div>
    <div class="mb-4 text-end">
        <button class="btn btn-sm btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#exportModal">
            <i class="bi bi-table"></i> Maliyyə Exceli al
        </button>
        <a class="btn btn-sm btn-success shadow-sm" asp-action="ExportToExcel">
            <i class="bi bi-download"></i> Excel-ə çıxarış
        </a>
        <a class="btn btn-sm btn-primary shadow-sm" asp-action="ExportToWord">
            <i class="bi bi-download"></i> Word-ə çıxarış
        </a>
        <a class="btn btn-secondary px-4 py-2 mx-2" border: none;" asp-controller="Home" asp-action="Index">
            <i class="bi bi-home"></i> Ana səhifəyə qayıt
        </a>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exportModalLabel">Tarix seçin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="exportForm" asp-action="ExportExamData" method="post">
                    <div class="mb-3">
                        <label for="selectedDate" class="form-label">Tarix:</label>
                        <input type="date" id="selectedDate" name="selectedDate" class="form-control" value="@DateTime.Now.ToString("dd-MM-yyyy")" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                <button type="submit" form="exportForm" class="btn btn-primary">Excelə çıxar</button>
            </div>
        </div>
    </div>
</div>


@section Styles {
    <style>
        .container {
            max-width: 1500px;
        }

        .table-responsive {
            max-height: 600px; /* Yüksekliği ayarlayın */
            overflow-y: auto;
        }
        /* Table Styling */
        .table-bordered {
            border: 1px solid #dee2e6;
        }

            .table-bordered th, .table-bordered td {
                border: 1px solid #dee2e6;
            }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #f7f7f7;
        }

        .table-hover tbody tr:hover {
            background-color: #f1f1f1;
        }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
        }

        .table-light th {
            background-color: #f8f9fa;
            color: #495057;
        }

        /* Button Styling */
        .btn-group .btn {
            margin-right: 8px;
        }

        .btn:hover {
            transform: translateY(-2px);
            transition: transform 0.2s ease-in-out;
        }

        .btn-outline-warning {
            border-color: #ffc107;
            color: #ffc107;
        }

            .btn-outline-warning:hover {
                background-color: #ffc107;
                color: #fff;
            }

        .btn-outline-info {
            border-color: #17a2b8;
            color: #17a2b8;
        }

            .btn-outline-info:hover {
                background-color: #17a2b8;
                color: #fff;
            }

        .btn-outline-danger {
            border-color: #dc3545;
            color: #dc3545;
        }

            .btn-outline-danger:hover {
                background-color: #dc3545;
                color: #fff;
            }

        /* Header and Text Styles */
        .text-primary {
            color: #0d6efd !important;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 600;
            margin-bottom: 30px;
        }

        .shadow-sm {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }




        .btn-sm {
            padding: 0.25rem 1rem;
            font-size: 1rem;
        }

        .btn-outline-warning, .btn-outline-info, .btn-outline-danger {
            padding: 0.25rem 1rem;
            font-size: 1rem;
        }

        .btn-group .btn {
            font-size: 1rem;
        }

        .btn-sm i {
            font-size: 1rem;
        }

    </style>
}