@using ForQab.DataAccess.ViewModel.Exam
@model AssignMonitorsToExamViewModel

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4">
        <h2 class="mb-4 text-center text-dark fw-bold">İmtahana Nəzarətçi Təyin Et</h2>
        <h4 class="text-center text-muted">@ViewBag.ExamName</h4>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger text-center">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
        }

        <form asp-action="AssignMonitors" method="post">
            <input type="hidden" asp-for="ExamId" />
            <input type="hidden" asp-for="SectionId" />

            <div id="monitorContainer">
                <div class="monitor-form row mb-3 p-3 bg-light rounded-3 shadow-sm">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Cinsiyyət</label>
                        <select name="Assignments[0].GenderId" class="form-select">
                            <option value="0">Qadın</option>
                            <option value="1">Kişi</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Maksimum Tarix</label>
                        <input type="date" name="Assignments[0].MaxDate" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Nəzarətçi sayı</label>
                        <input type="number" name="Assignments[0].NumberOfMonitors" class="form-control" required />
                        <span asp-validation-for="Assignments[0].NumberOfMonitors" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-center gap-3">
                <button type="button" id="addMonitorBtn" class="btn btn-outline-success px-4 py-2">Yeni Nəzarətçi +</button>
                <button type="submit" class="btn btn-primary px-4 py-2">Nəzarətçi Təyin Et</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('addMonitorBtn').addEventListener('click', function () {
        var container = document.getElementById('monitorContainer');
        var forms = container.children;
        var newForm = container.firstElementChild.cloneNode(true);
        var newIndex = forms.length;

        Array.from(newForm.querySelectorAll('[name]')).forEach(function (input) {
            var name = input.getAttribute('name');
            if (name) {
                var updatedName = name.replace(/\[\d+\]/, `[${newIndex}]`);
                input.setAttribute('name', updatedName);
            }
            input.value = '';
        });

        container.appendChild(newForm);
    });
</script>
