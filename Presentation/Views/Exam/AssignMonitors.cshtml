@using ForQab.DataAccess.ViewModel.Exam
@model AssignMonitorsToExamViewModel

@{
    ViewData["Title"] = "Nəzarətçi təyin et";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-shield-check"></i></span>
                    Nəzarətçi təyin et
                </h1>
                <p class="qab-page-header__subtitle">İmtahan: <strong>@ViewBag.ExamName</strong></p>
            </div>
            <a class="qab-page-header__back" asp-action="Details" asp-route-id="@Model.ExamId">
                <i class="bi bi-arrow-left"></i> Geri
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="qab-alert qab-alert--danger">
            <i class="bi bi-exclamation-circle-fill"></i>
            <div>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="qab-alert qab-alert--danger">
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["ErrorMessage"]
        </div>
    }

    <form asp-action="AssignMonitors" method="post">
        <input type="hidden" asp-for="ExamId" />
        <input type="hidden" asp-for="SectionId" />

        <div id="monitorContainer">
            <div class="monitor-form qab-assign-row">

                @if (ViewBag.Section == 1)
                {
                    <div>
                        <label class="form-label">Cinsiyyət</label>
                        <select name="Assignments[0].GenderId" class="form-select">
                            <option value="">Seçin</option>
                            <option value="2">Qadın</option>
                            <option value="1">Kişi</option>
                        </select>
                    </div>
                }

                @if (ViewBag.Section == 1 || ViewBag.Section == 3 || ViewBag.Section == 4 || ViewBag.Section == 6)
                {
                    <div>
                        <label class="form-label">Məntəqə</label>
                        @if (Model.Rooms != null && Model.Rooms.Any())
                        {
                            <select name="Assignments[0].RoomId" class="form-select room-select">
                                <option value="">Seçin</option>
                                @foreach (var room in Model.Rooms)
                                {
                                    <option value="@room.Value">@room.Text</option>
                                }
                            </select>
                        }
                        else
                        {
                            <p class="text-muted" style="padding:.55rem 0;">Otaq yoxdur.</p>
                        }
                        <span asp-validation-for="Assignments[0].RoomId" class="text-danger"></span>
                    </div>
                }

                @if (ViewBag.Section == 3 || ViewBag.Section == 4 || ViewBag.Section == 6)
                {
                    <div>
                        <label class="form-label">İxtisas</label>
                        @if (Model.SubProfessions != null && Model.SubProfessions.Any())
                        {
                            <select name="Assignments[0].SubProfessionId" class="form-select">
                                <option value="">Seçin</option>
                                @foreach (var sp in Model.SubProfessions)
                                {
                                    <option value="@sp.Value">@sp.Text</option>
                                }
                            </select>
                        }
                        else
                        {
                            <p class="text-muted" style="padding:.55rem 0;">İxtisas yoxdur.</p>
                        }
                        <span asp-validation-for="Assignments[0].SubProfessionId" class="text-danger"></span>
                    </div>
                }

                <div>
                    <label class="form-label">Nəzarətçi sayı</label>
                    <input type="number" name="Assignments[0].NumberOfMonitors"
                           class="form-control" value="1" min="1" required />
                    <span asp-validation-for="Assignments[0].NumberOfMonitors" class="text-danger"></span>
                </div>

                @if (ViewBag.Section == 1)
                {
                    <div>
                        <label class="form-label">Maks. doğum tarixi</label>
                        <input type="date" name="Assignments[0].MaxDate" class="form-control" />
                    </div>

                    <div style="display:flex;align-items:center;gap:.5rem;padding-top:1.6rem;">
                        <input type="checkbox" name="Assignments[0].IsReserve"
                               id="isReserve0" class="reserve-checkbox"
                               style="width:16px;height:16px;" />
                        <label for="isReserve0" class="form-label" style="margin:0;">Ehtiyat</label>
                    </div>
                }
            </div>
        </div>

        <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin:.75rem 0 1.5rem;">
            <button type="button" id="addMonitorBtn" class="qab-btn qab-btn--outline-primary qab-btn--sm">
                <i class="bi bi-plus-circle"></i> Yeni sətir əlavə et
            </button>
        </div>

        <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
            <a asp-action="Details" asp-route-id="@Model.ExamId" class="qab-btn qab-btn--outline">
                <i class="bi bi-x-circle"></i> Ləğv et
            </a>
            <button type="submit" class="qab-btn qab-btn--primary">
                <i class="bi bi-check-circle"></i> Nəzarətçiləri təyin et
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".reserve-checkbox").forEach(function (cb) {
                cb.addEventListener("change", function () {
                    var roomSel = this.closest(".monitor-form").querySelector(".room-select");
                    if (roomSel) {
                        roomSel.disabled = this.checked;
                        if (this.checked) roomSel.value = "";
                    }
                });
            });
        });

        document.getElementById("addMonitorBtn").addEventListener("click", function () {
            var container = document.getElementById("monitorContainer");
            var forms = container.getElementsByClassName("monitor-form");
            var newForm = forms[0].cloneNode(true);
            var newIndex = forms.length;

            newForm.querySelectorAll("[name]").forEach(function (el) {
                el.name = el.name.replace(/\[0\]/, "[" + newIndex + "]");
                if (el.tagName === "INPUT") {
                    if (el.type === "number") el.value = "1";
                    else if (el.type === "checkbox") el.checked = false;
                    else el.value = "";
                }
                if (el.tagName === "SELECT") el.selectedIndex = 0;
                if (el.id) el.id = el.id.replace(/0$/, newIndex);
            });

            newForm.querySelectorAll("label[for]").forEach(function (lbl) {
                lbl.setAttribute("for", lbl.getAttribute("for").replace(/0$/, newIndex));
            });

            var removeBtn = document.createElement("button");
            removeBtn.type = "button";
            removeBtn.className = "qab-btn qab-btn--outline-danger qab-btn--sm remove-monitor-btn";
            removeBtn.innerHTML = '<i class="bi bi-trash"></i>';
            removeBtn.style.alignSelf = "end";
            newForm.appendChild(removeBtn);

            container.appendChild(newForm);
        });

        document.addEventListener("click", function (e) {
            if (e.target.closest(".remove-monitor-btn")) {
                e.target.closest(".monitor-form").remove();
            }
        });
    </script>
}
