@model ForQab.DataAccess.Models.Exam

@{
    ViewData["Title"] = "İmtahanı sil";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="qab-confirm">
                <div class="qab-confirm__header">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <h3>Silinməni təsdiqləyin</h3>
                </div>
                <div class="qab-confirm__body">
                    <p class="qab-confirm__lead">
                        Bu imtahanı silmək istədiyinizə <strong>əminsiniz?</strong><br>
                        <small class="text-muted">Bu əməliyyat geri qaytarıla bilməz.</small>
                    </p>

                    <dl class="qab-confirm__list">
                        <div class="qab-confirm__row">
                            <dt>İmtahan adı</dt>
                            <dd>@Model.Name</dd>
                        </div>
                        <div class="qab-confirm__row">
                            <dt>İmtahan tarixi</dt>
                            <dd>@Model.ExamDate.ToString("dd.MM.yyyy")</dd>
                        </div>
                        <div class="qab-confirm__row">
                            <dt>İmtahan binası</dt>
                            <dd>@(Model.ExamBuilding?.Name ?? "—")</dd>
                        </div>
                        <div class="qab-confirm__row">
                            <dt>İstiqamət</dt>
                            <dd>@(Model.Section?.Name ?? "—")</dd>
                        </div>
                    </dl>

                    <div class="qab-confirm__footer">
                        <a asp-action="Index" class="qab-btn qab-btn--outline qab-btn--lg">
                            <i class="bi bi-x-circle"></i> İmtina et
                        </a>
                        <form asp-action="Delete" method="post" style="margin:0;">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="qab-btn qab-btn--danger qab-btn--lg">
                                <i class="bi bi-trash"></i> Bəli, sil
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
