<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content qab-page">
            <div class="modal-header" style="background:var(--qab-danger-soft);border-bottom-color:rgba(220,38,38,.15);">
                <h5 class="modal-title" style="color:var(--qab-danger);">
                    <i class="bi bi-exclamation-triangle"></i> Silinməni təsdiqləyin
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"><p style="color:var(--qab-text);">Seçilmiş elementləri silmək istədiyinizə əminsiniz?</p></div>
            <div class="modal-footer">
                <button type="button" class="qab-btn qab-btn--ghost" data-bs-dismiss="modal">Ləğv et</button>
                <button type="button" class="qab-btn qab-btn--danger" id="confirmDeleteBtn">
                    <i class="bi bi-trash"></i> Bəli, sil
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let targetFormId = null;
        let targetActionName = null;

        document.querySelectorAll('[data-bs-target="#deleteConfirmationModal"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                targetFormId = this.getAttribute('data-form-id');
                targetActionName = this.getAttribute('data-action-name');
            });
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (!targetFormId) return;
            var form = document.getElementById(targetFormId);
            if (targetActionName) {
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'action';
                inp.value = targetActionName;
                form.appendChild(inp);
            }
            form.submit();
        });
    </script>
    <script>
        const SEED_KEY = 'forqab_seed_exam_@Model.Id';

        function seedVals() {
            return ['seedExp0', 'seedExp1', 'seedExp2'].map(id => document.getElementById(id).value.trim());
        }
        function seedReady() { return seedVals().every(v => v !== ''); }

        function onSeedInput() {
            var ready = seedReady();
            document.getElementById('assignExpertBtn').disabled = !ready;
            document.getElementById('verifyExpertBtn').disabled = !ready;
            try { localStorage.setItem(SEED_KEY, JSON.stringify(seedVals())); } catch (e) { }
        }

        (function restoreSeed() {
            var saved = null;

            // 1) Atama olunubsa DB-dəki real seed
            var dbSeed = @Html.Raw(ViewBag.LastExpertSeed != null ? Json.Serialize(ViewBag.LastExpertSeed) : "null");
            if (dbSeed && dbSeed.length === 3) saved = dbSeed;

            // 2) Yoxsa localStorage (yazıb hələ təyin etməmiş)
            if (!saved) {
                try { saved = JSON.parse(localStorage.getItem(SEED_KEY) || 'null'); } catch (e) { }
            }

            if (saved && saved.length === 3) {
                ['seedExp0', 'seedExp1', 'seedExp2'].forEach((id, i) => {
                    document.getElementById(id).value = saved[i];
                });
            }
            onSeedInput();
        })();

        function goAssignExperts(examId) {
            if (!seedReady()) return;
            var s = seedVals();
            window.location.href = `/Exam/AssignExperts/${examId}?s1=${s[0]}&s2=${s[1]}&s3=${s[2]}`;
        }

        async function verifyExpertSeed(examId) {
            if (!seedReady()) return;
            var s = seedVals();
            var box = document.getElementById('seedVerifyResult');
            box.innerHTML = 'Yoxlanılır...';
            try {
                var res = await fetch(`/Exam/VerifyAssignment?examId=${examId}&type=1&s1=${s[0]}&s2=${s[1]}&s3=${s[2]}`);
                var d = await res.json();
                if (!d.found) { box.innerHTML = `<span class="text-warning">${d.message}</span>`; return; }
                var ok = d.reproducible && d.matchesCurrent;
                box.innerHTML = `
                        <div class="text-muted">Təyin olunma vaxtı: ${d.assignedAt ?? '-'}</div>`;
            } catch (e) {
                box.innerHTML = '<span class="text-danger">Yoxlama zamanı xəta baş verdi.</span>';
            }
        }
    </script>
}