<!-- Modal -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmationModalLabel">Silməni Təsdiqləyin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Seçilmiş elementləri silmək istədiyinizə əminsiniz?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ləğv Et</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Sil</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        // Tümünü Seç fonksiyonu
        function toggleCheckboxes(name, checked) {
            var checkboxes = document.getElementsByName(name);
            for (var i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = checked;
            }
        }

        // Modal onay butonu işlevi
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            var modal = document.getElementById('deleteConfirmationModal');
            var button = modal.__triggerButton; // Modalı açan butonu al
            if (!button) {
                console.error('Tetikleyici buton bulunamadı!');
                return;
            }

            var formId = button.getAttribute('data-form-id'); // Hangi formun submit edileceğini al
            var form = document.getElementById(formId);

            if (form) {
                // action=delete parametresini manuel olarak ekle
                var actionInput = document.createElement('input');
                actionInput.type = 'hidden';
                actionInput.name = 'action';
                actionInput.value = 'delete';
                form.appendChild(actionInput);

                console.log('Form submit ediliyor:', formId);
                console.log('Form verileri:', new FormData(form));
                form.submit(); // Formu submit et
            } else {
                console.error('Form bulunamadı: ' + formId);
            }

            // Modal'ı kapat
            try {
                var bootstrapModal = bootstrap.Modal.getInstance(modal);
                if (bootstrapModal) {
                    bootstrapModal.hide();
                } else {
                    console.error('Bootstrap Modal nesnesi bulunamadı!');
                }
            } catch (e) {
                console.error('Modal kapatma hatası:', e);
            }
        });

        // Modal açıldığında tetikleyici butonu kaydet
        document.getElementById('deleteConfirmationModal').addEventListener('show.bs.modal', function (event) {
            console.log('Modal açılıyor, tetikleyici:', event.relatedTarget);
            this.__triggerButton = event.relatedTarget; // Modal'ı açan butonu kaydet
        });
    </script>
}

    <script>
        function changeExpert(examId, expertId) {
        console.log('changeExpert çağırıldı:', examId, expertId);
        const formData = new FormData();
        formData.append('examId', examId);
        formData.append('expertId', expertId);

            fetch('/Exam/ChangeExpert', {
                method: 'POST',
                body: formData
            })
                .then(async response => {
                    if (response.ok) {
                        window.location.href = '/Exam/Details?id=' + examId;
                    } else {
                        const errorText = await response.text();
                        console.error('Sunucudan hata:', errorText);
                        alert("Hata baş verdi: " + errorText);
                    }
                })
                .catch(error => {
                    console.error('İstek hatası:', error);
                    alert("Şəbəkə xətası: " + error.message);
                });

    }
</script>
<script>
    function toggleAttendanceLabel(expertId) {
        var checkbox = document.getElementById("attend_ " + expertId);
        var label = document.getElementById("attendLabel_" + expertId);
        if (checkbox.checked) {
            label.innerText = "Gələcək";
        } else {
            label.innerText = "Gəlməyəcək";
        }
    }
</script>


