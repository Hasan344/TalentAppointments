@model ForQab.Models.ViewModels.ExamDetailsViewModel

@{
    ViewData["Title"] = "İmtahan detalları";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="qab-alert qab-alert--success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="qab-alert qab-alert--danger">
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-journal-text"></i></span>
                    @Model.Name
                </h1>
                <p class="qab-page-header__subtitle">
                    @Model.ExamDate.ToString("dd MMMM yyyy") &middot; @Model.ExamBulding?.Name
                </p>
            </div>
            <a class="qab-page-header__back" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Siyahıya qayıt
            </a>
        </div>
    </div>

    <div class="qab-card" style="margin-bottom:1.5rem;">
        <div class="qab-card__header">
            <h2 class="qab-card__title"><i class="bi bi-info-circle"></i> İmtahan məlumatları</h2>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                <a class="qab-btn qab-btn--outline-warning qab-btn--sm" asp-action="Edit" asp-route-id="@Model.Id">
                    <i class="bi bi-pencil-square"></i> Redaktə
                </a>
                <form asp-action="ExportBadges" method="post" style="margin:0;">
                    <input type="hidden" name="examId" value="@Model.Id" />
                    <button type="submit" class="qab-btn qab-btn--word qab-btn--sm">
                        <i class="bi bi-person-badge"></i> Badge yüklə
                    </button>
                </form>
                <a class="qab-btn qab-btn--outline-danger qab-btn--sm" asp-action="Delete" asp-route-id="@Model.Id">
                    <i class="bi bi-trash"></i> Sil
                </a>
            </div>
        </div>
        <div class="qab-card__body">
            <div class="qab-details__grid">
                <div>
                    <div class="qab-details__row"><dt class="qab-details__label">Ad</dt><dd class="qab-details__value">@Model.Name</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">İstiqamət</dt><dd class="qab-details__value">@Model.Section?.Name</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Rayon</dt><dd class="qab-details__value">@Model.District?.Name</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">İmtahan binası</dt><dd class="qab-details__value">@Model.ExamBulding?.Name</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Tarix</dt><dd class="qab-details__value">@Model.ExamDate.ToString("dd.MM.yyyy")</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">İştirakçı sayı</dt><dd class="qab-details__value"><span class="qab-badge qab-badge--primary">@Model.StudentCount</span></dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Müddət</dt><dd class="qab-details__value">@Model.Duration saat</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Kişi buraxılış əməkdaş sayı</dt><dd class="qab-details__value">@Model.burK</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Qadın buraxılış əməkdaş sayı</dt><dd class="qab-details__value">@Model.burQ</dd></div>
                </div>
                <div>
                    <div class="qab-details__row"><dt class="qab-details__label">Buraxılış saatı</dt><dd class="qab-details__value">@Model.AdmissionTime</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Başlama</dt><dd class="qab-details__value">@Model.StartTime</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Bitmə</dt><dd class="qab-details__value">@Model.EndTime</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Su</dt><dd class="qab-details__value">@Model.Water</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Stəkan</dt><dd class="qab-details__value">@Model.Stekan</dd></div>
                    <div class="qab-details__row"><dt class="qab-details__label">Yemək</dt><dd class="qab-details__value">@Model.Food</dd></div>
                    <div class="qab-details__row">
                        <dt class="qab-details__label">Komissiyalar</dt>
                        <dd class="qab-details__value">@(Model.ExamCommissions?.Any() == true ? string.Join(", ", Model.ExamCommissions.Select(c => c.Commission.Name)) : "—")</dd>
                    </div>
                    <div class="qab-details__row">
                        <dt class="qab-details__label">Təhsil səviyyəsi</dt>
                        <dd class="qab-details__value">@(Model.ExamDegrees?.Any() == true ? string.Join(", ", Model.ExamDegrees.Select(d => d.Degree.Name)) : "—")</dd>
                    </div>
                    <div class="qab-details__row">
                        <dt class="qab-details__label">Fənlər</dt>
                        <dd class="qab-details__value">@(Model.ExamSubjects?.Any() == true ? string.Join(", ", Model.ExamSubjects.Select(s => s.Subject.Name)) : "—")</dd>
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div style="margin-top:1rem;padding:1rem;background:var(--qab-toolbar-bg);border-radius:10px;">
                    <strong style="font-size:.78rem;color:var(--qab-text-muted);text-transform:uppercase;letter-spacing:.04em;">Qeydlər</strong>
                    <p style="margin:.4rem 0 0;">@Model.Notes</p>
                </div>
            }
        </div>
    </div>

    @if (ViewBag.SectionId != null)
    {
            var experts = Model.Experts?.Where(m => m.Kons == false)
                .OrderBy(e => e.ExamExpertSubProfessions.FirstOrDefault()?.Name)
                .ThenBy(e => e.ExamExpertSubProfessions.FirstOrDefault()?.FederationName)
                .ToList();
        
        <div class="qab-section-block">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem;">
                <h3 class="qab-section-block__title" style="margin:0;"><i class="bi bi-mortarboard"></i> Ekspertlər</h3>
                <div class="qab-seed-gate text-center mt-4" style="max-width:560px;margin:0 auto;">
                    <label class="form-label fw-semibold d-block mb-2">
                        Random seed (3 rəqəm) — ekspert təyinatı üçün məcburidir
                    </label>
                    <div class="d-flex justify-content-center gap-2 mb-2">
                        <input type="number" id="seedExp0" class="form-control text-center" style="max-width:90px" oninput="onSeedInput()" />
                        <input type="number" id="seedExp1" class="form-control text-center" style="max-width:90px" oninput="onSeedInput()" />
                        <input type="number" id="seedExp2" class="form-control text-center" style="max-width:90px" oninput="onSeedInput()" />
                    </div>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <button type="button" id="assignExpertBtn" class="btn btn-primary px-4 py-2" disabled
                                onclick="goAssignExperts(@Model.Id)">
                            <i class="bi bi-person-plus"></i> Ekspert Təyin Et
                        </button>
                    </div>
                    <div id="seedVerifyResult" class="mt-2 small"></div>
                </div>
            </div>
            @if (experts?.Any() == true)
            {
                <form asp-action="ManageExperts" method="post" id="manageExpertsForm">
                    <input type="hidden" name="examId" value="@Model.Id" />
                    <label style="font-size:.85rem;color:var(--qab-text-muted);display:flex;align-items:center;gap:.4rem;margin-bottom:.5rem;">
                        <input type="checkbox" id="selectAllExperts" onchange="document.querySelectorAll('[name=expertIds]').forEach(cb=>cb.checked=this.checked)" />
                        Hamısını seç
                    </label>
                    <ul class="qab-list">
                        @for (int i = 0; i < experts.Count; i++)
                        {
                            var expert = experts[i];
                            var hasLog = Model.ExpertsWithLogs?.Contains(expert.Id) == true;
                            <li class="qab-list__item">
                                <div class="qab-list__check">
                                    <input type="checkbox" name="expertIds" value="@expert.Id" style="width:16px;height:16px;" />
                                </div>
                                <div class="qab-list__main">
                                    <p class="qab-list__name">
                                        @(i+1). @expert.Name @expert.Surname @expert.Fname
                                        @if (!string.IsNullOrEmpty(expert.Tel)) { <small class="text-muted">· @expert.Tel</small> }
                                    </p>
                                    <p class="qab-list__meta">
                                        FİN: @expert.FinCode
                                        @if (expert.ExamExpertSubProfessions?.Any() == true)
                                        {
                                            <span> · @string.Join(", ", expert.ExamExpertSubProfessions.Select(eesp => $"{eesp.Name} ({eesp.FederationName}) ({eesp.RoomName})"))</span>
                                        }
                                        @if (hasLog) { <span class="qab-badge qab-badge--warning ms-2"><i class="bi bi-exclamation-circle"></i> Qeydi var</span> }
                                    </p>
                                </div>
                                <div style="display:flex;flex-direction:column;align-items:center;gap:.2rem;min-width:60px;">
                                    <input type="hidden" name="updates[@i].ExpertId" value="@expert.Id" />
                                    <div class="form-check form-switch" style="margin:0;">
                                        <input class="form-check-input" type="checkbox"
                                               name="updates[@i].IsAttended" value="1"
                                               id="exp_attend_@expert.Id"
                                               @(expert.IsAttended.GetValueOrDefault() == 1 ? "checked" : "") />
                                        <label class="form-check-label" for="exp_attend_@expert.Id" style="font-size:.78rem;">Gələcək</label>
                                    </div>
                                </div>
                                <div class="qab-list__actions">
                                    <a class="qab-table__action-btn" title="Dəyişdir"
                                       asp-action="ChangeExpert" asp-route-examId="@Model.Id" asp-route-expertId="@expert.Id">
                                         <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="qab-table__action-btn" title="Qeyd yaz"
                                       asp-action="WriteExpertLog" asp-route-examId="@Model.Id" asp-route-expertId="@expert.Id">
                                         <i class="bi bi-chat"></i>
                                    </a>
                                    <a class="qab-table__action-btn qab-table__action-btn--view" title="Detallar"
                                       asp-action="ExpertDetails" asp-route-id="@expert.Id">
                                         <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                    <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem;">
                        <button type="button" class="qab-btn qab-btn--outline-danger qab-btn--sm"
                                data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal"
                                data-form-id="manageExpertsForm" data-action-name="delete">
                            <i class="bi bi-trash"></i> Seçilmişləri sil
                        </button>
                        <button type="submit" name="action" value="update" class="qab-btn qab-btn--outline-success qab-btn--sm">
                            <i class="bi bi-check-circle"></i> Gələnləri təsdiq et
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="qab-empty-state"><i class="bi bi-person-x" style="font-size:1.5rem;display:block;margin-bottom:.5rem;"></i> Ekspert təyin edilməyib.</div>
            }
        </div>
    }

    @if (ViewBag.SectionId == 3 || ViewBag.SectionId == 4 || ViewBag.SectionId == 6)
    {
            var kons = Model.Experts?.Where(m => m.Kons == true).ToList();
        
        <div class="qab-section-block">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem;">
                <h3 class="qab-section-block__title" style="margin:0;"><i class="bi bi-music-note-beamed"></i> Konsertmeysterlər</h3>
                <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                    <a class="qab-btn qab-btn--primary qab-btn--sm"
                       asp-action="AssignExpertsForMX" asp-controller="Exam" asp-route-examId="@Model.Id">
                        <i class="bi bi-person-plus"></i>  Konsertmeyster Təyin Et
                    </a>
                </div>
            </div>
            @if (kons?.Any() == true)
            {
                <form asp-action="DeleteExperts" method="post" id="deleteKonsForm">
                    <input type="hidden" name="examId" value="@Model.Id" />
                    <ul class="qab-list">
                        @{int konsCounter = 1;}
                        @foreach (var k in kons)
                        {
                            var hasLog = Model.ExpertsWithLogs?.Contains(k.Id) == true;
                            <li class="qab-list__item">
                                <div class="qab-list__check">
                                    <input type="checkbox" name="expertIds" value="@k.Id" style="width:16px;height:16px;" />
                                </div>
                                <div class="qab-list__main">
                                    <p class="qab-list__name">@konsCounter. @k.Name @k.Surname @k.Fname</p>
                                    <p class="qab-list__meta">
                                        FİN: @k.FinCode
                                        @if (hasLog) { <span class="qab-badge qab-badge--warning ms-2"><i class="bi bi-exclamation-circle"></i> Qeydi var</span> }
                                    </p>
                                </div>
                                <div class="qab-list__actions">
                                    <a class="qab-table__action-btn qab-table__action-btn--view" asp-action="ExpertDetails" asp-route-id="@k.Id"><i class="bi bi-eye"></i></a>
                                </div>
                            </li>
                            konsCounter++;
                        }
                    </ul>
                    <div style="margin-top:.75rem;">
                        <button type="button" class="qab-btn qab-btn--outline-danger qab-btn--sm"
                                data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal"
                                data-form-id="deleteKonsForm" data-action-name="delete">
                            <i class="bi bi-trash"></i> Seçilmişləri sil
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="qab-empty-state">Konsertmeyster təyin edilməyib.</div>
            }
        </div>
    }

    @{
        var monitors = Model.Monitors?.Where(m => m.Role == 2).OrderBy(m => m.RoomId).ToList();
    }
    <div class="qab-section-block">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem;">
            <h3 class="qab-section-block__title" style="margin:0;"><i class="bi bi-shield-check"></i> Nəzarətçilər</h3>
            <a class="qab-btn qab-btn--primary qab-btn--sm" asp-action="AssignMonitors" asp-route-id="@Model.Id">
                <i class="bi bi-person-plus"></i> Nəzarətçi təyin et
            </a>
        </div>
        @if (monitors?.Any() == true)
        {
            <form asp-action="ManageMonitors" method="post" id="manageMonitorsForm">
                <input type="hidden" name="examId" value="@Model.Id" />
                <label style="font-size:.85rem;color:var(--qab-text-muted);display:flex;align-items:center;gap:.4rem;margin-bottom:.5rem;">
                    <input type="checkbox" id="selectAllMonitors" onchange="document.querySelectorAll('[name=monitorIds]').forEach(cb=>cb.checked=this.checked)" />
                    Hamısını seç
                </label>
                <ul class="qab-list">
                    @for (int i = 0; i < monitors.Count; i++)
                    {
                        var monitor = monitors[i];
                        var hasLog = Model.MonitorsWithLogs?.Contains(monitor.Id) == true;
                        <li class="qab-list__item">
                            <div class="qab-list__check">
                                <input type="checkbox" name="monitorIds" value="@monitor.Id" style="width:16px;height:16px;" />
                            </div>
                            <div class="qab-list__main">
                                <p class="qab-list__name">
                                    @(i+1). @monitor.Name @monitor.Surname @monitor.Fname
                                    @if (!string.IsNullOrEmpty(monitor.Tel)) { <small class="text-muted">· @monitor.Tel</small> }
                                </p>
                                <p class="qab-list__meta">
                                    FİN: @monitor.FinCode
                                    @if (monitor.Rooms?.Any() == true)
                                    {
                                        <span> · <strong>Məntəqə:</strong> @string.Join(", ", monitor.Rooms.Select(r => r.RoomName))</span>
                                    }
                                    else { <span class="text-muted"> · Ehtiyat</span> }
                                    @if (hasLog) { <span class="qab-badge qab-badge--warning ms-2"><i class="bi bi-exclamation-circle"></i> Qeydi var</span> }
                                </p>
                            </div>
                            <div style="display:flex;flex-direction:column;align-items:center;gap:.2rem;min-width:60px;">
                                <input type="hidden" name="updates[@i].MonitorId" value="@monitor.Id" />
                                <div class="form-check form-switch" style="margin:0;">
                                    <input class="form-check-input" type="checkbox"
                                           name="updates[@i].IsAttended" value="1"
                                           id="mon_attend_@monitor.Id"
                                           @(monitor.IsAttended.GetValueOrDefault() == 1 ? "checked" : "") />
                                    <label class="form-check-label" for="mon_attend_@monitor.Id" style="font-size:.78rem;">Gələcək</label>
                                </div>
                            </div>
                            <div class="qab-list__actions">
                                <a class="qab-table__action-btn" title="Dəyişdir"
                                   asp-action="ChangeMonitor" asp-route-examId="@Model.Id" asp-route-monitorId="@monitor.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a class="qab-table__action-btn" title="Xüsusi qeyd yaz"
                                   asp-action="WriteMonitorLog" asp-route-examId="@Model.Id" asp-route-monitorId="@monitor.Id">
                                    <i class="bi bi-chat"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--view" title="Detallar"
                                   asp-action="MonitorDetails" asp-route-id="@monitor.Id">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </li>
                    }
                </ul>
                <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem;">
                    <button type="button" class="qab-btn qab-btn--outline-danger qab-btn--sm"
                            data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal"
                            data-form-id="manageMonitorsForm" data-action-name="delete">
                        <i class="bi bi-trash"></i> Seçilmişləri sil
                    </button>
                    <button type="submit" name="action" value="update" class="qab-btn qab-btn--outline-success qab-btn--sm">
                        <i class="bi bi-check-circle"></i> Gələnləri təsdiq et
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="qab-empty-state">Nəzarətçi təyin edilməyib.</div>
        }
    </div>

    @{
        var headMonitors = Model.Monitors?.Where(m => m.Role == 1).ToList();
    }
    <div class="qab-section-block">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem;">
            <h3 class="qab-section-block__title" style="margin:0;"><i class="bi bi-person-badge"></i> İmtahan rəhbərləri</h3>
            <a class="qab-btn qab-btn--primary qab-btn--sm" asp-action="AssignHeadMonitors" asp-route-id="@Model.Id">
                <i class="bi bi-person-plus"></i> Rəhbər təyin et
            </a>
        </div>
        @if (headMonitors?.Any() == true)
        {
            <form asp-action="DeleteHeadMonitors" method="post" id="deleteHeadMonitorsForm">
                <input type="hidden" name="examId" value="@Model.Id" />
                <label style="font-size:.85rem;color:var(--qab-text-muted);display:flex;align-items:center;gap:.4rem;margin-bottom:.5rem;">
                    <input type="checkbox" id="selectAllHeadMonitors" onchange="document.querySelectorAll('[name=headMonitorIds]').forEach(cb=>cb.checked=this.checked)" />
                    Hamısını seç
                </label>
                <ul class="qab-list">
                    @{int hmCounter=1;}
                    @foreach (var hm in headMonitors)
                    {
                        var hasLog = Model.MonitorsWithLogs?.Contains(hm.Id) == true;
                        <li class="qab-list__item">
                            <div class="qab-list__check">
                                <input type="checkbox" name="headMonitorIds" value="@hm.Id" style="width:16px;height:16px;" />
                            </div>
                            <div class="qab-list__main">
                                <p class="qab-list__name">@hmCounter. @hm.Name @hm.Surname @hm.Fname
                                    @if (!string.IsNullOrEmpty(hm.Tel)) { <small class="text-muted">· @hm.Tel</small> }
                                </p>
                                <p class="qab-list__meta">
                                    FİN: @hm.FinCode
                                    @if (hasLog) { <span class="qab-badge qab-badge--warning ms-2"><i class="bi bi-exclamation-circle"></i> Qeydi var</span> }
                                </p>
                            </div>
                            <div class="qab-list__actions">
                                <a class="qab-table__action-btn" title="Dəyişdir"
                                   asp-action="ChangeHeadMonitor" asp-route-examId="@Model.Id" asp-route-monitorId="@hm.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a class="qab-table__action-btn" title="Xüsusi qeyd yaz"
                                   asp-action="WriteMonitorLog" asp-route-examId="@Model.Id" asp-route-monitorId="@hm.Id">
                                    <i class="bi bi-chat"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--view" title="Detallar"
                                   asp-action="HeadMonitorDetails" asp-route-id="@hm.Id">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </li>
                        hmCounter++;
                    }
                </ul>
                <div style="margin-top:.75rem;">
                    <button type="button" class="qab-btn qab-btn--outline-danger qab-btn--sm"
                            data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal"
                            data-form-id="deleteHeadMonitorsForm" data-action-name="delete">
                        <i class="bi bi-trash"></i> Seçilmişləri sil
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="qab-empty-state">İmtahan rəhbəri təyin edilməyib.</div>
        }
    </div>

    @{
        var volunteers = Model.Monitors?.Where(m => m.Role == 4).ToList();
    }
    <div class="qab-section-block">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem;">
            <h3 class="qab-section-block__title" style="margin:0;"><i class="bi bi-heart"></i> Könüllülər</h3>
            @if (ViewBag.SectionId == 1)
            {
                <form asp-action="AssignVolunteers" asp-route-id="@Model.Id" method="post" style="margin:0;">
                    <button type="submit" class="qab-btn qab-btn--primary qab-btn--sm">
