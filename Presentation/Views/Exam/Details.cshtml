@model ForQab.Models.ViewModels.ExamDetailsViewModel



@{
    ViewData["Title"] = "İmtahan Detalları";
    string primaryColor = "#0056b3";
    string secondaryColor = "#6c757d";
}

<div class="container py-5" style="background-color: #ffffff; border: 1px solid #dee2e6; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
    <h1 class="text-center mb-4" style="color: @primaryColor; font-weight: bold;">İmtahan Detalları</h1>
    <hr class="mb-4" />

    <div class="row">
        <!-- Left Column -->
        <div class="col-md-6 mb-3">
            <dl class="row">
                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Ad:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.Name</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">İstiqamət:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.Section.Name</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Rayon:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.District.Name</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">İmtahan Binasi:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.ExamBulding.Name</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">İmtahan Tarixi:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.ExamDate.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">İştirakçı sayı:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.StudentCount nəfər</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Müddət:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.Duration saat</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Komissiya:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">
                    @if (Model.ExamCommissions != null && Model.ExamCommissions.Any())
                    {
                        @string.Join(", ", Model.ExamCommissions.Select(sp => sp.Commission.Name))
                    }
                    else
                    {
                        <span style="color: @secondaryColor;">---</span>
                    }
                </dd>

                @*               <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Sub-Komissiya:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.SubCommission?.Name</dd> *@
            </dl>
        </div>

        <!-- Right Column -->
        <div class="col-md-6">
            <dl class="row">


                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Su:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.Water ədəd</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Yemək:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.Food ədəd</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Buraxılış saatı:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.AdmissionTime</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Başlama saatı:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.StartTime</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Bitmə saatı:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.EndTime</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Qeydlər:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.Notes</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Nəqliyyat:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Model.InventoryTransport</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Təhsil səviyyələri:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">
                    @if (Model.ExamDegrees != null && Model.ExamDegrees.Any())
                    {
                        @string.Join(", ", Model.ExamDegrees.Select(sp => sp.Degree.Name))
                    }
                    else
                    {
                        <span style="color: @secondaryColor;">---</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <!-- Assigned Experts Section -->
    <div class="mt-4">
        <h4 class="text-center" style="color: @primaryColor; font-weight: bold;">Təyin Edilmiş Ekspertlər</h4>
        @{
            var experts = Model.Experts.Where(m => m.Kons == false).ToList();
        }
        @if (experts.Any())
        {
            <!-- Tek Form -->
            <form asp-action="ManageExperts" method="post" id="manageExpertsForm">
                <input type="hidden" name="examId" value="@Model.Id" />
                <div class="mb-3">
                    <input type="checkbox" id="selectAllExperts" onchange="toggleCheckboxes('expertIds', this.checked)" />
                    <label for="selectAllExperts" class="ml-2">Bütün Ekspertləri Seç</label>
                </div>

                <ul class="list-group list-group-flush">
                    @for (int i = 0; i < experts.Count(); i++)
                    {
                        var expert = experts[i];
                        var hasLog = Model.ExpertsWithLogs?.Contains(expert.Id) == true;
                        <li class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-md-1">
                                    <input type="checkbox" name="expertIds" value="@expert.Id" />
                                </div>
                                <div class="col-md-6">
                                    <h6 class="mb-0">@expert.Name @expert.Surname @expert.Fname @expert.Tel</h6>
                                    <small class="text-muted">FinCode: @expert.FinCode</small><br />
                                    <small class="text-muted">
                                        <strong>İxtisaslaşma:</strong>
                                        @if (expert.ExamExpertSubProfessions.Any())
                                        {
                                            @string.Join(", ", expert.ExamExpertSubProfessions
                                                     .Select(eesp => $"{eesp.Name} ({eesp.FederationName})({eesp.RoomName})"))
                                        }
                                        else
                                        {
                                            <span>--- (Təyin olunmayıb) ---</span>
                                        }
                                    </small>
                                    @if (hasLog)
                                    {
                                        <span class="badge ml-2" style="background-color: #ffc107; color: black;">Qeydi var</span>
                                    }
                                </div>
                                <div class="col-md-2 text-center">
                                    <input type="hidden" name="updates[@i].ExpertId" value="@expert.Id" />
                                    <div class="col-md-2 text-center">
                                    <input type="hidden" name="updates[@i].ExpertId" value="@expert.Id" />
                                    <div class="form-check form-switch">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="updates[@i].IsAttended"
                                               value="1"
                                               id="attend_@expert.Id"
                                               @(expert.IsAttended.GetValueOrDefault() == 1 ? "checked" : "") />
                                    </div>
                                </div>
                                </div>
                                <div class="col-md-3 text-md-right mt-2 mt-md-0">
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            onclick="changeExpert('@Model.Id', '@expert.Id')">
                                        <i class="bi bi-arrow-repeat"></i> Dəyiş
                                    </button>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="WriteExpertLog"
                                       asp-route-examId="@Model.Id"
                                       asp-route-expertId="@expert.Id">
                                        <i class="bi bi-chat"></i> Qeyd yaz
                                    </a>
                                    <a class="btn btn-sm btn-outline-info"
                                       asp-action="ExpertDetails"
                                       asp-route-id="@expert.Id">
                                        <i class="bi bi-eye"></i> Detallara bax
                                    </a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>

                <div class="text-center mt-3">
                    <!-- Silme Butonu -->
                    <button type="button" name="action" value="delete"
        class="btn btn-sm btn-outline-danger"
        data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal"
        data-form-id="manageExpertsForm">
    <i class="bi bi-trash"></i> Seçilmişləri Sil
</button>
                    <!-- Katılım Təsdiq Butonu -->
                    <button type="submit" name="action" value="update"
                            class="btn btn-outline-success px-4 py-2 mx-2">
                        <i class="bi bi-check-circle"></i> Gələnləri Təsdiq Et
                    </button>
                    <!-- Ekspert Təyin Et Butonu -->
                    <a class="btn btn-success px-4 py-2 mx-2"
                       style="background-color: @primaryColor; border: none;"
                       asp-action="AssignExperts" asp-route-id="@Model.Id">
                        <i class="bi bi-person-plus"></i> Ekspert Təyin Et
                    </a>
                </div>
            </form>
        }
        else
        {
            <p class="text-center" style="color: @secondaryColor;">Bu imtahana heç bir ekspert təyin edilməyib.</p>
            <div class="text-center mt-3">
                <a class="btn btn-success px-4 py-2 mx-2"
                   style="background-color: @primaryColor; border: none;"
                   asp-action="AssignExperts" asp-route-id="@Model.Id">
                    <i class="bi bi-person-plus"></i> Ekspert Təyin Et
                </a>
            </div>
        }
    </div>

    @if(ViewBag.SectionId == 3 || @ViewBag.SectionId == 4 || @ViewBag.SectionId == 6 )
    {
    <!-- Assigned Kons Section -->
    <div class="mt-4">
        <h4 class="text-center" style="color: @primaryColor; font-weight: bold;">Təyin Edilmiş Konsertmeysterlər</h4>
        @{
            var kons = Model.Experts.Where(m => m.Kons == true);
        }
        @if (kons.Any())
        {
            <form asp-action="DeleteExperts" method="post" id="deleteExpertsForm">
                <input type="hidden" name="examId" value="@Model.Id" />
                <div class="mb-3">
                    <input type="checkbox" id="selectAllExperts" onchange="toggleCheckboxes('expertIds', this.checked)" />
                    <label for="selectAllExperts" class="ml-2">Bütün Ekspertləri Seç</label>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var expert in kons)
                    {
                        var tel = expert.Tel;
                            if (!string.IsNullOrEmpty(tel) && tel.Length == 10)
                            {
                                tel = $"{tel.Substring(0, 3)}-{tel.Substring(3, 3)}-{tel.Substring(6, 2)}-{tel.Substring(8, 2)}";
                            }
                        var hasLog = Model.ExpertsWithLogs != null && Model.ExpertsWithLogs.Contains(expert.Id);
                        <li class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-md-1">
                                    <input type="checkbox" name="expertIds" value="@expert.Id" />
                                </div>
                                <div class="col-md-7">
                                    <h6 class="mb-0">
                                        @expert.Name @expert.Surname @expert.Fname @expert.Tel
                                    </h6>
                                    <small class="text-muted">
                                        FinCode: @expert.FinCode
                                    </small>
                                    <br />
                                    <small class="text-muted">
                                        <strong>İxtisaslaşma:</strong>
                                        @if (expert.ExamExpertSubProfessions.Any())
                                        {
                                            @string.Join(", ", expert.ExamExpertSubProfessions
                                                     .Select(eesp => $"{eesp.Name} ({eesp.FederationName})({eesp.RoomName})"))
                                        }
                                        else
                                        {
                                            <span>--- (Təyin olunmayıb) ---</span>
                                        }
                                    </small>
                                    @if (hasLog)
                                    {
                                        <span class="badge ml-2" style="background-color: #ffc107; color: black; padding: 5px 10px; border-radius: 5px;">Qeydi var</span>
                                    }
                                </div>
                                <div class="col-md-4 text-md-right mt-2 mt-md-0">
                                    <a class="btn btn-sm btn-outline-secondary mr-2" asp-action="ChangeExpert" asp-route-examId="@Model.Id" asp-route-expertId="@expert.Id">
                                        <i class="bi bi-pencil"></i> Dəyişdir
                                    </a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="WriteExpertLog" asp-route-examId="@Model.Id" asp-route-expertId="@expert.Id">
                                        <i class="bi bi-chat"></i> Xüsusi qeyd yaz
                                    </a>
                                    <a class="btn btn-sm btn-outline-info" asp-action="ExpertDetails" asp-route-id="@expert.Id">
                                        <i class="bi bi-eye"></i> Detallara Bax
                                    </a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal" data-form-id="deleteExpertsForm">
                        <i class="bi bi-trash"></i> Seçilmişləri Sil
                    </button>
                </div>
            </form>
        }
        else
        {
            <p class="text-center" style="color: @secondaryColor;">Bu imtahana heç bir ekspert təyin edilməyib.</p>
        }
    </div>
    }

    <!-- Assigned Monitors Section -->
    <div class="mt-4">
        <h4 class="text-center" style="color: @primaryColor; font-weight: bold;">Təyin Edilmiş Nəzarətçilər</h4>
        @{
            var monitors = Model.Monitors.Where(m => m.Role == 2);
        }
        @if (monitors.Any())
        {
            <form asp-action="DeleteMonitors" method="post" id="deleteMonitorsForm">
                <input type="hidden" name="examId" value="@Model.Id" />
                <div class="mb-3">
                    <input type="checkbox" id="selectAllMonitors" onchange="toggleCheckboxes('monitorIds', this.checked)" />
                    <label for="selectAllMonitors" class="ml-2">Bütün Nəzarətçiləri Seç</label>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var monitor in monitors)
                    {
                        var hasLog = ViewBag.MonitorsWithLogs != null && ViewBag.MonitorsWithLogs.Contains(monitor.Id);
                        <li class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-md-1">
                                    <input type="checkbox" name="monitorIds" value="@monitor.Id" />
                                </div>
                                <div class="col-md-7">
                                    <h6 class="mb-0">
                                        @monitor.Name @monitor.Surname @monitor.Fname @monitor.Tel
                                    </h6>
                                    <small class="text-muted">
                                        FinCode: @monitor.FinCode
                                    </small>
                                    <small class="text-muted">
                                        <strong>Məntəqə:</strong>
                                        @if (monitor.Rooms.Any())
                                        {
                                            @string.Join(", ", monitor.Rooms.Select(em => $"({em.RoomName})"))
                                        }
                                        else
                                        {
                                            <span>Ehtiyat Nəzarətçi</span>
                                        }
                                    </small>
                                    @if (hasLog)
                                    {
                                        <span class="badge ml-2" style="background-color: #ffc107; color: black; padding: 5px 10px; border-radius: 5px;">Qeydi var</span>
                                    }
                                </div>
                                <div class="col-md-4 text-md-right mt-2 mt-md-0">
                                    <a class="btn btn-sm btn-outline-secondary mr-2" asp-action="ChangeMonitor" asp-route-examId="@Model.Id" asp-route-monitorId="@monitor.Id">
                                        <i class="bi bi-pencil"></i> Dəyişdir
                                    </a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="WriteMonitorLog" asp-route-examId="@Model.Id" asp-route-monitorId="@monitor.Id">
                                        <i class="bi bi-chat"></i> Xüsusi qeyd yaz
                                    </a>
                                    <a class="btn btn-sm btn-outline-info" asp-action="MonitorDetails" asp-route-id="@monitor.Id">
                                        <i class="bi bi-eye"></i> Detallara Bax
                                    </a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal" data-form-id="deleteMonitorsForm">
                        <i class="bi bi-trash"></i> Seçilmişləri Sil
                    </button>
                    <a class="btn btn-primary px-4 py-2 mx-2" style="background-color: @primaryColor; border: none;" asp-action="AssignMonitors" asp-route-id="@Model.Id">
                        <i class="bi bi-person-plus"></i> Nəzarətçi Təyin Et
                    </a>
                </div>
            </form>
        }
        else
        {
            <p class="text-center" style="color: @secondaryColor;">Bu imtahana heç bir nəzarətçi təyin edilməyib.</p>
            <div class="text-center mt-4">
            <a class="btn btn-primary px-4 py-2 mx-2" style="background-color: @primaryColor; border: none;" asp-action="AssignMonitors" asp-route-id="@Model.Id">
                <i class="bi bi-person-plus"></i> Nəzarətçi Təyin Et
            </a>
            </div>
        }
    </div>

    <!-- Assigned Head Monitors Section -->
    <div class="mt-4">
        <h4 class="text-center" style="color: @primaryColor; font-weight: bold;">Təyin Edilmiş İmtahan rəhbərləri</h4>
        @{
            var headMonitors = Model.Monitors.Where(m => m.Role == 1);
        }
        @if (headMonitors.Any())
        {
            <form asp-action="DeleteHeadMonitors" method="post" id="deleteHeadMonitorsForm">
                <input type="hidden" name="examId" value="@Model.Id" />
                <div class="mb-3">
                    <input type="checkbox" id="selectAllHeadMonitors" onchange="toggleCheckboxes('monitorIds', this.checked)" />
                    <label for="selectAllHeadMonitors" class="ml-2">Bütün İmtahan Rəhbərlərini Seç</label>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var monitor in headMonitors)
                    {
                        var hasLog = ViewBag.MonitorsWithLogs != null && ViewBag.MonitorsWithLogs.Contains(monitor.Id);
                        <li class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-md-1">
                                    <input type="checkbox" name="monitorIds" value="@monitor.Id" />
                                </div>
                                <div class="col-md-7">
                                    <h6 class="mb-0">
                                        @monitor.Name @monitor.Surname @monitor.Fname @monitor.Tel
                                    </h6>
                                    <small class="text-muted">
                                        FinCode: @monitor.FinCode
                                    </small>
                                    @if (hasLog)
                                    {
                                        <span class="badge ml-2" style="background-color: #ffc107; color: black; padding: 5px 10px; border-radius: 5px;">Qeydi var</span>
                                    }
                                </div>
                                <div class="col-md-4 text-md-right mt-2 mt-md-0">
                                    <a class="btn btn-sm btn-outline-secondary mr-2" asp-action="ChangeHeadMonitor" asp-route-examId="@Model.Id" asp-route-monitorId="@monitor.Id">
                                        <i class="bi bi-pencil"></i> Dəyişdir
                                    </a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="WriteMonitorLog" asp-route-examId="@Model.Id" asp-route-monitorId="@monitor.Id">
                                        <i class="bi bi-chat"></i> Xüsusi qeyd yaz
                                    </a>
                                    <a class="btn btn-sm btn-outline-info" asp-action="HeadMonitorDetails" asp-route-id="@monitor.Id">
                                        <i class="bi bi-eye"></i> Detallara Bax
                                    </a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal" data-form-id="deleteHeadMonitorsForm">
                        <i class="bi bi-trash"></i> Seçilmişləri Sil
                    </button>
                    <a class="btn btn-primary px-4 py-2 mx-2" style="background-color: @primaryColor; border: none;" asp-action="AssignHeadMonitors" asp-route-id="@Model.Id">
                        <i class="bi bi-person-plus"></i> İmtahan rəhbəri Təyin Et
                    </a>
                </div>
            </form>
        }
        else
        {
            <div class="text-center mt-3">
            <p class="text-center" style="color: @secondaryColor;">Bu imtahana heç bir İmtahan rəhbəri təyin edilməyib.</p>
            <a class="btn btn-primary px-4 py-2 mx-2" style="background-color: @primaryColor; border: none;" asp-action="AssignHeadMonitors" asp-route-id="@Model.Id">
                <i class="bi bi-person-plus"></i> İmtahan rəhbəri Təyin Et
                </a>
            </div>
        }
    </div>
    @if(ViewBag.SectionId == 1)
    {
         <!-- Assigned Volunteers Section -->
    <div class="mt-4">
        <h4 class="text-center" style="color: @primaryColor; font-weight: bold;">Könüllülər</h4>
        @{
            var volunteers = Model.Monitors.Where(m => m.Role == 4);
        }
        @if (volunteers.Any())
        {
            <p class="text-center fw-semibold" style="color: #198754; font-size: 1.2rem; letter-spacing: 0.5px;">
                 <i class="fas fa-check-circle" style="color: #198754;"></i> Könüllülər təyin edilmişdir.
            </p>

        }
        else
        {
            <p class="text-center" style="color: @secondaryColor;">Bu imtahana heç bir könüllü təyin edilməyib.</p>
                <div class="text-center mt-4">
                    <form asp-action="AssignVolunteers" asp-route-id="@Model.Id" method="post" style="display: inline;">
                        <button type="submit" class="btn btn-success px-4 py-2 mx-2" style="background-color: @primaryColor; border: none;">
                        <i class="bi bi-person-plus"></i> Könüllü Təyin Et
                    </button>
                </form>
                </div>
        }
    </div>
    }
   

    <!-- Assigned Workers Section -->
    <div class="mt-4">
        <h4 class="text-center" style="color: @primaryColor; font-weight: bold;">Təyin Edilmiş İşçilər</h4>
        @{
            var workers = Model.Monitors.Where(m => m.Role == 5);
        }
        @if (workers.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var worker in workers)
                {
                    var hasLog = ViewBag.MonitorsWithLogs != null && ViewBag.MonitorsWithLogs.Contains(worker.Id);
                    <li class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-0">
