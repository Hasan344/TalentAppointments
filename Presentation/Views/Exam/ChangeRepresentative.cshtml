@model ForQab.DataAccess.ViewModel.Exam.ChangeRepresentativeViewModel

@{
    ViewData["Title"] = "Nümayəndə Dəyişdir";
}

<h2>Nümayəndə Dəyişdir</h2>

<form asp-action="ChangeRepresentative" method="post">
    <input type="hidden" asp-for="ExamId" />
    <input type="hidden" asp-for="CurrentRepresentativeId" />

    <div class="mb-3">
        <label for="newMonitorId" class="form-label">Yeni Nümayəndə Seçin:</label>
        <select asp-for="NewRepresentativeId" asp-items="Model.AvailableRepresentatives" class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-primary">Yadda Saxla</button>
    <a asp-action="Details" asp-route-id="@Model.ExamId" class="btn btn-secondary">İmtahana Qayıt</a>
</form>