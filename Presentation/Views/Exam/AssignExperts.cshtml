@using ForQab.DataAccess.ViewModel.Exam
@model AssignExpertToExamViewModel

<link rel="stylesheet" href="~/css/expert/Edit.css" asp-append-version="true" />
<h2>İmtahana ekspert təyin et : @ViewBag.ExamName</h2>


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form asp-action="AssignExperts" method="post" id="assignForm">
    <input type="hidden" asp-for="ExamId" />
    <input type="hidden" asp-for="SectionId" />

    <div id="expertContainer">
        <div class="expert-form">
            <div class="form-group">
                <label>Number of Experts</label>
                <input type="number" name="Assignments[0].NumberOfExperts" class="form-control" value="1" required />
                <span asp-validation-for="Assignments[0].NumberOfExperts" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Sub-Professions</label>
                <select name="Assignments[0].SelectedSubProfessions" class="form-select multiple-modern-select" multiple required>
                    @foreach (var sp in Model.SubProfessions)
                    {
                        <option value="@sp.Value">@sp.Text</option>
                    }
                </select>
                <span asp-validation-for="Assignments[0].SelectedSubProfessions" class="text-danger"></span>
            </div>
        </div>
    </div>

    <button type="button" id="addExpertBtn" class="btn btn-secondary">+</button>
    <button type="submit" class="btn btn-primary">Ekspert təyin et</button>
</form>

<script>
    document.getElementById('addExpertBtn').addEventListener('click', function () {
        var container = document.getElementById('expertContainer');
        var forms = container.children; // Mevcut form sayısını al
        var newForm = container.firstElementChild.cloneNode(true); // İlk formu klonla
        var newIndex = forms.length; // Yeni formun index'i

        // Yeni formdaki tüm input ve select alanlarının name attribute'larını güncelle
        Array.from(newForm.querySelectorAll('[name]')).forEach(function (input) {
            var name = input.getAttribute('name');
            if (name) {
                var updatedName = name.replace(/\[\d+\]/, `[${newIndex}]`);
                input.setAttribute('name', updatedName);
            }
            if (input.tagName === 'SELECT') {
                input.value = null; // Select içeriğini sıfırla
            } else {
                input.value = ''; // Input içeriğini sıfırla
            }
        });

        container.appendChild(newForm); // Yeni formu ekle
    });
</script>
