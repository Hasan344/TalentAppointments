@model ForQab.DataAccess.ViewModel.Exam.AssignExpertToExamViewModel

@{
    ViewData["Title"] = "Ekspert təyin et";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-mortarboard"></i></span>
                    Ekspert təyin et
                </h1>
                <p class="qab-page-header__subtitle">İmtahan: <strong>@ViewBag.ExamName</strong></p>
            </div>
            <a class="qab-page-header__back" asp-action="Details" asp-route-id="@Model.ExamId">
                <i class="bi bi-arrow-left"></i> Geri
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="qab-alert qab-alert--success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="qab-alert qab-alert--danger">
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["ErrorMessage"]
        </div>
    }

    <form asp-action="AssignExperts" method="post">
        <input type="hidden" name="ExamId" value="@Model.ExamId" />

        <div id="expertFormsContainer">
            <!-- İlk form sətri -->
            <div class="expert-form qab-assign-row">
                <div>
                    <label class="form-label">Ekspert sayı</label>
                    <input type="number" name="Assignments[0].NumberOfExperts" class="form-control" value="1" required min="1" />
                </div>

                @if (@ViewBag.Section == 2 || @ViewBag.Section == 5)
                {
                    <div>
                        <label class="form-label">Məntəqə</label>
                        @if (Model.Rooms != null && Model.Rooms.Any())
                        {
                            <select name="Assignments[0].RoomId" class="form-select room-dropdown room-select" required>
                                <option value="">Seçin</option>
                                @foreach (var room in Model.Rooms)
                                {
                                    <option value="@room.Value">@room.Text</option>
                                }
                            </select>
                        }
                        else
                        {
                            <p class="text-muted">Otaq yoxdur.</p>
                        }
                    </div>
                }
                else if (@ViewBag.Section == 3 || @ViewBag.Section == 4 || @ViewBag.Section == 6)
                {
                    <div>
                        <label class="form-label">İxtisas</label>
                        @if (Model.SubProfessions != null && Model.SubProfessions.Any())
                        {
                            <select name="Assignments[0].RoomId" class="form-select" required>
                                <option value="">Seçin</option>
                                @foreach (var sp in Model.SubProfessions)
                                {
                                    <option value="@sp.Value">@sp.Text</option>
                                }
                            </select>
                        }
                    </div>
                }
                else
                {
                    <div>
                        <label class="form-label">Təhsil müəssisəsi</label>
                        <select name="Assignments[0].FederationId" class="form-select federation-dropdown" required>
                            <option value="">Seçin</option>
                            @foreach (var federation in Model.Federations)
                            {
                                <option value="@federation.Value">@federation.Text</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Fənn</label>
                        <select name="Assignments[0].SelectedSubProfessions" class="form-select sub-profession-dropdown" required>
                            <option value="">Seçin</option>
                            @foreach (var sp in Model.SubProfessions)
                            {
                                <option value="@sp.Value">@sp.Text</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Məntəqə</label>
                        <select name="Assignments[0].RoomId" class="form-select room-dropdown" required>
                            <option value="">Seçin</option>
                            @foreach (var room in Model.Rooms)
                            {
                                <option value="@room.Value">@room.Text</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </div>

        <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin:.75rem 0 1.5rem;">
            <button type="button" id="addExpertBtn" class="qab-btn qab-btn--outline-primary qab-btn--sm">
                <i class="bi bi-plus-circle"></i> Sətir əlavə et
            </button>
        </div>

        <div style="display:flex;gap:.5rem;">
            <a asp-action="Details" asp-route-id="@Model.ExamId" class="qab-btn qab-btn--outline">
                <i class="bi bi-x-circle"></i> Ləğv et
            </a>
            <button type="submit" class="qab-btn qab-btn--primary">
                <i class="bi bi-check-circle"></i> Ekspertləri təyin et
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        var assignmentIndex = 1;

        document.getElementById('addExpertBtn').addEventListener('click', function () {
            var container = document.getElementById('expertFormsContainer');
            var firstForm = container.querySelector('.expert-form');
            var newForm = firstForm.cloneNode(true);

            // Update input names
            newForm.querySelectorAll('[name]').forEach(function (el) {
                el.name = el.name.replace('[0]', '[' + assignmentIndex + ']');
                if (el.tagName === 'INPUT') el.value = el.type === 'number' ? '1' : '';
                if (el.tagName === 'SELECT') el.selectedIndex = 0;
            });

            var removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'qab-btn qab-btn--outline-danger qab-btn--sm remove-expert-btn';
            removeBtn.innerHTML = '<i class="bi bi-trash"></i>';
            removeBtn.style.alignSelf = 'end';
            newForm.appendChild(removeBtn);

            container.appendChild(newForm);
            assignmentIndex++;
        });

        document.addEventListener('click', function (e) {
            if (e.target.closest('.remove-expert-btn')) {
                e.target.closest('.expert-form').remove();
            }
        });

        // Section 1: Sub-profession AJAX loading
        $(document).ready(function () {
            var section = @ViewBag.Section;
            if (section === 1) {
                $('select[name$="SelectedSubProfessions"]').hide();

                $(document).on('change', 'select[name$="FederationId"]', function () {
                    var federationId = $(this).val();
                    var subDrop = $(this).closest('.expert-form').find('select[name$="SelectedSubProfessions"]');

                    if (federationId) {
                        $.ajax({
                            url: '/Exam/GetSubProfessionsByFederation',
                            type: 'GET',
                            data: { federationId: federationId },
                            success: function (data) {
                                subDrop.empty();
                                if (data.length > 0) {
                                    data.forEach(function (item) {
                                        subDrop.append(new Option(item.name, item.id));
                                    });
                                    subDrop.show();
                                } else {
                                    subDrop.hide();
                                }
                            }
                        });
                    } else {
                        subDrop.empty().hide();
                    }
                });
            }
        });
    </script>
}
