@model ForQab.DataAccess.ViewModel.Exam.EditExamViewModelForAssesment

@{
    ViewData["Title"] = "Düzəliş";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="background-color: #2c2f33; border-radius: 10px; color: #ffffff;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="text-center mb-4">@ViewData["Title"]</h1>
            <hr style="border-color: #7289da;" />

            <form asp-action="EditForAppeal" method="post" class="p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">İmtahan adı</label>
                    <input asp-for="Name" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SectionId" class="form-label">İstiqamət</label>
                    <select asp-for="SectionId" class="form-select" asp-items="ViewBag.SectionList" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>İstiqamət seçin</option>
                    </select>
                    <span asp-validation-for="SectionId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DistrictId" class="form-label">Rayon</label>
                    <select asp-for="DistrictId" class="form-select" asp-items="ViewBag.DistrictList" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>Rayon Seçin</option>
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ExamBuldingId" class="form-label">İmtahan binası</label>
                    <select asp-for="ExamBuldingId" class="form-select" asp-items="ViewBag.ExamBuildingList" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>İmtahan binası seçin</option>
                    </select>
                    <span asp-validation-for="ExamBuldingId" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="ExamDate" class="form-label">İmtahan tarixi</label>
                    <input asp-for="ExamDate" class="form-control" type="date" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="ExamDate" class="text-danger"></span>
                </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Shift" class="form-label">Növbə</label>
                        <input asp-for="Shift" type="number" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                        <span asp-validation-for="Shift" class="text-danger"></span>
                    </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary" style="background-color: #2f3136; color: #ffffff;">Geri</a>
                    <button type="submit" class="btn btn-primary" style="background-color: #7289da; border-color: #7289da;">Yadda saxla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

    }


}