@using ForQab.DataAccess.ViewModel.Exam
@model AssignMonitorsToExamViewModel

<p>Bu imtahana Imtahan rəhbəri təyin et: @ViewBag.ExamName</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form asp-action="AssignHeadMonitors" method="post">
    <input type="hidden" asp-for="ExamId" />
    <input type="hidden" asp-for="SectionId" />
    <div class="form-group">
        <label asp-for="GenderId">Gender</label>
        <select asp-for="GenderId" class="form-control">
            <option value="0" selected="@(Model.GenderId == 0)">Qadın</option>
            <option value="1" selected="@(Model.GenderId == 1)">Kişi</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="MaxDate">Maksimum Tarix</label>
        <input asp-for="MaxDate" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NumberOfMonitors" class="control-label"></label>
        <input asp-for="NumberOfMonitors" class="form-control" />
        <span asp-validation-for="NumberOfMonitors" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Nəzarətçi təyin et</button>
</form>
