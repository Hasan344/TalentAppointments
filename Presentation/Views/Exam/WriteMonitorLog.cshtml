@model ForQab.DataAccess.ViewModel.Exam.WriteMonitorLogViewModel

@{
    ViewData["Title"] = "Xüsusi Qeyd Yaz";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="WriteMonitorLog" method="post">
    <input type="hidden" asp-for="ExamId" />
    <input type="hidden" asp-for="MonitorId" />

    <div class="form-group">
        <label asp-for="Note"></label>
        <textarea asp-for="Note" class="form-control"></textarea>
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Kind"></label>
        <select asp-for="Kind" asp-items="Model.KindOptions" class="form-control"></select>
        <span asp-validation-for="Kind" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Göndər</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}