@model IEnumerable<ForQab.DataAccess.Models.Exam>

@{
    ViewData["Title"] = "Qiymətləndirmələr";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-pen"></i></span>
                    Qiymətləndirmələr
                </h1>
                <p class="qab-page-header__subtitle">Qiymətləndirmə imtahanlarını idarə edin</p>
            </div>
            <a class="qab-page-header__back" asp-action="Index">
                <i class="bi bi-arrow-left"></i> İmtahanlara qayıt
            </a>
        </div>
    </div>

    <div class="qab-actionbar">
        <a class="qab-btn qab-btn--primary" asp-action="CreateForAssesment">
            <i class="bi bi-plus-circle"></i> Yeni qiymətləndirmə yarat
        </a>
    </div>

    <div class="qab-table-wrap">
        <div class="qab-table-scroll">
            <table class="qab-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>ID</th>
                        <th>Adı</th>
                        <th>Tarix</th>
                        <th>Başlama</th>
                        <th>Bitmə</th>
                        <th>Komissiya</th>
                        <th>İmtahan binası</th>
                        <th>İstiqamət</th>
                        <th class="text-end">Əməliyyatlar</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNumber = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@rowNumber</td>
                            <td><span class="qab-table__id">#@item.Id</span></td>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.ExamDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.StartTime</td>
                            <td>@item.EndTime</td>
                            <td>
                                @if (item.ExamCommissions != null && item.ExamCommissions.Any())
                                {
                                    <ul>
                                        @foreach (var commission in item.ExamCommissions)
                                        {
                                            <li>@commission.Commission.Name</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">---</span>
                                }
                            </td>
                            <td>@item.ExamBuilding?.Name</td>
                            <td>@item.Section?.Name</td>
                            <td>
                                <div class="qab-table__actions">
                                    <a class="qab-table__action-btn qab-table__action-btn--edit"
                                       asp-action="EditForAssesment" asp-route-id="@item.Id" title="Redaktə">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a class="qab-table__action-btn qab-table__action-btn--view"
                                       asp-action="DetailsOfAssesment" asp-route-id="@item.Id" title="Detallar">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="qab-table__action-btn qab-table__action-btn--delete"
                                       asp-action="Delete" asp-route-id="@item.Id" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        rowNumber++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
