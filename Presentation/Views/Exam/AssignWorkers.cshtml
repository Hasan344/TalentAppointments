@using ForQab.DataAccess.ViewModel.Exam
@model AssignWorkersToExamViewModel

@{
    ViewData["Title"] = "İşçi təyinatı";
}

<h2>İşçi təyinatı</h2>

<form asp-action="AssignWorkers" method="post">
    <input type="hidden" asp-for="ExamId" />

    <table class="table">
        <thead>
            <tr>
                <th>Seç</th>
                <th>Ad</th>
                <th>Soyad</th>
                <th>FinCode</th>
                <th>Təyinatı</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rep in Model.Assignments)
            {
                <tr>
                    <td>
                        <input type="checkbox" name="SelectedWorkerIds" value="@rep.Id" required />
                    </td>
                    <td>@rep.Name</td>
                    <td>@rep.Surname</td>
                    <td>@rep.FinCode</td>
                    <td>@rep.WorkerType</td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Atama Yap</button>
</form>






