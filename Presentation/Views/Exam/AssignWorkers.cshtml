<script>
    document.getElementById('addMonitorBtn').addEventListener('click', function () {
        var container = document.getElementById('monitorContainer');
        var forms = container.children;
        var newForm = container.firstElementChild.cloneNode(true);
        var newIndex = forms.length;

        Array.from(newForm.querySelectorAll('[name]')).forEach(function (input) {
            var name = input.getAttribute('name');
            if (name) {
                var updatedName = name.replace(/\[\d+\]/, `[${newIndex}]`);
                input.setAttribute('name', updatedName);
            }
            input.value = '';
        });

        container.appendChild(newForm);
    });
</script>
