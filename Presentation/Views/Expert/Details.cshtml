@model ForQab.DataAccess.Models.Expert

@{
    ViewData["Title"] = "Detallar";
    string primaryColor = "#0056b3"; // Official primary color
    string secondaryColor = "#6c757d"; // Official secondary color
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Left column: Photo -->
        <div class="col-lg-4 d-flex justify-content-center align-items-start">
            <div class="card shadow-sm border-0 rounded-4" style="width: 100%; max-width: 320px;">
                <div class="card-body text-center">
                    <div class="col-md-12 d-flex flex-column align-items-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.Photo))
                        {
                            <img src="@Model.Photo" class="img-fluid rounded-circle shadow mb-2" style="width: 200px; height: 200px; object-fit: cover;" alt="Ekspert Foto" />
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center bg-light rounded-circle shadow mb-2" style="width: 200px; height: 200px;">
                                <i class="bi bi-person-fill text-secondary" style="font-size: 4rem;"></i>
                            </div>
                        }
                    </div>


                    <h4 class="mb-1">@Model.Name @Model.Surname</h4>
                    <p class="text-muted mb-0">@Model.Fname</p>
                    <small class="text-secondary">@Model.Section?.Name</small>
                </div>
            </div>
        </div>

        <!-- Right column: Details -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h4 class="mb-4" style="color:@primaryColor;">Şəxsi Məlumatlar</h4>
                <div class="row mb-3">
                    <div class="col-sm-5 fw-semibold text-secondary">Doğum tarixi:</div>
                    <div class="col-sm-7">@Model.BirthDate?.ToString("dd.MM.yyyy")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 fw-semibold text-secondary">Fin Kodu:</div>
                    <div class="col-sm-7">@Model.FinCode</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 fw-semibold text-secondary">Seriya:</div>
                    <div class="col-sm-7">@Model.SerialPrefix</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 fw-semibold text-secondary">Seriya nömrəsi:</div>
                    <div class="col-sm-7">@Model.Serial</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 fw-semibold text-secondary">Telefon:</div>
                    <div class="col-sm-7">@Model.TelIs</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 fw-semibold text-secondary">Cinsi:</div>
                    <div class="col-sm-7">@Model.GenderNavigation?.Name</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 fw-semibold text-secondary">Müəssisə - Təhsil səviyyəsi:</div>
                    <div class="col-sm-7">@Model.FederationNavigation?.Name</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 fw-semibold text-secondary">İxtisaslar:</div>
                    <div class="col-sm-7">
                        @if (Model.ExpertsProfessions != null && Model.ExpertsProfessions.Any())
                        {
                            @string.Join(", ", Model.ExpertsProfessions.Select(p => p.SubProfession?.Name))
                        }
                        else
                        {
                            <span class="text-muted">---</span>
                        }
                    </div>
                </div>

                <hr class="my-4" />

                <h4 class="mb-4" style="color:@primaryColor;">Bank Məlumatları</h4>
                @{
                    var bankInfos = new (string, string)[]
                    {
                         ("Rekvizit", Model.Rekvizit),
                         ("Bank filialı", Model.BankFilial),
                         ("Bank filial kodu", Model.BankFilialCode),
                         ("Hesablaşma hesabı", Model.HesablashmaH),
                         ("VÖEN", Model.Voen),
                         ("SSN", Model.SSN)
                    };

                    foreach (var item in bankInfos)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-5 fw-semibold text-secondary">@item.Item1:</div>
                            <div class="col-sm-7">@item.Item2</div>
                        </div>
                    }
                }
                @{
                    var latestContract = Model.Contracts
                    .OrderByDescending(c => c.Id)
                    .FirstOrDefault();
                }

                <hr class="my-4" /><div class="col-lg-8">
                    <div class="card shadow-sm border-0 rounded-4 p-4">
                        <h4 class="mb-4" style="color:@primaryColor;">Digər Məlumatlar</h4>
                        <div class="row mb-3">
                            <div class="col-sm-5 fw-semibold text-secondary">İmtahanlarda iştirak sayı:</div>
                            <div class="col-sm-7">@Model.ComputedAssignmentCount</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 fw-semibold text-secondary">Müqavilə tarixi:</div>
                            <div class="col-sm-7">@latestContract?.Date.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 fw-semibold text-secondary">Müqavilə nömrəsi:</div>
                            <div class="col-sm-7">@latestContract?.Number</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 fw-semibold text-secondary">Rayon:</div>
                            <div class="col-sm-7">@Model.DistrictNavigation?.Name</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 fw-semibold text-secondary">İş yerində vəzifəsi:</div>
                            <div class="col-sm-7">@Model.Profession</div>
                        </div>

                        <hr class="my-4" />



                        <div class="row mb-3">
                            <div class="col-sm-5 fw-semibold text-danger">Arxivlənmə səbəbi:</div>
                            <div class="col-sm-7 text-danger">@Model.ArchiveReason</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 fw-semibold text-danger">Çağırılmama səbəbi:</div>
                            <div class="col-sm-7 text-danger">@Model.StatusReason</div>
                        </div>

                        <div class="text-center mt-4">
                            <a class="btn btn-outline-primary me-3" asp-action="Edit" asp-route-id="@Model.Id">
                                <i class="bi bi-pencil-square me-1"></i> Düzəliş et
                            </a>
                        <a class="btn btn-outline-danger me-3" asp-action="Delete" asp-route-id="@Model.Id">
                            <i class="bi bi me-1"></i> Sil və ya Arxivlə
                        </a>
                            <a class="btn btn-outline-secondary me-3" asp-action="Index">
                                <i class="bi bi-list-ul me-1"></i> Siyahıya qayıt
                            </a>
                            <hr />
                            <a class="btn btn-outline-info" asp-action="ExpertLog" asp-route-expertId="@Model.Id">
                                <i class="bi bi-journal-text me-1"></i> Qeydlər
                            </a>
                        </div>

                        <div class="text-center mt-3">
                            <button class="btn btn-outline-danger me-2" data-bs-toggle="modal" data-bs-target="#statusReasonModal">
                                <i class="bi bi-x-circle me-1"></i> Çağırıla bilməz
                            </button>

                            <form asp-action="RestoreStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-success">
                                    <i class="bi bi-check-circle me-1"></i> Çağırıla bilər
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- İştirak etdiyi imtahanlar -->
        <div class="card shadow-sm border-0 rounded-4 mt-5 p-4">
            <h4 class="mb-3" style="color:@primaryColor;">Ekspertin iştirak etdiyi imtahanlar</h4>
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>İmtahan ID</th>
                        <th>Tarix</th>
                        <th>Zal</th>
                        <th>Başlama</th>
                        <th>Bitmə</th>
                        <th>İxtisas</th>
                        <th>İştirak statusu</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ExamExpertSubProfessions)
                    {
                        <tr>
                            <td>@item.Exam.Id</td>
                            <td>@item.Exam.ExamDate.ToString("dd.MM.yyyy")</td>
                            <td>@item.ExamRoom?.Name</td>
                            <td>@item.Exam.StartTime</td>
                            <td>@item.Exam.EndTime</td>
                            <td>@item.SubProfession?.Name</td>
                            <td>
                                @{
                                    var expertLog = item.Expert.ExpertLogs
                                    .FirstOrDefault(log => log.ExamId == item.Exam.Id); // ExamId ilə uyğun log tapılır

                                    string statusText;
                                    if (expertLog == null)
                                    {
                                        statusText = "İştirak etdi";
                                    }
                                    else if (expertLog.Kind == 0)
                                    {
                                        statusText = "Gəlmədi";
                                    }
                                    else
                                    {
                                        statusText = "Qeydi var";
                                    }
                                }
                                @statusText
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-info" asp-controller="Exam" asp-action="Details" asp-route-id="@item.Exam.Id">
                                    Detallar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


        <!-- Modal (Pop-up) -->
        <div class="modal fade" id="statusReasonModal" tabindex="-1" aria-labelledby="statusReasonModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="statusReasonModalLabel">Status Dəyişmə Səbəbi</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="changeStatusForm" asp-action="ChangeStatus" method="post">
                        <div class="modal-body">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label for="statusReason" class="form-label">Səbəb</label>
                                <textarea class="form-control" id="statusReason" name="statusReason" rows="3" required></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                            <button type="submit" class="btn btn-danger">Təsdiqlə</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#changeStatusForm").submit(function (event) {
                event.preventDefault();

                var formData = $(this).serialize();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("ChangeStatus")",
                    data: formData,
                    success: function (response) {
                        alert("Status uğurla dəyişdirildi!");
                        var modal = $("#statusReasonModal");
                        modal.modal("hide");

                        modal.on("hidden.bs.modal", function () {
                            $("body").removeClass("modal-open");
                            $(".modal-backdrop").remove();
                        });
                    },
                    error: function () {
                        alert("Xəta baş verdi, yenidən cəhd edin.");
                    }
                });
            });
        });
    </script>
