@using ForQab.DataAccess.Models
@model IEnumerable<ForQab.DataAccess.Models.Expert>

@{
    ViewData["Title"] = "Ekspertlər Index";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
@if (TempData["ImportError"] != null)
{
    <div class="alert alert-danger">
        @TempData["ImportError"]
    </div>
}


<div class="container mt-5">
    <!-- Page Title -->
    <h1 class="text-center mb-4">Ekspertlər İdarəetməsi</h1>

    <!-- Create New Expert Button -->
    <div class="mb-4 text-end">
        <a class="btn btn-sm btn-success shadow-sm" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Yenisini yarat
        </a>
        <a class="btn btn-sm btn-primary shadow-sm" asp-action="ExportToExcel">
            <i class="bi bi-file-earmark-excel"></i> Excel-ə çıxarış
        </a>
        <a class="btn btn-outline-secondary" asp-action="Archived"><i class="bi bi-archive"></i> Arxiv</a>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exportModal">
            <i class="bi bi-file-earmark-word"></i> Müqavilə Export
        </button>
        @{
            var selectedFederationId = ViewContext.HttpContext.Request.Query["federationId"].ToString();
            var selectedSubProfessionId = ViewContext.HttpContext.Request.Query["subProfessionId"].ToString();
        }
        <!-- Export Modal -->
        <div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exportModalLabel">Müqavilə Export</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-action="ExportContracts">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="contractDate" class="form-label">Müqavilə Tarixi</label>
                                <input type="date" id="contractDate" name="contractDate" class="form-control" required />
                            </div>
                            <p>Seçdiyiniz ekspertlərin müqavilələri export ediləcək:</p>
                            <div class="table-responsive" style="max-height:200px; overflow:auto;">
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th><input type="checkbox" id="selectAll" /></th>
                                            <th>Ad</th>
                                            <th>Soyad</th>
                                            <th>FİN Kodu</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="selectedExpertIds" value="@item.Id" class="select-item" />
                                                </td>
                                                <td>@item.Name</td>
                                                <td>@item.Surname</td>
                                                <td>@item.FinCode</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                            <button type="submit" class="btn btn-primary">Export et</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Search by Name -->
            <input type="text" name="searchName"
                   value="@ViewContext.HttpContext.Request.Query["searchName"]"
                   class="form-control"
                   placeholder="Ad və ya soyad üzrə axtar..."
                   style="max-width: 250px;" />

            <!-- Gender Dropdown -->
            <select name="genderId" class="form-control" style="max-width: 200px;">
                <option value="">Cins seçin</option>
                @foreach (var gender in ViewBag.Genders)
                {
                    if (gender.Id.ToString() == ViewContext.HttpContext.Request.Query["genderId"])
                    {
                        <option value="@gender.Id" selected>@gender.Name</option>
                    }
                    else
                    {
                        <option value="@gender.Id">@gender.Name</option>
                    }
                }
                <!-- Search by FinCode -->
                <input type="text" name="finCode"
                       value="@ViewContext.HttpContext.Request.Query["finCode"]"
                       class="form-control"
                       placeholder="FİN Kod üzrə axtar..."
                       style="max-width: 200px;" />

                <!-- Search by Serial -->
                <input type="text" name="serial"
                       value="@ViewContext.HttpContext.Request.Query["serial"]"
                       class="form-control"
                       placeholder="Seriya üzrə axtar..."
                       style="max-width: 200px;" />
            </select>
            <!-- District Dropdown -->
            <select name="district" class="form-control" style="max-width: 200px;">
                <option value="">Rayon seçin</option>
                @foreach (var district in ViewBag.Districts)
                {
                    if (district.Id.ToString() == ViewContext.HttpContext.Request.Query["district"])
                    {
                        <option value="@district.Id" selected>@district.Name</option>
                    }
                    else
                    {
                        <option value="@district.Id">@district.Name</option>
                    }
                }
            </select>
            <!-- Start Year -->
            <input type="number" name="startYear" value="@ViewContext.HttpContext.Request.Query["startYear"]" class="form-control" style="max-width: 120px;" placeholder="Başlanğıc il" />

            <!-- End Year -->
            <input type="number" name="endYear" value="@ViewContext.HttpContext.Request.Query["endYear"]" class="form-control" style="max-width: 120px;" placeholder="Son il" />

            <select id="federationSelect" name="federationId" class="form-control" style="max-width: 200px;">
                <option value="">Müəssisə və ya təhsil səviyyəsi seçin</option>
                @foreach (var federation in ViewBag.Federation)
                {
                    if (federation.Id.ToString() == selectedFederationId)
                    {
                        <option value="@federation.Id" selected>@federation.Name</option>
                    }
                    else
                    {
                        <option value="@federation.Id">@federation.Name</option>
                    }
                }
            </select>

            <select id="subProfessionSelect" name="subProfessionId" class="form-control" style="max-width: 200px;" @(ViewBag.SubProfessions == null || ((List<SubProfession>)ViewBag.SubProfessions).Count == 0 ? "disabled" : "")>
                <option value="">İxtisas seçin</option>
                @foreach (var subProfession in ViewBag.SubProfessions)
                {
                    if (subProfession.Id.ToString() == selectedSubProfessionId)
                    {
                        <option value="@subProfession.Id" selected>@subProfession.Name</option>
                    }
                    else
                    {
                        <option value="@subProfession.Id">@subProfession.Name</option>
                    }
                }
            </select>




            <!-- Submit Button -->
            <button type="submit" class="btn btn-outline-primary">Axtar</button>
            <a href="@Url.Action("Index", "Expert")" class="btn btn-outline-secondary">Sıfırla</a>
        </form>
    </div>

    <!-- Table with Bordered and Modern Design -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Ata adı</th>
                    <th>Fin Kod</th>
                    <th>Təvəllüd</th>
                    <th>İstiqamət</th>
                    <th>Müəssisə - Təhsil səviyyəsi</th>
                    <th>İxtisas</th>
                    <th>İştirak sayı</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1;
                }
                @foreach (var item in Model)
                {
                    <tr class="align-middle @(item.Status == 1 ? "table-danger" : "")">
                        <td>@rowNumber</td> <!-- Sıra Numarası -->
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Surname)</td>
                        <td>@Html.DisplayFor(modelItem => item.Fname)</td>
                        <td>@Html.DisplayFor(modelItem => item.FinCode)</td>
                        <td>@Html.DisplayFor(modelItem => item.BirthDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.Section.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.FederationNavigation.Name)</td>
                        <td>
                            @if (item.ExpertsProfessions != null && item.ExpertsProfessions.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var subProfession in item.ExpertsProfessions)
                                    {
                                        <li>@subProfession.SubProfession.Name</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>---</span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.ComputedAssignmentCount)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a class="btn btn-outline-warning btn-sm p-1" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square" style="font-size: 0.75rem;"></i> Redaktə
                                </a>
                                <a class="btn btn-outline-info btn-sm p-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-eye" style="font-size: 0.75rem;"></i> Detallar
                                </a>
                                <a class="btn btn-outline-danger btn-sm p-1" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="bi bi-trash" style="font-size: 0.75rem;"></i> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>

        </table>
    </div>
</div>

@section Styles {
    <style>
        .table-responsive {
            max-height: 600px; /* Yüksekliği ayarlayın */
            overflow-y: auto;
        }

        .container {
            max-width: 1200px;
        }

        /* Table Styling */
        .table-bordered {
            border: 1px solid #dee2e6;
        }

            .table-bordered th, .table-bordered td {
                border: 1px solid #dee2e6;
            }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #f7f7f7;
        }

        .table-hover tbody tr:hover {
            background-color: #f1f1f1;
        }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
        }

        .table-light th {
            background-color: #f8f9fa;
            color: #495057;
        }

        /* Button Styling */
        .btn-group .btn {
            margin-right: 8px;
        }

        .btn:hover {
            transform: translateY(-2px);
            transition: transform 0.2s ease-in-out;
        }

        .btn-outline-warning {
            border-color: #ffc107;
            color: #ffc107;
        }

            .btn-outline-warning:hover {
                background-color: #ffc107;
                color: #fff;
            }

        .btn-outline-info {
            border-color: #17a2b8;
            color: #17a2b8;
        }

            .btn-outline-info:hover {
                background-color: #17a2b8;
                color: #fff;
            }

        .btn-outline-danger {
            border-color: #dc3545;
            color: #dc3545;
        }

            .btn-outline-danger:hover {
                background-color: #dc3545;
                color: #fff;
            }

        /* Header and Text Styles */
        .text-primary {
            color: #0d6efd !important;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 600;
            margin-bottom: 30px;
        }

        .shadow-sm {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .btn-sm {
            padding: 0.25rem 1rem;
            font-size: 1rem;
        }

        .btn-outline-warning, .btn-outline-info, .btn-outline-danger {
            padding: 0.25rem 1rem;
            font-size: 1rem;
        }

        .btn-group .btn {
            font-size: 1rem;
        }

        .btn-sm i {
            font-size: 1rem;
        }

    </style>
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        var federationSelect = $('#federationSelect');
        var subProfessionDropdown = $('#subProfessionSelect');
        var selectedSubProfessionId = '@selectedSubProfessionId';

        function loadSubProfessions(federationId, selectedId) {
            subProfessionDropdown.empty();
            subProfessionDropdown.append(new Option("Yüklənir...", ""));
            subProfessionDropdown.prop('disabled', true);

            if (federationId) {
                $.ajax({
                    url: '/Expert/GetSubProfessionsByFederation',
                    type: 'GET',
                    data: { federationId: federationId },
                    success: function (data) {
                        subProfessionDropdown.empty();
                        subProfessionDropdown.append(new Option("İxtisas seçin", ""));
                        $.each(data, function (index, item) {
                            var option = new Option(item.name, item.id);
                            if (item.id.toString() === selectedId) {
                                option.selected = true;
                            }
                            subProfessionDropdown.append(option);
                        });
                        subProfessionDropdown.prop('disabled', false);
                    }
                });
            } else {
                subProfessionDropdown.empty();
                subProfessionDropdown.append(new Option("İxtisas seçin", ""));
                subProfessionDropdown.prop('disabled', true);
            }
        }

        // Səhifə yüklənəndə artıq seçilmiş dəyər varsa, yenidən doldur
        if (federationSelect.val() && selectedSubProfessionId) {
            loadSubProfessions(federationSelect.val(), selectedSubProfessionId);
        }

        federationSelect.on('change', function () {
            loadSubProfessions($(this).val(), "");
        });
    });

</script>

