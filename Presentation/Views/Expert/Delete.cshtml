@model ForQab.DataAccess.Models.Expert

@{
    ViewData["Title"] = "Eksperti sil";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="qab-confirm">
                <div class="qab-confirm__header">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <h3>Silinməni / Arxivlənməni təsdiqləyin</h3>
                </div>
                <div class="qab-confirm__body">
                    <p class="qab-confirm__lead">
                        Bu eksperti silmək istədiyinizə <strong>əminsiniz?</strong>
                    </p>
                    <dl class="qab-confirm__list">
                        <div class="qab-confirm__row"><dt>Ad Soyad</dt><dd>@Model.Name @Model.Surname @Model.Fname</dd></div>
                        <div class="qab-confirm__row"><dt>FİN Kod</dt><dd>@Model.FinCode</dd></div>
                        <div class="qab-confirm__row"><dt>İstiqamət</dt><dd>@Model.Section?.Name</dd></div>
                        <div class="qab-confirm__row"><dt>Müəssisə</dt><dd>@Model.FederationNavigation?.Name</dd></div>
                    </dl>

                    <!-- Arxivlə -->
                    <div style="margin-top:1.25rem;padding:1rem;background:var(--qab-warning-soft);
                                border-radius:var(--qab-radius);border:1px solid rgba(217,119,6,.2);">
                        <p style="font-size:.9rem;color:var(--qab-text);margin-bottom:.75rem;">
                            <i class="bi bi-archive"></i> <strong>Arxivlə</strong> — geri qaytarıla bilər:
                        </p>
                        <form asp-action="ArchiveExpert" method="post" style="display:flex;flex-direction:column;gap:.5rem;">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <textarea name="archiveReason" class="form-control" rows="2"
                                      placeholder="Arxivləmə səbəbi..."></textarea>
                            <button type="submit" class="qab-btn qab-btn--outline-warning qab-btn--sm">
                                <i class="bi bi-archive"></i> Arxivlə
                            </button>
                        </form>
                    </div>

                    <div class="qab-confirm__footer">
                        <a asp-action="Index" class="qab-btn qab-btn--outline qab-btn--lg">
                            <i class="bi bi-x-circle"></i> İmtina et
                        </a>
                        <form asp-action="Delete" method="post" asp-route-id="@Model.Id" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="qab-btn qab-btn--danger qab-btn--lg">
                                <i class="bi bi-trash"></i> Sil
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
