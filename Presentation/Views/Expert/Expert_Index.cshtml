@using ForQab.DataAccess.Models
@model IEnumerable<ForQab.DataAccess.Models.Expert>

@{
    ViewData["Title"] = "Ekspertlər Index";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

@if (TempData["ImportError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ImportError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Ekspertlər İdarəetməsi</h1>

    <div class="mb-4 text-end d-flex flex-wrap gap-2 justify-content-end align-items-center">
        <a class="btn btn-sm btn-success shadow-sm" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Yenisini yarat
        </a>
        <a class="btn btn-sm btn-primary shadow-sm" asp-action="ExportToExcel">
            <i class="bi bi-file-earmark-excel"></i> Excel-ə çıxarış
        </a>
        <a class="btn btn-outline-secondary" asp-action="Archived"><i class="bi bi-archive"></i> Arxiv</a>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exportModal">
            <i class="bi bi-file-earmark-word"></i> Müqavilə Export
        </button>
        {{!-- BULK ARCHIVE BUTTON --}}
        <button type="button" class="btn btn-warning" id="bulkArchiveBtn"
                data-bs-toggle="modal" data-bs-target="#bulkArchiveModal"
                style="display:none;">
            <i class="bi bi-archive-fill"></i> Seçilmişləri Arxivlə
            <span class="badge bg-dark ms-1" id="bulkArchiveCount">0</span>
        </button>
    </div>

    @{
        var selectedFederationId = ViewContext.HttpContext.Request.Query["federationId"].ToString();
        var selectedSubProfessionId = ViewContext.HttpContext.Request.Query["subProfessionId"].ToString();
    }

    <!-- Export Modal -->
    <div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exportModalLabel">Müqavilə Export</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="ExportContracts">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="contractDate" class="form-label">Müqavilə Tarixi</label>
                            <input type="date" id="contractDate" name="contractDate" class="form-control" required />
                        </div>
                        <p>Seçdiyiniz ekspertlərin müqavilələri export ediləcək:</p>
                        <div class="table-responsive" style="max-height:200px; overflow:auto;">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th><input type="checkbox" id="selectAll" /></th>
                                        <th>Ad</th>
                                        <th>Soyad</th>
                                        <th>FİN Kodu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="selectedExpertIds" value="@item.Id" class="select-item" />
                                            </td>
                                            <td>@item.Name</td>
                                            <td>@item.Surname</td>
                                            <td>@item.FinCode</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                        <button type="submit" class="btn btn-primary">Export et</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="mb-3">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="text" name="searchName"
                   value="@ViewContext.HttpContext.Request.Query["searchName"]"
                   class="form-control" style="max-width: 200px;"
                   placeholder="Ad və ya soyad üzrə axtar..." />

            <select name="genderId" class="form-control" style="max-width: 150px;">
                <option value="">Cins seçin</option>
                @foreach (var gender in ViewBag.Genders)
                {
                    if (gender.Id.ToString() == ViewContext.HttpContext.Request.Query["genderId"])
                    {
                        <option value="@gender.Id" selected>@gender.Name</option>
                    }
                    else
                    {
                        <option value="@gender.Id">@gender.Name</option>
                    }
                }
            </select>

            <input type="text" name="finCode"
                   value="@ViewContext.HttpContext.Request.Query["finCode"]"
                   class="form-control" style="max-width: 150px;"
                   placeholder="FİN Kod..." />

            <input type="text" name="serial"
                   value="@ViewContext.HttpContext.Request.Query["serial"]"
                   class="form-control" style="max-width: 150px;"
                   placeholder="Seriya..." />

            <select name="district" class="form-control" style="max-width: 200px;">
                <option value="">Rayon seçin</option>
                @foreach (var district in ViewBag.Districts)
                {
                    if (district.Id.ToString() == ViewContext.HttpContext.Request.Query["district"])
                    {
                        <option value="@district.Id" selected>@district.Name</option>
                    }
                    else
                    {
                        <option value="@district.Id">@district.Name</option>
                    }
                }
            </select>

            <input type="number" name="startYear"
                   value="@ViewContext.HttpContext.Request.Query["startYear"]"
                   class="form-control" style="max-width: 120px;" placeholder="Başlanğıc il" />

            <input type="number" name="endYear"
                   value="@ViewContext.HttpContext.Request.Query["endYear"]"
                   class="form-control" style="max-width: 120px;" placeholder="Son il" />

            <select id="federationSelect" name="federationId" class="form-control" style="max-width: 200px;">
                <option value="">Müəssisə və ya təhsil səviyyəsi seçin</option>
                @foreach (var federation in ViewBag.Federation)
                {
                    if (federation.Id.ToString() == selectedFederationId)
                    {
                        <option value="@federation.Id" selected>@federation.Name</option>
                    }
                    else
                    {
                        <option value="@federation.Id">@federation.Name</option>
                    }
                }
            </select>

            <select id="subProfessionSelect" name="subProfessionId" class="form-control" style="max-width: 200px;"
                    @(ViewBag.SubProfessions == null || ((List<SubProfession>)ViewBag.SubProfessions).Count == 0 ? "disabled" : "")>
                <option value="">İxtisas seçin</option>
                @foreach (var subProfession in ViewBag.SubProfessions)
                {
                    if (subProfession.Id.ToString() == selectedSubProfessionId)
                    {
                        <option value="@subProfession.Id" selected>@subProfession.Name</option>
                    }
                    else
                    {
                        <option value="@subProfession.Id">@subProfession.Name</option>
                    }
                }
            </select>

            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Axtar</button>
            <a href="@Url.Action("Index", "Expert")" class="btn btn-outline-secondary">Sıfırla</a>
        </form>
    </div>

    <!-- Main Table -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th style="width:42px;">
                        <input type="checkbox" id="bulkSelectAll" title="Hamısını seç" />
                    </th>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Ata adı</th>
                    <th>Fin Kod</th>
                    <th>Təvəllüd</th>
                    <th>İstiqamət</th>
                    <th>Müəssisə - Təhsil səviyyəsi</th>
                    <th>İxtisas</th>
                    <th>İştirak sayı</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1;
                }
                @foreach (var item in Model)
                {
                    <tr class="align-middle @(item.Status == 1 ? "table-danger" : "")">
                        <td>
                            <input type="checkbox" class="bulk-select-cb" value="@item.Id" />
                        </td>
                        <td>@rowNumber</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Surname)</td>
                        <td>@Html.DisplayFor(modelItem => item.Fname)</td>
                        <td>@Html.DisplayFor(modelItem => item.FinCode)</td>
                        <td>@Html.DisplayFor(modelItem => item.BirthDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.Section.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.FederationNavigation.Name)</td>
                        <td>
                            @if (item.ExpertsProfessions != null && item.ExpertsProfessions.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var subProfession in item.ExpertsProfessions)
                                    {
                                        <li>@subProfession.SubProfession.Name</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>---</span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.ComputedAssignmentCount)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a class="btn btn-outline-warning btn-sm p-1" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square" style="font-size: 0.75rem;"></i>
                                </a>
                                <a class="btn btn-outline-info btn-sm p-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-eye" style="font-size: 0.75rem;"></i>
                                </a>
                                <a class="btn btn-outline-danger btn-sm p-1" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="bi bi-trash" style="font-size: 0.75rem;"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===== BULK ARCHIVE MODAL ===== -->
<div class="modal fade" id="bulkArchiveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="bi bi-archive-fill"></i> Toplu Arxivləmə
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Expert" asp-action="BulkArchive" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p id="bulkArchiveCountText" class="alert alert-info mb-3"></p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Arxivləmə səbəbi</label>
                        <textarea name="archiveReason" class="form-control" rows="3"
                                  placeholder="Arxivləmə səbəbini yazın..."></textarea>
                    </div>
                    <div id="bulkArchiveHiddenIds"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ləğv et</button>
                    <button type="submit" class="btn btn-warning fw-bold">
                        <i class="bi bi-archive-fill"></i> Arxivlə
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ===== END BULK ARCHIVE MODAL ===== -->

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // ===== Export Modal - selectAll =====
        document.getElementById('selectAll').addEventListener('change', function () {
            document.querySelectorAll('.select-item').forEach(cb => cb.checked = this.checked);
        });

        // ===== Federation → SubProfession lazy load =====
        $(document).ready(function () {
            $('#federationSelect').change(function () {
                var federationId = $(this).val();
                var subSelect = $('#subProfessionSelect');
                if (federationId) {
                    $.getJSON('/Expert/GetSubProfessionsByFederation', { federationId: federationId }, function (data) {
                        subSelect.empty().append('<option value="">İxtisas seçin</option>');
                        $.each(data, function (i, item) {
                            subSelect.append(new Option(item.name, item.id));
                        });
                        subSelect.prop('disabled', false);
                    });
                } else {
                    subSelect.empty().append('<option value="">İxtisas seçin</option>').prop('disabled', true);
                }
            });
        });

        // ===== BULK ARCHIVE =====
        (function () {
            const bulkBtn = document.getElementById('bulkArchiveBtn');
            const bulkBadge = document.getElementById('bulkArchiveCount');
            const bulkSelectAll = document.getElementById('bulkSelectAll');

            function getChecked() {
                return document.querySelectorAll('.bulk-select-cb:checked');
            }

            function updateBulkUI() {
                const count = getChecked().length;
                if (count > 0) {
                    bulkBtn.style.display = 'inline-block';
                    bulkBadge.textContent = count;
                } else {
                    bulkBtn.style.display = 'none';
                    bulkBadge.textContent = '0';
                }
            }

            document.addEventListener('change', function (e) {
                if (!e.target.classList.contains('bulk-select-cb')) return;
                updateBulkUI();
                const all = document.querySelectorAll('.bulk-select-cb');
                const checked = getChecked();
                bulkSelectAll.indeterminate = checked.length > 0 && checked.length < all.length;
                bulkSelectAll.checked = all.length > 0 && checked.length === all.length;
            });

            bulkSelectAll.addEventListener('change', function () {
                document.querySelectorAll('.bulk-select-cb').forEach(cb => cb.checked = this.checked);
                updateBulkUI();
            });

            document.getElementById('bulkArchiveModal').addEventListener('show.bs.modal', function () {
                const checked = getChecked();
                document.getElementById('bulkArchiveCountText').textContent =
                    checked.length + ' ekspert arxivə göndəriləcək.';

                const container = document.getElementById('bulkArchiveHiddenIds');
                container.innerHTML = '';
                checked.forEach(cb => {
                    const inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = 'selectedIds';
                    inp.value = cb.value;
                    container.appendChild(inp);
                });
            });
        })();
        // ===== END BULK ARCHIVE =====
    </script>
}
