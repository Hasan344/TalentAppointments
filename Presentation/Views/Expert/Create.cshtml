@using ForQab.Data_Access.ViewModel
@model ExpertViewModel

@{
    ViewData["Title"] = "Yeni ekspert";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />
@* ⭐ YENİ: Validation styles *@
<link rel="stylesheet" href="~/css/Shared/QabValidation.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-person-plus"></i></span>
                    Yeni ekspert əlavə et
                </h1>
            </div>
            <a class="qab-page-header__back" asp-action="Index"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    @* ⭐ YENİ: TempData mesajları *@
    <partial name="_QabFormAlerts" />

    <form asp-action="Create" method="post" class="qab-form">
        @* ⭐ DƏYİŞDİ: ModelOnly → All *@
        <div asp-validation-summary="All" class="qab-form__validation"></div>
        <input type="hidden" asp-for="Kons" value="false" />

        <!-- Şəxsi məlumatlar -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">Şəxsi məlumatlar</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="Name" class="form-label">Ad <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Surname" class="form-label">Soyad <span class="text-danger">*</span></label>
                    <input asp-for="Surname" class="form-control" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Fname" class="form-label">Ata adı <span class="text-danger">*</span></label>
                    <input asp-for="Fname" class="form-control" />
                    <span asp-validation-for="Fname" class="text-danger"></span>
                </div>
            </div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="Gender" class="form-label">Cins <span class="text-danger">*</span></label>
                    <select asp-for="Gender" class="form-select" asp-items="@(ViewBag.GenderList as SelectList)">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="BirthDate" class="form-label">Doğum tarixi <span class="text-danger">*</span></label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="TelIs" class="form-label">İş telefonu</label>
                    <input asp-for="TelIs" class="form-control" />
                    <span asp-validation-for="TelIs" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="TelEl" class="form-label">Əlaqə telefonu</label>
                    <input asp-for="TelEl" class="form-control" />
                    <span asp-validation-for="TelEl" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Sənəd məlumatları -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">Sənəd məlumatları</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="FinCode" class="form-label">FİN Kod <span class="text-danger">*</span></label>
                    <input asp-for="FinCode" class="form-control" />
                    <span asp-validation-for="FinCode" class="text-danger"></span>
                </div>
                <partial name="_SerialPrefixSelect" model="@Model.SerialPrefix" />
                <div class="qab-form__field">
                    <label asp-for="Serial" class="form-label">Seriya nömrəsi <span class="text-danger">*</span></label>
                    <input asp-for="Serial" class="form-control" />
                    <span asp-validation-for="Serial" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- İş və ixtisas məlumatları -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">İş və ixtisas məlumatları</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="SectionId" class="form-label">İstiqamət <span class="text-danger">*</span></label>
                    <select asp-for="SectionId" class="form-select" asp-items="@(ViewBag.SectionList as SelectList)">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="SectionId" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Federation" class="form-label">Müəssisə <span class="text-danger">*</span></label>
                    <select asp-for="Federation" class="form-select" id="federationSelect"
                            asp-items="@(ViewBag.FederationList as SelectList)">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="Federation" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Profession" class="form-label">Peşə</label>
                    <input asp-for="Profession" class="form-control" />
                    <span asp-validation-for="Profession" class="text-danger"></span>
                </div>
            </div>

            @if (Model.SubProfessions != null && Model.SubProfessions.Any())
            {
                <div class="qab-form__field">
                    <label class="form-label">İxtisaslar</label>
                    <select asp-for="SelectedSubProfessions" class="form-select" id="subProfessionSelect" multiple>
                        @foreach (var sp in Model.SubProfessions)
                        {
                            <option value="@sp.Value">@sp.Text</option>
                        }
                    </select>
                    <span asp-validation-for="SelectedSubProfessions" class="text-danger"></span>
                </div>
            }
        </div>

        <!-- Maliyyə məlumatları -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">Maliyyə məlumatları</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="SSN" class="form-label">SSN <span class="text-danger">*</span></label>
                    <input asp-for="SSN" class="form-control" />
                    <span asp-validation-for="SSN" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Rekvizit" class="form-label">Rekvizit <span class="text-danger">*</span></label>
                    <input asp-for="Rekvizit" class="form-control" />
                    <span asp-validation-for="Rekvizit" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="HesablashmaH" class="form-label">Hesablaşma hesabı</label>
                    <input asp-for="HesablashmaH" class="form-control" />
                    <span asp-validation-for="HesablashmaH" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="Voen" class="form-label">VÖEN</label>
                    <input asp-for="Voen" class="form-control" />
                    <span asp-validation-for="Voen" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="BankFilial" class="form-label">Bank filialı <span class="text-danger">*</span></label>
                    <input asp-for="BankFilial" class="form-control" />
                    <span asp-validation-for="BankFilial" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="BankFilialCode" class="form-label">Bank filial kodu <span class="text-danger">*</span></label>
                    <input asp-for="BankFilialCode" class="form-control" />
                    <span asp-validation-for="BankFilialCode" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Müqavilə -->
        <div class="qab-form__section">
            <div class="qab-form__section-title">Müqavilə</div>
            <div class="qab-form__row">
                <div class="qab-form__field">
                    <label asp-for="ContractNo" class="form-label">Müqavilə nömrəsi</label>
                    <input asp-for="ContractNo" class="form-control" />
                    <span asp-validation-for="ContractNo" class="text-danger"></span>
                </div>
                <div class="qab-form__field">
                    <label asp-for="ContractDate" class="form-label">Müqavilə tarixi</label>
                    <input asp-for="ContractDate" type="date" class="form-control" />
                    <span asp-validation-for="ContractDate" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="qab-form__footer">
            <a asp-action="Index" class="qab-btn qab-btn--outline">
                <i class="bi bi-arrow-left"></i> Ləğv et
            </a>
            <button type="submit" class="qab-btn qab-btn--primary qab-btn--lg">
                <i class="bi bi-check-circle"></i> Yarat
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    @* ⭐ YENİ: Validation JS *@
    <script src="~/js/Shared/qab-validation.js" asp-append-version="true"></script>
}
