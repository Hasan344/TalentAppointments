@using ForQab.DataAccess.Models
@model Profession

@{
    ViewData["Title"] = "Sil";
}

<div class="container py-4" style="background-color: #2c2f33; border-radius: 10px; color: #ffffff;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="text-center mb-4">@ViewData["Title"]</h1>
            <hr style="border-color: #7289da;" />

            <form asp-controller="Federation" asp-action="Delete" method="post" class="p-3">
                <input type="hidden" asp-for="Id" />

                <div class="mb-4 text-center">
                    <p>Silmək istədiyinizə əminsinizmi?</p>
                    <strong>@Model.Name</strong>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary" style="background-color: #2f3136; color: #ffffff;">Geri</a>
                    <button type="submit" class="btn btn-danger" style="background-color: #ff4d4d; border-color: #ff4d4d;">Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>
