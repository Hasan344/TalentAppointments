@model IEnumerable<ForQab.DataAccess.Models.Monitor>

@{
    ViewData["Title"] = "Könüllülər";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
<div class="container mt-5">
    <!-- Page Title -->
    <h1 class="text-center mb-4 ">Könüllülər İdarəetməsi</h1>

    <!-- Create New Volunteer Button -->
    <div class="mb-4 text-end">
        <a class="btn btn-sm btn-success shadow-sm" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Yenisini yarat
        </a> 
        <a class="btn btn-sm btn-primary shadow-sm" asp-action="ExportToExcel">
            <i class="bi bi-file-earmark-excel"></i> Excel'ə çıxarış
        </a>
    </div>

    <!-- Table with Bordered and Modern Design -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Ata adı</th>
                    <th>İş telefonu</th>
                    <th>Cins</th>
                    <th>Rol</th>
                    <th>İstiqamət</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1;
                }
                @foreach (var item in Model)
                {
                    <tr class="align-middle">
                        <td>@rowNumber</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Surname)</td>
                        <td>@Html.DisplayFor(modelItem => item.Fname)</td>
                        <td>@Html.DisplayFor(modelItem => item.TelIs)</td>
                        <td>@Html.DisplayFor(modelItem => item.GenderNavigation.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.RoleNavigation.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Section.Name)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a class="btn btn-outline-warning btn-sm p-1" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square" style="font-size: 0.75rem;"></i> Düzəliş
                                </a>
                                <a class="btn btn-outline-info btn-sm p-1" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-eye" style="font-size: 0.75rem;"></i> Detallar
                                </a>
                                <a class="btn btn-outline-danger btn-sm p-1" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="bi bi-trash" style="font-size: 0.75rem;"></i> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .container {
            max-width: 1200px;
        }

        /* Table Styling */
        .table-bordered {
            border: 1px solid #dee2e6;
        }

        .table-bordered th, .table-bordered td {
            border: 1px solid #dee2e6;
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #f7f7f7;
        }

        .table-hover tbody tr:hover {
            background-color: #f1f1f1;
        }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
        }

        .table-light th {
            background-color: #f8f9fa;
            color: #495057;
        }

        /* Button Styling */
        .btn-group .btn {
            margin-right: 8px;
        }

        .btn:hover {
            transform: translateY(-2px);
            transition: transform 0.2s ease-in-out;
        }

        .btn-outline-warning {
            border-color: #ffc107;
            color: #ffc107;
        }

        .btn-outline-warning:hover {
            background-color: #ffc107;
            color: #fff;
        }

        .btn-outline-info {
            border-color: #17a2b8;
            color: #17a2b8;
        }

        .btn-outline-info:hover {
            background-color: #17a2b8;
            color: #fff;
        }

        .btn-outline-danger {
            border-color: #dc3545;
            color: #dc3545;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: #fff;
        }

        /* Header and Text Styles */
        .text-primary {
            color: #0d6efd !important;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 600;
            margin-bottom: 30px;
        }

        .shadow-sm {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .btn-sm {
            padding: 0.25rem 1rem;
            font-size: 1rem;
        }

        .btn-outline-warning, .btn-outline-info, .btn-outline-danger {
            padding: 0.25rem 1rem;
            font-size: 1rem;
        }

        .btn-group .btn {
            font-size: 1rem;
        }

        .btn-sm i {
            font-size: 1rem;
        }

        
    </style>
}
