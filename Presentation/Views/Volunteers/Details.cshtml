@model ForQab.DataAccess.Models.Monitor

@{
    ViewData["Title"] = "Könüllü Detalları";
    string primaryColor = "#0056b3";  /* Strong corporate blue */
    string secondaryColor = "#f1f1f1";  /* Light gray */
    string textColor = "#333333"; /* Dark text color for readability */
}

<div class="container py-5" style="background-color: #fff; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1); padding: 30px; max-width: 1000px; margin: auto;">
    <h1 class="text-center mb-4" style="color: @primaryColor; font-family: 'Roboto', sans-serif; font-weight: 600;">Könüllü Detalları</h1>
    <hr style="border-color: @primaryColor; border-width: 2px;" />

    <!-- Left column: Photo -->
    <div class="col-lg-4 d-flex justify-content-center align-items-start">
        <div class="card shadow-sm border-0 rounded-4" style="width: 100%; max-width: 320px;">
            <div class="card-body text-center">
                <div class="col-md-12 d-flex flex-column align-items-center mb-4">
                    @if (Model.Photo != null)
                    {
                        <img src="@Model.Photo" class="w-48 h-48 object-cover rounded-full shadow-lg border border-gray-300" />

                    }
                    else
                    {
                        <div class="w-40 h-40 bg-gray-100 flex flex-col items-center justify-center rounded-full shadow-inner border border-gray-300">
                            <i class="fas fa-user text-gray-400 text-5xl mb-2"></i>
                            <span class="text-sm text-gray-500">Şəkil tapılmadı</span>
                        </div>
                    }
                </div>


                <h4 class="mb-1">@Model.Name @Model.Surname</h4>
                <p class="text-muted mb-0">@Model.Fname</p>
                <small class="text-secondary">@Model.Section?.Name</small>
            </div>
        </div>
    </div>

    <!-- Right column: Details -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h4 class="mb-4" style="color:@primaryColor;">Məlumatlar</h4>
            <div class="row mb-3">
                <div class="col-sm-5 fw-semibold text-secondary">Doğum tarixi:</div>
                <div class="col-sm-7">@Model.BirthDate?.ToString("dd.MM.yyyy")</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-5 fw-semibold text-secondary">Fin Kodu:</div>
                <div class="col-sm-7">@Model.FinCode</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-5 fw-semibold text-secondary">Seriya nömrəsi:</div>
                <div class="col-sm-7">@Model.Serial</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-5 fw-semibold text-secondary">Telefon:</div>
                <div class="col-sm-7">@Model.TelIs</div>
            </div>


                <div class="text-center mt-4">
                    <a class="btn btn-outline-primary me-3" asp-action="Edit" asp-route-id="@Model.Id">
                        <i class="bi bi-pencil-square me-1"></i> Düzəliş et
                    </a>
                    <a class="btn btn-outline-danger me-3" asp-action="Delete" asp-route-id="@Model.Id">
                        <i class="bi bi me-1"></i> Sil və ya Arxivlə
                    </a>
                    <a class="btn btn-outline-secondary me-3" asp-action="Index">
                        <i class="bi bi-list-ul me-1"></i> Siyahıya qayıt
                    </a>
                </div>
        </div>
    </div>
</div>
