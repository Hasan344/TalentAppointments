@model ForQab.DataAccess.Models.Monitor

@{
    ViewData["Title"] = "Könüllünü sil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-body">
                    <h4 class="text-center text-danger">Bu könüllünü silməyə əminsiniz?</h4>

                    <div class="mt-4">
                        <h5>Detallar</h5>
                        <hr />
                        <dl class="row">
                            <dt class="col-sm-4 font-weight-bold">Ad:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                            <dt class="col-sm-4 font-weight-bold">Soyad:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Surname)</dd>

                            <dt class="col-sm-4 font-weight-bold">Ata adı:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Fname)</dd>

                            <dt class="col-sm-4 font-weight-bold">Cins:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.GenderNavigation.Name)</dd>

                            <dt class="col-sm-4 font-weight-bold">VNum:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.VNum)</dd>

                            <dt class="col-sm-4 font-weight-bold">Peşə:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Profession)</dd>

                            <dt class="col-sm-4 font-weight-bold">İş yeri:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Workplace)</dd>

                            <dt class="col-sm-4 font-weight-bold">Vəzifə:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Position)</dd>

                            <dt class="col-sm-4 font-weight-bold">Ev telefonu:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.TelEv)</dd>

                            <dt class="col-sm-4 font-weight-bold">İş telefonu:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.TelIs)</dd>

                            <dt class="col-sm-4 font-weight-bold">FİN Kodu:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.FinCode)</dd>

                            <dt class="col-sm-4 font-weight-bold">Seriya:</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Serial)</dd>
                        </dl>
                    </div>

                    <div class="mt-4 text-center">
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger btn-lg px-4">Sil</button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg px-4 ml-3">Siyahıya Qayıt</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
