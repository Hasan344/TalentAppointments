@{
    ViewData["Title"] = "Home Page";
}
@model string;

<link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
<body class="bg-main">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg  bg-navbar shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="#">Qabiliyyət İmtahanları</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Headmonitors/index">İmtahan Rəhbərləri</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Monitors/index">Nəzarətçilər</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Expert/index">Ekspertlər</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="bg-second text-white py-5">
        <div class="container text-center">
            <h1 class="display-4 mb-3">
                @if (@ViewBag.Section == 1)
                {
                    <span>Qabiliyyət İmtahanları İdman</span>
                }
                else if (@ViewBag.Section == 3)
                {
                    <span>Qabiliyyət İmtahanları Musiqi</span>
                }
                else if (@ViewBag.Section == 2)
                {
                    <span>Qabiliyyət İmtahanları Təsviri</span>
                }
                else
                {
                    <span>Qabiliyyət İmtahanları</span>
                }
            </h1>
        </div>
    </section>

    <!-- Main Content Section -->
    <section class="container my-5">
        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 hover-card">
                    <div class="card-body text-center">
                        <h5 class="card-title">İmtahan Rəhbərləri</h5>
                        <a href="/Headmonitors/index" class="btn btn-primary rounded-pill px-4 py-2">Keçid</a>
                    </div>
                </div>
            </div>
            <!-- Card 2 -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 hover-card">
                    <div class="card-body text-center">
                        <h5 class="card-title">Nəzarətçilər</h5>
                        <a href="/Monitors/index" class="btn btn-secondary rounded-pill px-4 py-2">Keçid</a>
                    </div>
                </div>
            </div>
            <!-- Card 3 -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 hover-card">
                    <div class="card-body text-center">
                        <h5 class="card-title">Ekspertlər</h5>
                        <a href="/Expert/index" class="btn btn-outline-dark rounded-pill px-4 py-2">Keçid</a>
                    </div>
                </div>
            </div>
            
            <!-- Card 4 -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 hover-card">
                    <div class="card-body text-center">
                        <h5 class="card-title">İmtahanlar</h5>
                        <a href="/Exam/index" class="btn btn-danger rounded-pill px-4 py-2">Keçid</a>
                    </div>
                </div>
            </div>
            <!-- Card 6 -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 hover-card">
                    <div class="card-body text-center">
                        <h5 class="card-title">Dim nümayəndələri</h5>
                        <a href="/Representative/index" class="btn btn-outline-info rounded-pill px-4 py-2">Keçid</a>
                    </div>
                </div>
            </div>
            <!-- Card 7 -->
            @if (@ViewBag.Section == 1)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 hover-card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Könüllülər</h5>
                            <a href="/Volunteers/index" class="btn btn-success rounded-pill px-4 py-2">Keçid</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 hover-card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Nazirlik nümayəndələri</h5>
                            <a href="/MinistryRepresentative/index" class="btn btn-success rounded-pill px-4 py-2">Keçid</a>
                        </div>
                    </div>
                </div>
            }
            else if (@ViewBag.Section == 3 || @ViewBag.Section == 4 || @ViewBag.SectionId == 6)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 hover-card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Konsertmeysterlər</h5>
                            <a href="/Kons/index" class="btn btn-success rounded-pill px-4 py-2">Keçid</a>
                        </div>
                    </div>
                </div>
            }
            else if (@ViewBag.Section == 2)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 hover-card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Naturaçılar</h5>
                            <a href="/Natura/index" class="btn btn-success rounded-pill px-4 py-2">Keçid</a>
                        </div>
                    </div>
                </div>
            }
            else if(@ViewBag.Section == null)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 hover-card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Könüllülər</h5>
                            <a href="/Volunteers/index" class="btn btn-success rounded-pill px-4 py-2">Keçid</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 hover-card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Konsertmeysterlər</h5>
                            <a href="/Kons/index" class="btn btn-success rounded-pill px-4 py-2">Keçid</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 hover-card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Naturaçılar</h5>
                            <a href="/Natura/index" class="btn btn-success rounded-pill px-4 py-2">Keçid</a>
                        </div>
                    </div>
                </div>
            }
            <!-- Card 12 -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 hover-card">
                    <div class="card-body text-center">
                        <h5 class="card-title">Digər işçilər</h5>
                        <a href="/Worker/index" class="btn btn-outline-dark rounded-pill px-4 py-2">Keçid</a>
                    </div>
                </div>
            </div>
            <!-- Card 8 -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 hover-card">
                    <div class="card-body text-center">
                        <h5 class="card-title">İmtahan təqvimi</h5>
                        <a href="/Calendar/Index" class="btn btn-success rounded-pill px-4 py-2">Keçid</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>