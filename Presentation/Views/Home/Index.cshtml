@{
    ViewData["Title"] = "Ana səhifə";
}
@model string;

<link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />

<div class="qab-home">
    <!-- Hero Section -->
    <section class="qab-hero">
        <div class="qab-hero__bg">
            <div class="qab-hero__blob qab-hero__blob--1"></div>
            <div class="qab-hero__blob qab-hero__blob--2"></div>
            <div class="qab-hero__blob qab-hero__blob--3"></div>
            <div class="qab-hero__grid"></div>
        </div>

        <div class="container qab-hero__inner">
            <span class="qab-hero__badge">
                <i class="bi bi-stars"></i>
                <span>İdarəetmə Paneli</span>
            </span>
            <h1 class="qab-hero__title">
                Qabiliyyət İmtahanlarının <span class="qab-hero__title-accent">İdarəetmə Sistemi</span>
            </h1>
            
        </div>
    </section>

    <!-- Cards Section -->
    <section class="container qab-section">
        <div class="qab-section__header">
            <h2 class="qab-section__title">Bölmələr</h2>
            <p class="qab-section__hint">Davam etmək üçün bölmə seçin</p>
        </div>

        <div class="qab-grid">
            <!-- İmtahan Rəhbərləri -->
            <a href="/Headmonitors/index" class="qab-card qab-card--primary">
                <div class="qab-card__icon">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div class="qab-card__body">
                    <h5 class="qab-card__title">İmtahan Rəhbərləri</h5>
                    <span class="qab-card__cta">
                        Keçid <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>

            <!-- Nəzarətçilər -->
            <a href="/Monitors/index" class="qab-card qab-card--indigo">
                <div class="qab-card__icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div class="qab-card__body">
                    <h5 class="qab-card__title">Nəzarətçilər</h5>
                    <span class="qab-card__cta">
                        Keçid <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>

            <!-- Ekspertlər -->
            <a href="/Expert/index" class="qab-card qab-card--slate">
                <div class="qab-card__icon">
                    <i class="bi bi-mortarboard"></i>
                </div>
                <div class="qab-card__body">
                    <h5 class="qab-card__title">Ekspertlər</h5>
                    <span class="qab-card__cta">
                        Keçid <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>

            <!-- İmtahanlar -->
            <a href="/Exam/index" class="qab-card qab-card--rose">
                <div class="qab-card__icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div class="qab-card__body">
                    <h5 class="qab-card__title">İmtahanlar</h5>
                    <span class="qab-card__cta">
                        Keçid <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>

            <!-- DİM nümayəndələri -->
            <a href="/Representative/index" class="qab-card qab-card--cyan">
                <div class="qab-card__icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="qab-card__body">
                    <h5 class="qab-card__title">DİM nümayəndələri</h5>
                    <span class="qab-card__cta">
                        Keçid <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>

            <!-- Könüllülər -->
            <a href="/Volunteers/index" class="qab-card qab-card--emerald">
                <div class="qab-card__icon">
                    <i class="bi bi-heart"></i>
                </div>
                <div class="qab-card__body">
                    <h5 class="qab-card__title">Könüllülər</h5>
                    <span class="qab-card__cta">
                        Keçid <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>

            @if (ViewBag.Section == 1)
            {
                <!-- Nazirlik nümayəndələri -->
                <a href="/MinistryRepresentative/index" class="qab-card qab-card--amber">
                    <div class="qab-card__icon">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="qab-card__body">
                        <h5 class="qab-card__title">Nazirlik nümayəndələri</h5>
                        <span class="qab-card__cta">
                            Keçid <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </a>
            }
            else if (ViewBag.Section == 3 || ViewBag.Section == 4 || ViewBag.SectionId == 6)
            {
                <!-- Konsertmeysterlər -->
                <a href="/Kons/index" class="qab-card qab-card--violet">
                    <div class="qab-card__icon">
                        <i class="bi bi-music-note-beamed"></i>
                    </div>
                    <div class="qab-card__body">
                        <h5 class="qab-card__title">Konsertmeysterlər</h5>
                        <span class="qab-card__cta">
                            Keçid <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </a>
            }
            else if (ViewBag.Section == 2)
            {
                <!-- Naturaçılar -->
                <a href="/Natura/index" class="qab-card qab-card--orange">
                    <div class="qab-card__icon">
                        <i class="bi bi-palette"></i>
                    </div>
                    <div class="qab-card__body">
                        <h5 class="qab-card__title">Naturaçılar</h5>
                        <span class="qab-card__cta">
                            Keçid <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </a>
            }
            else if (ViewBag.Section == null)
            {
                <!-- Konsertmeysterlər (admin) -->
                <a href="/Kons/index" class="qab-card qab-card--violet">
                    <div class="qab-card__icon">
                        <i class="bi bi-music-note-beamed"></i>
                    </div>
                    <div class="qab-card__body">
                        <h5 class="qab-card__title">Konsertmeysterlər</h5>
                        <span class="qab-card__cta">
                            Keçid <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </a>

                <!-- Naturaçılar (admin) -->
                <a href="/Natura/index" class="qab-card qab-card--orange">
                    <div class="qab-card__icon">
                        <i class="bi bi-palette"></i>
                    </div>
                    <div class="qab-card__body">
                        <h5 class="qab-card__title">Naturaçılar</h5>
                        <span class="qab-card__cta">
                            Keçid <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>
                </a>
            }

            <!-- Digər işçilər -->
            <a href="/Worker/index" class="qab-card qab-card--slate">
                <div class="qab-card__icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="qab-card__body">
                    <h5 class="qab-card__title">Digər işçilər</h5>
                    <span class="qab-card__cta">
                        Keçid <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>

            <!-- İmtahan təqvimi -->
            <a href="/Calendar/Index" class="qab-card qab-card--teal">
                <div class="qab-card__icon">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div class="qab-card__body">
                    <h5 class="qab-card__title">İmtahan təqvimi</h5>
                    <span class="qab-card__cta">
                        Keçid <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>
        </div>
    </section>
</div>
