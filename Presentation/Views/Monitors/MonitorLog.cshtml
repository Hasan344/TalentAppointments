@model IEnumerable<ForQab.DataAccess.Models.MonitorLog>

@{
    ViewData["Title"] = "Nəzarətçinin qeydləri";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-journal-text"></i></span>
                    Nəzarətçinin xüsusi qeydləri
                </h1>
            </div>
            <a class="qab-page-header__back" asp-action="Index"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    @if (Model?.Any() == true)
    {
        <div class="qab-table-wrap">
            <div class="qab-table-scroll">
                <table class="qab-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>İmtahan</th>
                            <th>Növ</th>
                            <th>Qeyd</th>
                            <th>Tarix</th>
                            <th>İstifadəçi</th>
                            <th>Əməliyyat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="qab-col-num">@i</td>
                                <td><span class="qab-table__id">#@log.ExamId</span></td>
                                <td>
                                    @if (log.Kind == 0)
                                    {
                                        <span class="qab-badge qab-badge--danger"><i class="bi bi-x-circle"></i> Gəlmədi</span>
                                    }
                                    else
                                    {
                                        <span class="qab-badge qab-badge--warning"><i class="bi bi-exclamation-circle"></i> Qeyd</span>
                                    }
                                </td>
                                <td style="font-size:.9rem;">@log.Note</td>
                                <td class="qab-col-date">@log.Time?.ToString("dd.MM.yyyy HH:mm")</td>
                                <td style="font-size:.85rem;">@log.UserName</td>
                                <td>
                                    <form asp-action="DeleteLogs" method="post" style="margin:0;">
                                        <input type="hidden" name="id" value="@log.Id" />
                                        <button type="submit" class="qab-table__action-btn qab-table__action-btn--delete" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="qab-empty-state">
            <i class="bi bi-journal-x" style="font-size:2rem;display:block;margin-bottom:.75rem;"></i>
            Bu nəzarətçi üçün heç bir xüsusi qeyd yoxdur.
        </div>
    }
</div>
