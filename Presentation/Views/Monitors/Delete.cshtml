@model ForQab.DataAccess.Models.Monitor

@{
    ViewData["Title"] = "Nəzarətçini sil";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="qab-confirm">
                <div class="qab-confirm__header">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <h3>Silinməni / Arxivlənməni təsdiqləyin</h3>
                </div>
                <div class="qab-confirm__body">
                    <p class="qab-confirm__lead">
                        Bu nəzarətçini silmək istədiyinizə <strong>əminsiniz?</strong>
                    </p>
                    <dl class="qab-confirm__list">
                        <div class="qab-confirm__row">
                            <dt>Ad Soyad</dt>
                            <dd>@Model.Name @Model.Surname @Model.Fname</dd>
                        </div>
                        <div class="qab-confirm__row">
                            <dt>FİN Kod</dt>
                            <dd>@Model.FinCode</dd>
                        </div>
                        <div class="qab-confirm__row">
                            <dt>İstiqamət</dt>
                            <dd>@Model.Section?.Name</dd>
                        </div>
                        <div class="qab-confirm__row">
                            <dt>Rayon</dt>
                            <dd>@Model.DistrictNavigation?.Name</dd>
                        </div>
                    </dl>

                    <!-- Arxivləmə formu -->
                    <div style="margin-top:1.25rem;padding:1rem;background:var(--qab-warning-soft);border-radius:var(--qab-radius);border:1px solid rgba(217,119,6,.2);">
                        <p style="font-size:.9rem;color:var(--qab-text);margin-bottom:.75rem;">
                            <i class="bi bi-archive"></i> <strong>Arxivlə</strong> — nəzarətçini arxivə əlavə edin (geri qaytarıla bilər):
                        </p>
                        <form asp-action="ArchiveMonitor" method="post" style="display:flex;flex-direction:column;gap:.5rem;">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <textarea name="archiveReason" class="form-control" rows="2"
                                      placeholder="Arxivləmə səbəbi..."></textarea>
                            <button type="submit" class="qab-btn qab-btn--outline-warning qab-btn--sm">
                                <i class="bi bi-archive"></i> Arxivlə
                            </button>
                        </form>
                    </div>

                    <div class="qab-confirm__footer">
                        <a asp-action="Index" class="qab-btn qab-btn--outline qab-btn--lg">
                            <i class="bi bi-x-circle"></i> İmtina et
                        </a>
                        <!-- Sil düyməsi - modal açır -->
                        <button type="button" class="qab-btn qab-btn--danger qab-btn--lg"
                                data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                            <i class="bi bi-trash"></i> Sil
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== TƏSDİQ MODALI: "sil" yazaraq təsdiqləmə ===== -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDeleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Silmə əməliyyatını təsdiqləyin
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Bağla"></button>
            </div>
            <form id="confirmDeleteForm" asp-action="Delete" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="modal-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        Bu əməliyyat <strong>geri qaytarıla bilməz</strong>.
                        Nəzarətçi <strong>@Model.Name @Model.Surname</strong> sistemdən tamamilə silinəcək.
                    </div>
                    <p class="mb-2">
                        Davam etmək üçün aşağıdakı sahəyə kiçik hərflərlə <code><strong>sil</strong></code> sözünü yazın:
                    </p>
                    <input type="text" id="deleteConfirmInput" class="form-control"
                           placeholder='Buraya "sil" yazın' autocomplete="off" />
                    <small id="deleteConfirmHint" class="text-muted">
                        Düymə yalnız siz <strong>"sil"</strong> yazdıqdan sonra aktiv olacaq.
                    </small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="qab-btn qab-btn--outline" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> İmtina et
                    </button>
                    <button type="submit" id="confirmDeleteBtn" class="qab-btn qab-btn--danger" disabled>
                        <i class="bi bi-trash"></i> Bəli, sil
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('deleteConfirmInput');
            const btn = document.getElementById('confirmDeleteBtn');
            const modal = document.getElementById('confirmDeleteModal');

            // Yalnız "sil" yazdıqda düyməni aktivləşdir
            input.addEventListener('input', function () {
                btn.disabled = input.value.trim().toLowerCase() !== 'sil';
            });

            // Modal bağlanan zaman input-u sıfırla
            modal.addEventListener('hidden.bs.modal', function () {
                input.value = '';
                btn.disabled = true;
            });

            // Modal açılan zaman input-a fokus ver
            modal.addEventListener('shown.bs.modal', function () {
                input.focus();
            });

            // Form göndərilərkən son təsdiq
            document.getElementById('confirmDeleteForm').addEventListener('submit', function (e) {
                if (input.value.trim().toLowerCase() !== 'sil') {
                    e.preventDefault();
                    btn.disabled = true;
                }
            });
        })();
    </script>
}
