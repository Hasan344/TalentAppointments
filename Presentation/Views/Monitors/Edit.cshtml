@model ForQab.DataAccess.ViewModel.Monitor.MonitorEditViewModel

@{
    ViewData["Title"] = "Düzəliş";
}

<div class="container py-4" style="background-color: #2c2f33; border-radius: 10px; color: #ffffff;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="text-center mb-4">@ViewData["Title"]</h1>
            <h4 class="text-center mb-3">Nəzarətçiyə düzəliş</h4>
            <hr style="border-color: #7289da;" />

            <form asp-action="Edit" method="post" class="p-4">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Ad</label>
                    <input asp-for="Name" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Surname" class="form-label">Soyad</label>
                    <input asp-for="Surname" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Fname" class="form-label">Atanın Adı</label>
                    <input asp-for="Fname" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Fname" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FinCode" class="form-label">FİN Kodu</label>
                    <input asp-for="FinCode" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="FinCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Serial" class="form-label">Serial</label>
                    <input asp-for="Serial" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Serial" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BirthDate" class="form-label">Doğum tarixi</label>
                    <input asp-for="BirthDate" type="date" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SectionId" class="form-label">İstiqamət</label>
                    <select asp-for="SectionId" class="form-select" asp-items="ViewBag.SectionList" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>İstiqamət Seçin</option>
                    </select>
                    <span asp-validation-for="SectionId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Gender" class="form-label">Cins</label>
                    <select asp-for="Gender" class="form-select" asp-items="ViewBag.Gender" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>Cins Seçin</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="District" class="form-label" style="font-weight: 500;">Rayon</label>
                    <select asp-for="District" class="form-select" asp-items="ViewBag.District" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>Seçin...</option>
                    </select>
                    <span asp-validation-for="District" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VNum" class="form-label">Vəsiqə Nömrəsi</label>
                    <input asp-for="VNum" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="VNum" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Profession" class="form-label">İxtisas</label>
                    <input asp-for="Profession" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Profession" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Workplace" class="form-label">İş Yeri</label>
                    <input asp-for="Workplace" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Workplace" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TelIs" class="form-label">Telefonu</label>
                    <input asp-for="TelIs" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="TelIs" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Position" class="form-label">Vəzifə</label>
                    <input asp-for="Position" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Uni" class="form-label">Təhsil aldığı müəssisə</label>
                    <input asp-for="Uni" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Uni" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HesablashmaH" class="form-label">Hesablashma Hesabı</label>
                    <input asp-for="HesablashmaH" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="HesablashmaH" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SSN" class="form-label">SSN</label>
                    <input asp-for="SSN" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="SSN" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Rekvizit" class="form-label">Rekvizit</label>
                    <input asp-for="Rekvizit" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Rekvizit" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Voen" class="form-label">VÖEN</label>
                    <input asp-for="Voen" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Voen" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BankFilial" class="form-label">Bank Filialı</label>
                    <input asp-for="BankFilial" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="BankFilial" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BankFilialCode" class="form-label">Bank Filial kodu</label>
                    <input asp-for="BankFilialCode" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="BankFilialCode" class="text-danger"></span>
                </div>

                @if (@ViewBag.Section == 3)
                        {
                <div class="mb-3">
                    <label class="form-label">İxtisaslar</label>
                    <select asp-for="SelectedSubProfessions" id="SelectedSubProfessions" class="form-select" multiple style="background-color: #23272a; color: #ffffff;">
                        
                            @foreach (var sp in Model.SubProfessions)
                            {
                                <option value="@sp.Value">@sp.Text</option>
                            }
                        
                    </select>
                    <span asp-validation-for="SelectedSubProfessions" class="text-danger"></span>
                </div>
                }
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary" style="background-color: #2f3136; color: #ffffff;">Geri</a>
                    <button type="submit" class="btn btn-primary" style="background-color: #7289da; border-color: #7289da;">Yadda saxla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
