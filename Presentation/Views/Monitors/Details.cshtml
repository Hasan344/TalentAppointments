@model ForQab.DataAccess.Models.Monitor

@{
    ViewData["Title"] = "Nəzarətçi detalları";
    string primaryColor = "#0056b3"; // Official primary color
    string secondaryColor = "#6c757d"; // Official secondary color
}

<div class="container py-5" style="background-color: #ffffff; border: 1px solid #dee2e6; border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
    <h1 class="text-center mb-4" style="color: @primaryColor; font-weight: bold;">Nəzarətçi Detalları</h1>
    <hr class="mb-4" />

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Ad:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Soyad:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.Surname)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Ata adı:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.Fname)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Cins:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.GenderNavigation.Name)</dd>
            </dl>
        </div>

        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Rol:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.RoleNavigation.Name)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Rayon:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.DistrictNavigation.Name)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Vəsiqə Nömrəsi:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.VNum)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Peşə:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.Profession)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">İş yeri:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.Workplace)</dd>
@* 
                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Vəzifə:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.Position)</dd> *@
            </dl>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <dl class="row">

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Telefon (Ev):</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.TelEv)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Telefon (İş):</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.TelIs)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Fin Kod:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.FinCode)</dd>
            </dl>
        </div>

        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Seriya:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.Serial)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">İstiqamət:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.Section.Name)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Arxivlənmə səbəbi:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.ArchiveReason)</dd>

                <dt class="col-sm-4" style="font-weight: 600; color: @secondaryColor; padding-bottom: 12px;">Çağırılmama səbəbi:</dt>
                <dd class="col-sm-8" style="border-bottom: 1px solid #dee2e6; padding-bottom: 12px;">@Html.DisplayFor(model => model.StatusReason)</dd>
            </dl>
        </div>
    </div>

    <div class="text-center mt-4">
        <a class="btn btn-primary px-4 py-2 mx-2" style="background-color: @primaryColor; border: none;" asp-action="Edit" asp-route-id="@Model?.Id">
            <i class="bi bi-pencil"></i> Düzəliş et
        </a>
        <a class="btn btn-secondary px-4 py-2 mx-2" style="background-color: @secondaryColor; border: none;" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Siyahıya qayıt
        </a>
        <a class="btn btn-info px-4 py-2 mx-2" style="background-color: #17a2b8; border: none;" asp-action="MonitorLog" asp-route-monitorId="@Model?.Id">
            <i class="bi bi-journal-text"></i> Xüsusi qeydlərə keçid
        </a>
        <!-- Status Butonları -->
        <div class="text-center mt-4">
            <!-- Çağırıla bilməz Butonu -->
            <button class="btn btn-danger px-4 py-2 mx-2" data-bs-toggle="modal" data-bs-target="#statusReasonModal">
                <i class="bi bi-x-circle"></i> Çağırıla bilməz
            </button>

            <!-- Çağırıla bilər Butonu -->
            <form asp-action="RestoreStatus" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success px-4 py-2 mx-2">
                    <i class="bi bi-check-circle"></i> Çağırıla bilər
                </button>
            </form>
        </div>
        <div class="mt-4">
            <h3 style="color: #0056b3; font-weight: bold;">Nəzarətçinin iştirak etdiyi imtahanlar</h3>
            <table class="table table-bordered mt-3">
                <thead>
                    <tr>
                        <th>İmtahan Id</th>
                        <th>İmtahan Tarixi</th>
                        <th>Zal</th>
                        <th>Başlama Saatı</th>
                        <th>Bitmə Saatı</th>
                        <th>İmtahan Detallarına Keçid</th> <!-- Yeni sütun ekledik -->
                    </tr>
                </thead>
                <tbody>
                    @foreach (var examMonitor in Model.ExamMonitors)
                    {
                        <tr>
                            <td>@examMonitor.Exams.Id</td>
                            <td>@examMonitor.Exams.ExamDate</td>
                            <td>@examMonitor.ExamRooms?.Name</td>
                            <td>@examMonitor.Exams.StartTime</td>
                            <td>@examMonitor.Exams.EndTime</td>
                            <td>
                                <a class="btn btn-info btn-sm" asp-controller="Exam" asp-action="Details" asp-route-id="@examMonitor.Exams.Id">
                                    İmtahan Detalları
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


        <!-- Modal (Pop-up) -->
        <div class="modal fade" id="statusReasonModal" tabindex="-1" aria-labelledby="statusReasonModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="statusReasonModalLabel">Status Dəyişmə Səbəbi</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="changeStatusForm" asp-action="ChangeStatus" method="post">
                        <div class="modal-body">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label for="statusReason" class="form-label">Səbəb</label>
                                <textarea class="form-control" id="statusReason" name="statusReason" rows="3" required></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                            <button type="submit" class="btn btn-danger">Təsdiqlə</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    </div>
</div>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#changeStatusForm").submit(function (event) {
            event.preventDefault(); // Formun default submit əməliyyatını bloklayır

            var formData = $(this).serialize(); // Formdakı məlumatları serialize edir

            $.ajax({
                type: "POST",
                url: "@Url.Action("ChangeStatus")",
                data: formData,
                success: function (response) {
                    alert("Status uğurla dəyişdirildi!");
                    var modal = $("#statusReasonModal");
                    modal.modal("hide");

                    // Modalı tam dispose edirik ki, arxa fon qalmasın
                    modal.on("hidden.bs.modal", function () {
                        $("body").removeClass("modal-open"); // Bədəni aktivləşdir
                        $(".modal-backdrop").remove(); // Qaralmış fonu sil
                    });
                },
                error: function () {
                    alert("Xəta baş verdi, yenidən cəhd edin."); // Xətaları idarə et
                }
            });
        });
    });
</script>