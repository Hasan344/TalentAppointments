@* MonitorLogs.cshtml — bütün nəzarətçilərin qeydləri *@
@model IEnumerable<ForQab.DataAccess.Models.Monitor>

@{
    ViewData["Title"] = "Xüsusi qeydlər";

    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-journal-text"></i></span>
                    Xüsusi qeydlər
                </h1>
            </div>
            <a class="qab-page-header__back" asp-action="Index"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    <div class="qab-table-wrap">
        <div class="qab-table-scroll">
            <table class="qab-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nəzarətçi</th>
                        <th>Qeyd</th>
                        <th>İmtahan</th>
                        <th>Daxil edən</th>
                        <th>Əməliyyatlar</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNumber = 1;
                    }
                    @foreach (var item in Model)

                    {
                        @if (item.MonitorLogs?.Any() == true)

                        {
                            var logs = item.MonitorLogs.ToList();
                            var first = true;

                            foreach (var log in logs)
                            {
                                <tr>
                                    @if (first)
                                    {
                                        <td class="qab-col-num" rowspan="@logs.Count" style="vertical-align:top;">@rowNumber</td>
                                        <td rowspan="@logs.Count" style="vertical-align:top;">
                                            <div class="qab-col-name">
                                                <strong>@item.Surname @item.Name @item.Fname</strong>
                                                <span class="text-muted" style="font-size:.82rem;">@item.FinCode</span>
                                            </div>
                                        </td>
                                    }

                                    <td>
                                        <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
                                            @if (log.Kind == 0)

                                            {
                                                <span class="qab-badge qab-badge--danger"><i class="bi bi-x-circle"></i> Gəlmədi</span>
                                            }

                                            else

                                            {
                                                <span class="qab-badge qab-badge--warning"><i class="bi bi-exclamation-circle"></i> Qeyd</span>
                                            }
                                            <span style="font-size:.85rem;">@log.Note</span>
                                        </div>
                                        <div class="text-muted" style="font-size:.75rem;margin-top:.15rem;">
                                            @log.Time?.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    </td>

                                    <td>
                                        @if (log.Exam != null)

                                        {
                                            <span style="font-size:.85rem;">@log.Exam.Name</span>
                                        }

                                        else

                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(log.UserName))

                                        {
                                            <span style="font-size:.85rem;"><i class="bi bi-person"></i> @log.UserName</span>
                                        }

                                        else

                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        <div style="display:flex;gap:.35rem;align-items:center;">
                                            @if (first)

                                            {
                                                <a class="qab-table__action-btn qab-table__action-btn--view"
                                                   asp-action="Details" asp-route-id="@item.Id" title="Bax">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            }
                                            <form asp-action="DeleteLogs" method="post" style="margin:0;">
                                                <input type="hidden" name="id" value="@log.Id" />
                                                <button type="submit" class="qab-table__action-btn qab-table__action-btn--delete"
                                                        title="Sil" style="width:26px;height:26px;">
                                                    <i class="bi bi-trash" style="font-size:.75rem;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>

                                first = false;
                            }

                            rowNumber++;

                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>