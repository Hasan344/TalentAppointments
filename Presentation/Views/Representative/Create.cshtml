@using ForQab.DataAccess.Models
@model DimRepresentative

@{
    ViewData["Title"] = "DİM Nümayəndəsi əlavə et";
}

<div class="container py-4" style="background-color: #2c2f33; border-radius: 10px; color: #ffffff;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="text-center mb-4">@ViewData["Title"]</h1>
            <hr style="border-color: #7289da;" />

            <form asp-controller="Representative" asp-action="Create" method="post" class="p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Adı</label>
                    <input asp-for="Name" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Surname" class="form-label">Soyadı</label>
                    <input asp-for="Surname" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Fname" class="form-label">Ata adı</label>
                    <input asp-for="Fname" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Fname" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FinCode" class="form-label">Fin Kod</label>
                    <input asp-for="FinCode" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="FinCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tel" class="form-label">Telefon</label>
                    <input asp-for="Tel" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Tel" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SerialPrefix" class="form-label">Seriya</label>
                    <input asp-for="SerialPrefix" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="SerialPrefix" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Serial" class="form-label">Seriya nömrəsi</label>
                    <input asp-for="Serial" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Serial" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Gender" class="form-label">Cins</label>
                    <select asp-for="Gender" class="form-select" asp-items="ViewBag.Gender" style="background-color: #23272a; color: #ffffff;">
                        <option value="" disabled selected>Cins Seçin</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <input type="hidden" asp-for="Type" value="1" />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary" style="background-color: #2f3136; color: #ffffff;">Geri</a>
                    <button type="submit" class="btn btn-primary" style="background-color: #7289da; border-color: #7289da;">Yarat</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .modern-select {
        background-color: #23272a;
        color: #ffffff;
        border: 1px solid #7289da;
        border-radius: 5px;
        padding: 10px;
        transition: all 0.3s ease;
        font-size: 1rem;
        line-height: 1.5;
    }

        .modern-select:focus {
            border-color: #99aab5;
            outline: none;
            box-shadow: 0 0 4px #7289da;
        }

        .modern-select option {
            background-color: #23272a;
            color: #ffffff;
        }

            .modern-select option:hover {
                background-color: #2c2f33;
                color: #7289da;
            }

        /* Hover Effect */
        .modern-select:hover {
            border-color: #99aab5;
            background-color: #2c2f33;
            cursor: pointer;
        }

        /* Placeholder option styling */
        .modern-select option:disabled {
            color: #7289da;
            font-style: italic;
        }
</style>
