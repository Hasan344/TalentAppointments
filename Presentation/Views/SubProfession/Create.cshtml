@using ForQab.DataAccess.Models
@model SubProfession

@{
    ViewData["Title"] = "İxtisas əlavə et";
}

<link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
<div class="container py-4" style="background-color: #2c2f33; border-radius: 10px; color: #ffffff;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="text-center mb-4">@ViewData["Title"]</h1>
            <hr style="border-color: #7289da;" />

            <form asp-controller="SubProfession" asp-action="Create" method="post" class="p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Adı</label>
                    <input asp-for="Name" class="form-control" style="background-color: #23272a; color: #ffffff;" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                @if(ViewBag.Section == 1)
                {
                    <div class="mb-3">
                        <label asp-for="ProfessionId" class="form-label">Federasiya</label>
                        <select asp-for="ProfessionId"
                                class="form-select modern-select"
                                asp-items="ViewBag.ProfessionList">
                            <option value="" disabled selected>Seçin</option>
                        </select>
                    </div>
                }
                
                <div class="mb-3">
                    <label asp-for="SectionId" class="form-label">İstiqamət</label>
                    <select asp-for="SectionId"
                            class="form-select modern-select"
                            asp-items="ViewBag.SectionList">
                        <option value="" disabled selected>Seçin</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary" style="background-color: #2f3136; color: #ffffff;">Geri</a>
                    <button type="submit" class="btn btn-primary" style="background-color: #7289da; border-color: #7289da;">Yarat</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .modern-select {
        background-color: #23272a;
        color: #ffffff;
        border: 1px solid #7289da;
        border-radius: 5px;
        padding: 10px;
        transition: all 0.3s ease;
        font-size: 1rem;
        line-height: 1.5;
    }

    .modern-select:focus {
        border-color: #99aab5;
        outline: none;
        box-shadow: 0 0 4px #7289da;
    }
</style>
