@model ForQab.DataAccess.Models.SubProfession
@{
    ViewData["Title"] = "İxtisası sil";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="qab-confirm">
                <div class="qab-confirm__header">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <h3>Silinməni təsdiqləyin</h3>
                </div>
                <div class="qab-confirm__body">
                    <p class="qab-confirm__lead"><strong>@Model.Name</strong> ixtisasını silmək istədiyinizə əminsiniz?</p>
                    <dl class="qab-confirm__list">
                        <div class="qab-confirm__row"><dt>Ad</dt><dd>@Model.Name</dd></div>
                        <div class="qab-confirm__row"><dt>Müəssisə</dt><dd>@Model.Profession?.Name</dd></div>
                        <div class="qab-confirm__row"><dt>İstiqamət</dt><dd>@Model.Section?.Name</dd></div>
                    </dl>
                    <div class="qab-confirm__footer">
                        <a asp-action="Index" class="qab-btn qab-btn--outline qab-btn--lg"><i class="bi bi-x-circle"></i> İmtina et</a>
                        <form asp-action="Delete" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="qab-btn qab-btn--danger qab-btn--lg"><i class="bi bi-trash"></i> Bəli, sil</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
