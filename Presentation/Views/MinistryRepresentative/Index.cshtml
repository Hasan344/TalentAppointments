@model IEnumerable<ForQab.DataAccess.Models.DimRepresentative>

<h2>Nazirlik nümayəndələri</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Ad</th>
            <th>Soyad</th>
            <th>Ata adı</th>
            <th>Fin Kod</th>
            <th>Telefon</th>
            <th>Seriya nömrəsi</th>
            <th>Əməliyyatlar</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rowNumber = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@item.Name</td>
                <td>@item.Surname</td>
                <td>@item.Fname</td>
                <td>@item.FinCode</td>
                <td>@item.Tel</td>
                <td>@item.Serial</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Redaktə</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Detallar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Sil</a>

                </td>
            </tr>
            rowNumber++;
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Yeni nümayəndə yarat</a>
