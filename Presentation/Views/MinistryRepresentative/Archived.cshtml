@model IEnumerable<ForQab.DataAccess.Models.DimRepresentative>
@{
    ViewData["Title"] = "Arxivlənmiş Nazirlik Nümayəndələri";
    Layout = "~/Presentation/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Exam/Common.css" asp-append-version="true" />

<div class="container qab-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="qab-alert qab-alert--success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
    }

    <div class="qab-page-header">
        <div class="qab-page-header__inner">
            <div>
                <h1 class="qab-page-header__title">
                    <span class="qab-page-header__title-icon"><i class="bi bi-archive"></i></span>
                    Arxivlənmiş Nazirlik Nümayəndələri
                </h1>
            </div>
            <a class="qab-page-header__back" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Geri
            </a>
        </div>
    </div>

    <div class="qab-table-wrap">
        <table class="qab-table qab-table--compact">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Ata adı</th>
                    <th>FİN Kod</th>
                    <th>Telefon</th>
                    <th>Arxivləmə səbəbi</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="qab-col-num">@rowNumber</td>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Surname</td>
                        <td>@item.Fname</td>
                        <td><code style="font-size:.82rem;">@item.FinCode</code></td>
                        <td class="qab-col-date">@item.Tel</td>
                        <td class="qab-col-wrap text-muted">@item.ArchiveReason</td>
                        <td>
                            <div class="qab-table__actions">
                                <a class="qab-table__action-btn qab-table__action-btn--view" title="Detallar"
                                   asp-action="Details" asp-route-id="@item.Id">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="qab-table__action-btn qab-table__action-btn--edit" title="Redaktə"
                                   asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="RestoreRepresentative" method="post" style="margin:0;" title="Arxivdən çıxar">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="qab-table__action-btn"
                                            style="color:var(--qab-success);border-color:var(--qab-success);">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>
        </table>
    </div>
</div>